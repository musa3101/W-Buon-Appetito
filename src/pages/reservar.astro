---
// web/src/pages/reservar.astro
// Motor de Reservas Oficial — Estilo Cappuccino Gstaad & MyRestoo
// Especialmente diseñado para Buon Appetito (Port d'Andratx)
import Preloader from '../components/Preloader.astro';
import '../styles/reservar.css';

const title = "Reserva de Mesa | Buon Appetito • Port d'Andratx";
const description = "Reserve su mesa en Buon Appetito, Port d'Andratx. Cocina mediterránea y pizzería artesanal frente al puerto.";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts: Cormorant Garamond, Playfair Display & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Material Symbols Icons -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
</head>
<body>
  
  <Preloader />

  <div class="booking-wrapper">
    <!-- TOP BRANDING BAR (100% Ancho Completo de borde a borde) -->
    <header class="top-bar">
      <div class="top-bar-inner">
        <button type="button" class="header-back-btn" id="header-back-btn" aria-label="Volver a la web">
          <span class="material-symbols-outlined header-back-icon">arrow_back</span>
          <span class="header-back-text" data-i18n="headerBack">Volver</span>
        </button>

        <div class="restaurant-name center-name">
          <span class="brand-title font-editorial">Buon Appetito</span>
        </div>

        <div class="language-dropdown-wrapper">
          <button type="button" class="lang-btn-simple" id="lang-toggle" aria-label="Cambiar idioma">
            <span class="material-symbols-outlined lang-icon">language</span>
            <span id="current-lang-text">ES</span>
          </button>
          <div class="lang-menu hidden" id="lang-menu">
            <button type="button" class="lang-option active" data-lang="es">🇪🇸 Español</button>
            <button type="button" class="lang-option" data-lang="en">🇬🇧 English</button>
            <button type="button" class="lang-option" data-lang="de">🇩🇪 Deutsch</button>
          </div>
        </div>
      </div>
    </header>

    <div class="booking-container">

      <!-- PASO 1: SELECCIÓN DE MESA Y HORARIO (ESTRUCTURA CAPPUCCINO / RESTOO) -->
      <main class="step-view active" id="step-1">
        
        <!-- ENCABEZADO LOCAL: Limpio y directo (Sin repetición de Port d'Andratx) -->
        <div class="booking-header">
          <h1 class="main-title font-editorial" data-i18n="bookingTitle">Reserve en Buon Appetito.</h1>
          <p class="main-address" data-i18n="bookingAddress">Avenida Mateo Bosch, 24</p>
        </div>

        <form id="step-1-form" class="step-form">

          <!-- 1. PERSONAS (CHIPS CUADRADOS 1..5, 6, ...) -->
          <div class="field-group">
            <label class="field-label">
              <span class="material-symbols-outlined icon-label">person_outline</span>
              <span data-i18n="guestsLabel">Personas</span>
            </label>
            <div class="persons-chips-wrapper">
              <div class="persons-grid-row row-four">
                <button type="button" class="person-chip" data-guests="1">1</button>
                <button type="button" class="person-chip active" data-guests="2">2</button>
                <button type="button" class="person-chip" data-guests="3">3</button>
                <button type="button" class="person-chip" data-guests="4">4</button>
              </div>
              <div class="persons-grid-row second-row row-two">
                <button type="button" class="person-chip" data-guests="5">5</button>
                <button type="button" class="person-chip person-chip-dots" id="btn-guests-more" data-guests="more" title="Más comensales">...</button>
              </div>
            </div>

            <!-- STEPPER EXPANDIBLE AL PULSAR '...' (A partir de 6) -->
            <div class="stepper-expandable hidden" id="stepper-expandable">
              <div class="stepper-box">
                <button type="button" class="stepper-btn" id="btn-custom-minus" aria-label="Restar personas">-</button>
                <div class="stepper-value" id="val-custom-guests">6</div>
                <button type="button" class="stepper-btn" id="btn-custom-plus" aria-label="Sumar personas">+</button>
              </div>
            </div>
            <input type="hidden" id="selected-guests-value" value="2" />
          </div>

          <!-- 2. SELECTOR DE FECHA (TARJETAS VIVAS: DÍA, NÚMERO, MES + BOTÓN '...') -->
          <div class="field-group">
            <label class="field-label">
              <span class="material-symbols-outlined icon-label">calendar_today</span>
              <span data-i18n="dateLabel">Fecha</span>
            </label>
            <div class="date-chips-grid" id="date-chips-container">
              <!-- Se genera dinámicamente con JS a partir de la fecha de hoy -->
            </div>
            <!-- Input de fecha nativo oculto para cuando el usuario pulse '...' -->
            <input type="date" id="native-date-input" class="hidden-native-date" />
            <input type="hidden" id="selected-date-value" value="" />
          </div>

          <!-- 3. RESERVA PARA (COMIDA vs CENA) -->
          <div class="field-group">
            <label class="field-label">
              <span class="material-symbols-outlined icon-label">schedule</span>
              <span data-i18n="reservationForLabel">Reserva para</span>
            </label>
            <div class="shift-selector">
              <button type="button" class="shift-btn" data-shift="lunch" id="shift-lunch">
                <span class="shift-name" data-i18n="lunchName">COMIDA</span>
                <span class="shift-hours">11:30 - 16:00</span>
              </button>
              <button type="button" class="shift-btn" data-shift="dinner" id="shift-dinner">
                <span class="shift-name" data-i18n="dinnerName">CENA</span>
                <span class="shift-hours">19:30 - 23:30</span>
              </button>
            </div>
          </div>

          <!-- 4. HORA EXACTA (ACORDEÓN DESPLEGABLE: Oculto por defecto hasta pulsar Comida o Cena) -->
          <div class="time-slots-accordion is-collapsed" id="time-slots-accordion">
            <label class="field-label">
              <span class="material-symbols-outlined icon-label">alarm</span>
              <span data-i18n="exactTimeLabel">Hora exacta</span>
            </label>
            <div class="time-slots-grid" id="time-slots-container">
              <!-- Se inyectan dinámicamente según el turno activo -->
            </div>
            <input type="hidden" id="selected-time-value" value="" />
          </div>

          <!-- 5. BOTÓN CONTINUAR (Color Oro-Oliva Toscano Cálido) -->
          <div class="action-group">
            <button type="button" class="btn-primary" id="btn-step1-continue">
              <span data-i18n="continueBtn">CONTINUAR</span>
            </button>
          </div>

          <!-- 6. BOTÓN SECUNDARIO: GRUPOS O EVENTOS (Resumido y estilizado) -->
          <div class="secondary-action">
            <button type="button" class="btn-outline-pill" id="btn-group-info">
              <span data-i18n="groupOrGiftCard">RESERVAR PARA GRUPOS O EVENTO</span>
            </button>
          </div>

        </form>

        <!-- FOOTER ELEGANTE ESTILO CAPPUCCINO CON LEGALES Y MYNEXT -->
        <footer class="booking-footer">
          <p class="help-text font-serif-text">
            <span data-i18n="callHelp">Llámenos al</span>
            <a href="tel:+34632446064" class="phone-link">+34 632 44 60 64</a>
            <span data-i18n="callHelpSuffix">si tiene cualquier duda.</span>
          </p>

          <button type="button" class="change-lang-link" id="change-lang-footer">
            <span class="material-symbols-outlined text-sm">language</span>
            <span data-i18n="changeLanguage">Change language</span>
          </button>

          <!-- ENLACES LEGALES OFICIALES -->
          <nav class="legal-links" aria-label="Enlaces legales">
            <a href="/aviso-legal" target="_blank" data-i18n="termsOfUse">Condiciones de Uso</a>
            <span class="legal-sep">|</span>
            <a href="/privacidad" target="_blank" data-i18n="privacyPolicy">Política de Privacidad</a>
            <span class="legal-sep">|</span>
            <a href="/cookies" target="_blank" data-i18n="cookiesPolicy">Política de Cookies</a>
          </nav>

          <!-- CRÉDITO DE TECNOLOGÍA MYNEXT -->
          <div class="mynext-credit-card">
            <p class="mynext-lead">
              <span data-i18n="techBy">Con la tecnología de</span>
              <a href="https://mynextbymusa.com" target="_blank" rel="noopener" class="mynext-brand-link">MyNext</a>
            </p>
            <p class="mynext-sub" data-i18n="techTagline">Tu tecnología de reserva inteligente sin comisiones.</p>
          </div>
        </footer>

      </main>

      <!-- PASO 2: DATOS DEL COMENSAL -->
      <main class="step-view" id="step-2">

        <!-- BARRA SUPERIOR DE NAVEGACIÓN PASO 2 -->
        <div class="step-nav-bar">
          <button type="button" class="back-btn" id="btn-back-to-step1" aria-label="Volver al paso 1">
            <span class="material-symbols-outlined">arrow_back</span>
            <span data-i18n="backBtn">Volver</span>
          </button>
          <span class="step-indicator" data-i18n="step2Indicator">Paso 2 de 2</span>
        </div>

        <!-- RESUMEN COMPACTO EDITABLE DE LA RESERVA -->
        <div class="reservation-summary-card">
          <div class="summary-details">
            <div class="summary-item">
              <span class="material-symbols-outlined">group</span>
              <span id="summary-guests">2 Personas</span>
            </div>
            <div class="summary-item">
              <span class="material-symbols-outlined">calendar_today</span>
              <span id="summary-date">27 Oct, 2026</span>
            </div>
            <div class="summary-item">
              <span class="material-symbols-outlined">schedule</span>
              <span id="summary-time">13:30 (Comida)</span>
            </div>
          </div>
          <button type="button" class="edit-summary-btn" id="btn-edit-summary" data-i18n="editBtn">Modificar</button>
        </div>

        <!-- TÍTULO EDITORIAL PASO 2 -->
        <div class="booking-header compact">
          <h2 class="main-title text-xl font-editorial" data-i18n="guestDetailsTitle">Tus Datos de Contacto</h2>
          <p class="main-address" data-i18n="guestDetailsSub">Por favor completa tus datos para preparar tu mesa.</p>
        </div>

        <form id="step-2-form" class="step-form">

          <!-- NOMBRE Y APELLIDOS -->
          <div class="form-control">
            <label for="guest-name" class="control-label" data-i18n="nameLabel">Nombre y Apellidos *</label>
            <div class="input-wrapper">
              <span class="material-symbols-outlined input-icon">person</span>
              <input type="text" id="guest-name" class="form-input" placeholder="Ej. Carmen Navarro" required autocomplete="name" />
            </div>
            <span class="error-msg hidden" id="err-name" data-i18n="errName">Por favor introduce un nombre válido (al menos 2 letras, sin números).</span>
          </div>

          <!-- TELÉFONO DE CONTACTO -->
          <div class="form-control">
            <label for="guest-phone" class="control-label" data-i18n="phoneLabel">Teléfono de contacto *</label>
            <div class="input-wrapper">
              <span class="material-symbols-outlined input-icon">call</span>
              <input type="tel" id="guest-phone" class="form-input" placeholder="Ej. +34 600 000 000" required autocomplete="tel" />
            </div>
            <span class="error-msg hidden" id="err-phone" data-i18n="errPhone">Por favor introduce un teléfono válido (mínimo 9 dígitos).</span>
          </div>

          <!-- EMAIL (OPCIONAL / REQUERIDO PARA CONFIRMACIÓN POR CORREO EN PC) -->
          <div class="form-control" id="control-guest-email">
            <label for="guest-email" class="control-label" data-i18n="emailLabel">Correo electrónico (Opcional)</label>
            <div class="input-wrapper">
              <span class="material-symbols-outlined input-icon">mail</span>
              <input type="email" id="guest-email" class="form-input" placeholder="Ej. carmen@ejemplo.com" autocomplete="email" />
            </div>
            <span class="error-msg hidden" id="err-email" data-i18n="errEmail">Por favor introduce un correo electrónico válido o déjalo en blanco.</span>
          </div>

          <!-- PREFERENCIA DE ESPACIO (SIN BOTÓN INDIFERENTE: SOLO TERRAZA PUERTO Y SALÓN INTERIOR) -->
          <div class="form-control">
            <label class="control-label" data-i18n="zoneLabel">Preferencia de espacio</label>
            <div class="zone-pills-group dual-zones">
              <button type="button" class="zone-pill active" data-zone="Terraza Puerto">
                <span class="material-symbols-outlined">deck</span>
                <span data-i18n="terraceZone">Terraza Puerto</span>
              </button>
              <button type="button" class="zone-pill" data-zone="Salón Interior">
                <span class="material-symbols-outlined">storefront</span>
                <span data-i18n="interiorZone">Salón Interior</span>
              </button>
            </div>
            <input type="hidden" id="selected-zone-value" value="Terraza Puerto" />
          </div>

          <!-- OCASIÓN ESPECIAL (OPCIONAL) -->
          <div class="form-control">
            <label for="guest-occasion" class="control-label" data-i18n="occasionLabel">Ocasión especial (Opcional)</label>
            <div class="input-wrapper">
              <span class="material-symbols-outlined input-icon">celebration</span>
              <select id="guest-occasion" class="form-input select-input">
                <option value="Comida o cena habitual" data-i18n="occRegular">Comida o cena habitual</option>
                <option value="Cumpleaños" data-i18n="occBirthday">Cumpleaños</option>
                <option value="Aniversario" data-i18n="occAnniversary">Aniversario</option>
                <option value="Cita especial" data-i18n="occDate">Cita especial</option>
                <option value="Comida de empresa" data-i18n="occBusiness">Comida o cena de empresa</option>
                <option value="Celebración familiar" data-i18n="occFamily">Celebración familiar</option>
              </select>
            </div>
          </div>

          <!-- NOTAS O ALERGIAS -->
          <div class="form-control">
            <label for="guest-notes" class="control-label" data-i18n="notesLabel">Alergias o peticiones especiales (Opcional)</label>
            <div class="input-wrapper textarea-wrapper">
              <span class="material-symbols-outlined input-icon">restaurant</span>
              <textarea id="guest-notes" class="form-input form-textarea" rows="2" placeholder="Ej. 1 celíaco, necesitamos trona para bebé, etc."></textarea>
            </div>
          </div>

          <!-- BOTÓN PRINCIPAL DE CONFIRMACIÓN -->
          <div class="action-group">
            <button type="button" class="btn-primary" id="btn-confirm-booking">
              <span class="btn-text" data-i18n="confirmBtn">CONFIRMAR RESERVA</span>
              <span class="btn-spinner hidden" id="confirm-spinner"></span>
            </button>
          </div>

          <!-- AVISO DE CONFIANZA DIRECTA -->
          <p class="trust-notice">
            <span class="material-symbols-outlined text-xs">verified</span>
            <span data-i18n="directBookingNotice">Sin intermediarios ni comisiones • Confirmación directa con el restaurante</span>
          </p>

        </form>

        <!-- FOOTER EN PASO 2 -->
        <footer class="booking-footer">
          <p class="help-text font-serif-text">
            <span data-i18n="callHelp">Llámenos al</span>
            <a href="tel:+34632446064" class="phone-link">+34 632 44 60 64</a>
            <span data-i18n="callHelpSuffix">si tiene cualquier duda.</span>
          </p>
        </footer>

      </main>

    </div>
  </div>

  <!-- MODAL DE AYUDA PARA GRUPOS O EVENTOS (>8) -->
  <div class="modal-backdrop hidden" id="modal-groups">
    <div class="modal-card">
      <div class="modal-icon-circle">
        <span class="material-symbols-outlined">groups</span>
      </div>
      <h3 class="modal-title font-editorial" data-i18n="groupModalTitle">Reservas para Grupos y Eventos</h3>
      <p class="modal-desc" data-i18n="groupModalDesc">
        Para reservas de más de 8 personas, menús cerrados o celebraciones especiales, contacta directamente con nuestro equipo de sala para garantizar la mejor atención y disponibilidad.
      </p>
      <div class="modal-actions">
        <a href="tel:+34632446064" class="btn-primary modal-call-btn">
          <span class="material-symbols-outlined">call</span>
          <span>Llamar al +34 632 44 60 64</span>
        </a>
        <button type="button" class="btn-outline-pill" id="btn-close-modal">
          <span data-i18n="closeBtn">Cerrar</span>
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL DE CANAL PARA TABLET / ORDENADOR (WHATSAPP vs EMAIL) -->
  <div class="modal-backdrop hidden" id="modal-channel-choice">
    <div class="modal-card channel-modal-card">
      <div class="modal-icon-circle channel-icon">
        <span class="material-symbols-outlined">send</span>
      </div>
      <h3 class="modal-title font-editorial" data-i18n="channelModalTitle">¿Cómo prefieres confirmar tu reserva?</h3>
      <p class="modal-desc" data-i18n="channelModalDesc">
        Hemos detectado que navegas desde tablet u ordenador. Puedes enviar tu solicitud al instante mediante WhatsApp o por Correo Electrónico:
      </p>

      <div class="channel-buttons-list">
        <!-- OPCIÓN A: WHATSAPP WEB -->
        <button type="button" class="channel-btn whatsapp-btn" id="btn-channel-whatsapp">
          <span class="channel-btn-icon">💬</span>
          <div class="channel-btn-texts">
            <span class="channel-btn-title" data-i18n="channelWhatsAppTitle">Confirmar por WhatsApp</span>
            <span class="channel-btn-sub" data-i18n="channelWhatsAppSub">Abre chat directo con los datos de tu reserva</span>
          </div>
        </button>

        <!-- OPCIÓN B: CORREO ELECTRÓNICO (GMAIL / MAILTO) -->
        <button type="button" class="channel-btn email-btn" id="btn-channel-email">
          <span class="channel-btn-icon">✉️</span>
          <div class="channel-btn-texts">
            <span class="channel-btn-title" data-i18n="channelEmailTitle">Confirmar por Email</span>
            <span class="channel-btn-sub" data-i18n="channelEmailSub">Envía un correo con tu reserva a Buon Appetito</span>
          </div>
        </button>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-outline-pill" id="btn-close-channel-modal">
          <span data-i18n="cancelBtn">Volver</span>
        </button>
      </div>
    </div>
  </div>

  <script src="../scripts/reservar.js"></script>
</body>
</html>
