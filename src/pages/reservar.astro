---
// web/src/pages/reservar.astro
// Motor de Reservas Oficial — Estilo Restoo (Tahini Puerto Portals)
// Especialmente diseñado para Buon Appetito (Port d'Andratx)
import Preloader from '../components/Preloader.astro';
const title = "Reserva de Mesa | Buon Appetito • Port d'Andratx";
const description = "Reserva tu mesa en Buon Appetito, Port d'Andratx. Terraza con vistas al puerto y salón climatizado.";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts: Outfit & Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Material Symbols Icons -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <style is:global>
    :root {
      --color-brand-black: #0B0F0D;
      --color-primary-green: #6E9555;
      --color-primary-green-hover: #5D8245;
      --color-primary-dark: #183321;
      --color-terracotta: #9E4221;
      --color-bg-page: #F3F4F6;
      --color-bg-card: #FFFFFF;
      --color-text-main: #111827;
      --color-text-secondary: #4B5563;
      --color-text-muted: #6B7280;
      --color-border-light: #E5E7EB;
      --color-border-medium: #D1D5DB;
      --color-border-focus: #6E9555;
      --radius-sm: 6px;
      --radius-md: 8px;
      --radius-lg: 12px;
      --radius-xl: 16px;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      --font-serif: 'Playfair Display', Georgia, serif;
      --shadow-card: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      width: 100%;
      min-height: 100%;
      font-family: var(--font-sans);
      background-color: var(--color-bg-page);
      color: var(--color-text-main);
      -webkit-font-smoothing: antialiased;
    }

    .booking-wrapper {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 0;
    }

    @media (min-width: 600px) {
      .booking-wrapper {
        padding: 32px 16px;
      }
    }

    .booking-container {
      width: 100%;
      max-width: 460px;
      background-color: var(--color-bg-card);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    @media (min-width: 600px) {
      .booking-container {
        min-height: auto;
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-card);
        border: 1px solid var(--color-border-light);
      }
    }

    .top-bar {
      background-color: var(--color-brand-black);
      color: #FFFFFF;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .restaurant-name {
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.03em;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .brand-title {
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .brand-divider {
      color: #9CA3AF;
      font-weight: 300;
    }

    .brand-location {
      color: #E5E7EB;
      font-size: 13px;
    }

    .language-dropdown-wrapper {
      position: relative;
    }

    .lang-btn {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #FFFFFF;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .lang-btn:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .lang-menu {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      background: #FFFFFF;
      color: var(--color-text-main);
      border-radius: var(--radius-md);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.15);
      border: 1px solid var(--color-border-light);
      padding: 6px;
      min-width: 140px;
      z-index: 50;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .lang-menu.hidden {
      display: none;
    }

    .lang-option {
      background: transparent;
      border: none;
      padding: 8px 12px;
      text-align: left;
      font-size: 13px;
      font-weight: 500;
      color: var(--color-text-main);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .lang-option:hover, .lang-option.active {
      background: #F3F4F6;
      font-weight: 600;
    }

    .step-view {
      display: none;
      flex-direction: column;
      padding: 24px 20px 48px 20px;
      flex: 1;
      animation: fadeIn 0.25s ease-out forwards;
    }

    .step-view.active {
      display: flex;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .booking-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .booking-header.compact {
      margin-bottom: 18px;
    }

    .main-title {
      font-size: 20px;
      font-weight: 600;
      line-height: 1.35;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .main-title.text-xl {
      font-size: 19px;
    }

    .main-address {
      font-size: 13px;
      color: var(--color-text-muted);
      margin-top: 5px;
    }

    .step-form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .field-label {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 500;
      color: var(--color-text-secondary);
      margin-bottom: 8px;
      width: 100%;
    }

    .icon-label {
      font-size: 18px;
      color: var(--color-text-muted);
    }

    .stepper-box {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width: 320px;
      height: 48px;
      border: 1px solid var(--color-border-medium);
      border-radius: var(--radius-md);
      background-color: #FFFFFF;
      overflow: hidden;
    }

    .stepper-btn {
      flex: 1;
      height: 100%;
      background-color: #F9FAFB;
      border: none;
      font-size: 22px;
      font-weight: 500;
      color: var(--color-text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.15s ease, color 0.15s ease;
      user-select: none;
    }

    .stepper-btn:hover {
      background-color: #E5E7EB;
      color: var(--color-text-main);
    }

    .stepper-btn:active {
      background-color: #D1D5DB;
    }

    .stepper-value {
      flex: 1.4;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      font-weight: 600;
      color: var(--color-text-main);
      border-left: 1px solid var(--color-border-light);
      border-right: 1px solid var(--color-border-light);
      background-color: #FFFFFF;
    }

    .date-card-wrapper {
      position: relative;
      width: 100%;
      max-width: 320px;
    }

    .native-date-input {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
      z-index: 5;
    }

    .date-card {
      width: 100%;
      height: 48px;
      border: 1px solid var(--color-border-medium);
      border-radius: var(--radius-md);
      background-color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 500;
      color: var(--color-text-main);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      cursor: pointer;
    }

    .date-card:hover {
      border-color: var(--color-primary-green);
    }

    .date-icon {
      font-size: 19px;
      color: var(--color-text-muted);
    }

    .shift-selector {
      display: flex;
      gap: 10px;
      width: 100%;
      max-width: 320px;
    }

    .shift-btn {
      flex: 1;
      padding: 10px 8px;
      border: 1px solid var(--color-border-medium);
      border-radius: var(--radius-md);
      background-color: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .shift-name {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--color-text-main);
    }

    .shift-hours {
      font-size: 11px;
      color: var(--color-text-muted);
    }

    .shift-btn.active {
      background-color: #1A1F1B;
      border-color: #1A1F1B;
      color: #FFFFFF;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .shift-btn.active .shift-name {
      color: #FFFFFF;
    }

    .shift-btn.active .shift-hours {
      color: #9CA3AF;
    }

    .time-slots-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      width: 100%;
      max-width: 320px;
    }

    .time-slot-chip {
      padding: 8px 2px;
      border: 1px solid var(--color-border-medium);
      border-radius: var(--radius-sm);
      background-color: #FFFFFF;
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text-secondary);
      text-align: center;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .time-slot-chip:hover {
      border-color: var(--color-primary-green);
      color: var(--color-text-main);
    }

    .time-slot-chip.active {
      background-color: var(--color-primary-dark);
      border-color: var(--color-primary-dark);
      color: #FFFFFF;
      font-weight: 700;
      transform: scale(1.02);
    }

    .action-group {
      width: 100%;
      max-width: 320px;
      margin: 10px auto 0 auto;
    }

    .btn-primary {
      width: 100%;
      height: 50px;
      background-color: var(--color-primary-green);
      color: #FFFFFF;
      border: none;
      border-radius: var(--radius-md);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 12px rgba(110, 149, 85, 0.25);
    }

    .btn-primary:hover {
      background-color: var(--color-primary-green-hover);
      box-shadow: 0 6px 16px rgba(110, 149, 85, 0.35);
    }

    .btn-primary:active {
      transform: scale(0.98);
    }

    .secondary-action {
      width: 100%;
      max-width: 320px;
      margin: 6px auto 0 auto;
      text-align: center;
    }

    .btn-outline-pill {
      width: 100%;
      padding: 10px 14px;
      background-color: transparent;
      border: 1px solid var(--color-border-medium);
      border-radius: var(--radius-md);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
      cursor: pointer;
      transition: all 0.2s ease;
      text-transform: uppercase;
    }

    .btn-outline-pill:hover {
      background-color: #F9FAFB;
      border-color: var(--color-text-muted);
      color: var(--color-text-main);
    }

    .booking-footer {
      margin-top: auto;
      padding-top: 30px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .help-text {
      font-size: 13px;
      color: var(--color-text-muted);
    }

    .phone-link {
      color: var(--color-primary-green);
      text-decoration: underline;
      font-weight: 600;
      margin-left: 3px;
    }

    .change-lang-link {
      background: none;
      border: none;
      color: var(--color-text-muted);
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .change-lang-link:hover {
      color: var(--color-text-main);
      text-decoration: underline;
    }

    /* Paso 2 */
    .step-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .back-btn {
      background: none;
      border: none;
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text-secondary);
      cursor: pointer;
      padding: 4px 6px;
      border-radius: var(--radius-sm);
      transition: color 0.15s ease, background 0.15s ease;
    }

    .back-btn:hover {
      color: var(--color-text-main);
      background-color: #F3F4F6;
    }

    .step-indicator {
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .reservation-summary-card {
      background-color: #F9FAFB;
      border: 1px solid var(--color-border-light);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .summary-details {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .summary-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 500;
      color: var(--color-text-secondary);
    }

    .summary-item span:first-child {
      font-size: 15px;
      color: var(--color-primary-green);
    }

    .edit-summary-btn {
      background: none;
      border: 1px solid var(--color-border-medium);
      border-radius: var(--radius-sm);
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 600;
      color: var(--color-text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .edit-summary-btn:hover {
      background: #FFFFFF;
      border-color: var(--color-text-main);
      color: var(--color-text-main);
    }

    .form-control {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
    }

    .control-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
    }

    .input-icon {
      position: absolute;
      left: 12px;
      font-size: 18px;
      color: var(--color-text-muted);
      pointer-events: none;
    }

    .form-input {
      width: 100%;
      height: 46px;
      padding: 0 14px 0 40px;
      border: 1px solid var(--color-border-medium);
      border-radius: var(--radius-md);
      font-size: 14px;
      font-family: var(--font-sans);
      color: var(--color-text-main);
      background-color: #FFFFFF;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-input:focus {
      outline: none;
      border-color: var(--color-primary-green);
      box-shadow: 0 0 0 3px rgba(110, 149, 85, 0.18);
    }

    .select-input {
      appearance: none;
      cursor: pointer;
    }

    .textarea-wrapper {
      align-items: flex-start;
    }

    .textarea-wrapper .input-icon {
      top: 12px;
    }

    .form-textarea {
      height: auto;
      min-height: 64px;
      padding: 10px 14px 10px 40px;
      resize: vertical;
    }

    .error-msg {
      font-size: 11px;
      color: #DC2626;
      font-weight: 500;
    }

    .error-msg.hidden {
      display: none;
    }

    .zone-pills-group {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .zone-pill {
      padding: 10px 6px;
      border: 1px solid var(--color-border-medium);
      border-radius: var(--radius-md);
      background-color: #FFFFFF;
      font-size: 11px;
      font-weight: 600;
      color: var(--color-text-secondary);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      cursor: pointer;
      transition: all 0.15s ease;
      text-align: center;
    }

    .zone-pill span.material-symbols-outlined {
      font-size: 18px;
    }

    .zone-pill:hover {
      border-color: var(--color-primary-green);
    }

    .zone-pill.active {
      background-color: var(--color-primary-dark);
      border-color: var(--color-primary-dark);
      color: #FFFFFF;
    }

    .trust-notice {
      font-size: 11px;
      color: var(--color-text-muted);
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      margin-top: 4px;
    }

    .trust-notice span {
      color: var(--color-primary-green);
    }

    .btn-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #FFFFFF;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }

    .btn-spinner.hidden {
      display: none;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 100;
    }

    .modal-backdrop.hidden {
      display: none;
    }

    .modal-card {
      background: #FFFFFF;
      border-radius: var(--radius-lg);
      padding: 24px;
      max-width: 360px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
      animation: modalPop 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes modalPop {
      from { transform: scale(0.92); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .modal-icon-circle {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background-color: rgba(110, 149, 85, 0.15);
      color: var(--color-primary-green);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 12px auto;
    }

    .modal-title {
      font-size: 17px;
      font-weight: 700;
      color: var(--color-text-main);
      margin-bottom: 8px;
    }

    .modal-desc {
      font-size: 13px;
      color: var(--color-text-secondary);
      line-height: 1.5;
      margin-bottom: 20px;
    }

    .modal-actions {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .modal-call-btn {
      text-decoration: none;
    }
  </style>
</head>
<body>
  <Preloader />
  
  <div class="booking-wrapper">
    <div class="booking-container">

      <!-- TOP BRANDING BAR (Estilo Restoo: Fondo negro/oscuro + Nombre + Idioma) -->
      <header class="top-bar">
        <div class="restaurant-name">
          <span class="brand-title">Buon Appetito</span>
          <span class="brand-divider">|</span>
          <span class="brand-location">Port d'Andratx</span>
        </div>
        <div class="language-dropdown-wrapper">
          <button type="button" class="lang-btn" id="lang-toggle" aria-label="Cambiar idioma">
            <span class="material-symbols-outlined text-sm">language</span>
            <span id="current-lang-text">ES</span>
          </button>
          <div class="lang-menu hidden" id="lang-menu">
            <button type="button" class="lang-option active" data-lang="es">🇪🇸 Español</button>
            <button type="button" class="lang-option" data-lang="en">🇬🇧 English</button>
            <button type="button" class="lang-option" data-lang="de">🇩🇪 Deutsch</button>
          </div>
        </div>
      </header>

      <!-- PASO 1: SELECCIÓN DE MESA Y HORARIO (ESTRUCTURA EXACTA RESTOO) -->
      <main class="step-view active" id="step-1">
        
        <!-- ENCABEZADO LOCAL -->
        <div class="booking-header">
          <h1 class="main-title" data-i18n="bookingTitle">Reserva en Buon Appetito | Port d'Andratx.</h1>
          <p class="main-address" data-i18n="bookingAddress">Avenida Mateo Bosch, 24. Port d'Andratx</p>
        </div>

        <form id="step-1-form" class="step-form">

          <!-- 1. STEPPER ADULTOS -->
          <div class="field-group">
            <label class="field-label">
              <span class="material-symbols-outlined icon-label">person</span>
