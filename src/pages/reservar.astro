          backBtn: "Zurück",
          step2Indicator: "Schritt 2 von 2",
          editBtn: "Ändern",
          guestDetailsTitle: "Ihre Kontaktdaten",
          guestDetailsSub: "Bitte geben Sie Ihre Kontaktdaten ein, um Ihren Tisch vorzubereiten.",
          nameLabel: "Vor- und Nachname *",
          phoneLabel: "Telefonnummer *",
          zoneLabel: "Sitzplatzpräferenz",
          terraceZone: "Hafenterrasse",
          interiorZone: "Innenbereich",
          anyZone: "Keine Präferenz",
          occasionLabel: "Besonderer Anlass (Optional)",
          occRegular: "Regulärer Besuch",
          occBirthday: "Geburtstag",
          occAnniversary: "Jubiläum",
          occDate: "Romantisches Date",
          occBusiness: "Geschäftsessen",
          occFamily: "Familienfeier",
          notesLabel: "Allergien oder Sonderwünsche (Optional)",
          confirmBtn: "RESERVIERUNG BESTÄTIGEN",
          directBookingNotice: "Direktbuchung ohne Gebühren • Sofortige Bestätigung durch das Restaurant",
          errName: "Bitte geben Sie Ihren Namen ein.",
          errPhone: "Bitte geben Sie eine gültige Telefonnummer ein.",
          groupModalTitle: "Gruppen- und Eventreservierungen",
          groupModalDesc: "Für Reservierungen ab 8 Personen oder exklusive Events kontaktieren Sie bitte direkt unser Serviceteam.",
          closeBtn: "Schließen",
          guestsText: "Gäste",
          months: ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"]
        }
      };

      let currentLang = 'es';
      const RESTAURANT_WHATSAPP = "34632446064";

      const TIME_SLOTS = {
        lunch: ["11:30", "12:00", "12:30", "13:00", "13:30", "14:00", "14:30", "15:00", "15:30", "16:00"],
        dinner: ["19:30", "20:00", "20:30", "21:00", "21:30", "22:00", "22:30"]
      };

      const state = {
        adults: 2,
        children: 0,
        date: new Date().toISOString().split('T')[0],
        shift: 'lunch',
        time: '13:30',
        zone: 'Terraza frente al mar',
        name: '',
        phone: '',
        occasion: 'Comida o cena habitual',
        notes: ''
      };

      const valAdultsEl = document.getElementById('val-adults');
      const btnAdultsMinus = document.getElementById('btn-adults-minus');
      const btnAdultsPlus = document.getElementById('btn-adults-plus');

      const valChildrenEl = document.getElementById('val-children');
      const btnChildrenMinus = document.getElementById('btn-children-minus');
      const btnChildrenPlus = document.getElementById('btn-children-plus');

      const nativeDateInput = document.getElementById('native-date-input');
      const dateFormattedText = document.getElementById('date-formatted-text');

      const shiftLunchBtn = document.getElementById('shift-lunch');
      const shiftDinnerBtn = document.getElementById('shift-dinner');
      const timeSlotsContainer = document.getElementById('time-slots-container');
      const selectedTimeInput = document.getElementById('selected-time-value');

      const btnStep1Continue = document.getElementById('btn-step1-continue');
      const step1View = document.getElementById('step-1');
      const step2View = document.getElementById('step-2');
      const btnBackToStep1 = document.getElementById('btn-back-to-step1');
      const btnEditSummary = document.getElementById('btn-edit-summary');

      const summaryGuestsEl = document.getElementById('summary-guests');
      const summaryDateEl = document.getElementById('summary-date');
      const summaryTimeEl = document.getElementById('summary-time');

      const inputName = document.getElementById('guest-name');
      const inputPhone = document.getElementById('guest-phone');
      const selectOccasion = document.getElementById('guest-occasion');
      const textareaNotes = document.getElementById('guest-notes');
      const errName = document.getElementById('err-name');
      const errPhone = document.getElementById('err-phone');
      const zonePills = document.querySelectorAll('.zone-pill');
      const selectedZoneInput = document.getElementById('selected-zone-value');
      const btnConfirmBooking = document.getElementById('btn-confirm-booking');
      const confirmSpinner = document.getElementById('confirm-spinner');

      const btnGroupInfo = document.getElementById('btn-group-info');
      const modalGroups = document.getElementById('modal-groups');
      const btnCloseModal = document.getElementById('btn-close-modal');

      const langToggle = document.getElementById('lang-toggle');
      const langMenu = document.getElementById('lang-menu');
      const currentLangText = document.getElementById('current-lang-text');
      const changeLangFooter = document.getElementById('change-lang-footer');

      // Fecha
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      const todayIso = `${yyyy}-${mm}-${dd}`;

      nativeDateInput.min = todayIso;
      nativeDateInput.value = todayIso;
      state.date = todayIso;

      function updateFormattedDate() {
        const [year, month, day] = state.date.split('-');
        const mIndex = parseInt(month, 10) - 1;
        const monthName = translations[currentLang].months[mIndex] || month;
        dateFormattedText.textContent = `${parseInt(day, 10)} ${monthName}, ${year}`;
      }
      updateFormattedDate();

      nativeDateInput.addEventListener('change', (e) => {
        if (e.target.value) {
          state.date = e.target.value;
          updateFormattedDate();
        }
      });

      const dateCardDisplay = document.getElementById('date-card-display');
      if (dateCardDisplay) {
        dateCardDisplay.addEventListener('click', () => {
          if (typeof nativeDateInput.showPicker === 'function') {
            try {
              nativeDateInput.showPicker();
            } catch (err) {
              nativeDateInput.focus();
            }
          }
        });
      }

      // Steppers
      btnAdultsMinus.addEventListener('click', () => {
        if (state.adults > 1) {
          state.adults--;
          valAdultsEl.textContent = state.adults;
        }
      });

      btnAdultsPlus.addEventListener('click', () => {
        if (state.adults < 20) {
          state.adults++;
          valAdultsEl.textContent = state.adults;
        }
      });

      btnChildrenMinus.addEventListener('click', () => {
        if (state.children > 0) {
          state.children--;
          valChildrenEl.textContent = state.children;
        }
      });

      btnChildrenPlus.addEventListener('click', () => {
        if (state.children < 15) {
          state.children++;
          valChildrenEl.textContent = state.children;
        }
      });

      // Slots
      function renderTimeSlots() {
        timeSlotsContainer.innerHTML = '';
        const slots = TIME_SLOTS[state.shift] || [];

        if (!slots.includes(state.time)) {
          state.time = slots[1] || slots[0];
          selectedTimeInput.value = state.time;
        }

        slots.forEach((timeStr) => {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = `time-slot-chip ${timeStr === state.time ? 'active' : ''}`;
          chip.textContent = timeStr;
          chip.setAttribute('data-time', timeStr);

          chip.addEventListener('click', () => {
            state.time = timeStr;
            selectedTimeInput.value = timeStr;
            document.querySelectorAll('.time-slot-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
          });

          timeSlotsContainer.appendChild(chip);
        });
      }

      shiftLunchBtn.addEventListener('click', () => {
        state.shift = 'lunch';
        shiftLunchBtn.classList.add('active');
        shiftDinnerBtn.classList.remove('active');
        renderTimeSlots();
      });

      shiftDinnerBtn.addEventListener('click', () => {
        state.shift = 'dinner';
        shiftDinnerBtn.classList.add('active');
        shiftLunchBtn.classList.remove('active');
        renderTimeSlots();
      });

      renderTimeSlots();

      // Paso 1 -> Paso 2
      btnStep1Continue.addEventListener('click', () => {
        const totalGuests = state.adults + state.children;
        const t = translations[currentLang];
        
        let guestSummaryStr = `${totalGuests} ${t.guestsText}`;
        if (state.children > 0) {
          guestSummaryStr = `${state.adults} Ad. + ${state.children} Niñ. (${totalGuests} total)`;
        }
        summaryGuestsEl.textContent = guestSummaryStr;

        const [year, month, day] = state.date.split('-');
        const mIndex = parseInt(month, 10) - 1;
        const monthShort = (t.months[mIndex] || month).slice(0, 3);
        summaryDateEl.textContent = `${parseInt(day, 10)} ${monthShort}, ${year}`;

        const shiftName = state.shift === 'lunch' ? t.lunchName : t.dinnerName;
        summaryTimeEl.textContent = `${state.time} (${shiftName})`;

        step1View.classList.remove('active');
        step2View.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      function goToStep1() {
        step2View.classList.remove('active');
        step1View.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      btnBackToStep1.addEventListener('click', goToStep1);
      btnEditSummary.addEventListener('click', goToStep1);

      // Zona
      zonePills.forEach(pill => {
        pill.addEventListener('click', () => {
          zonePills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          const val = pill.getAttribute('data-zone') || 'Terraza frente al mar';
          state.zone = val;
          selectedZoneInput.value = val;
        });
      });

      // Confirmar Reserva
      btnConfirmBooking.addEventListener('click', () => {
        const nameVal = inputName.value.trim();
        const phoneVal = inputPhone.value.trim();
        let hasError = false;

        if (!nameVal) {
          errName.classList.remove('hidden');
          inputName.focus();
          hasError = true;
        } else {
          errName.classList.add('hidden');
        }

        if (!phoneVal) {
          errPhone.classList.remove('hidden');
          if (!hasError) inputPhone.focus();
          hasError = true;
        } else {
          errPhone.classList.add('hidden');
        }

        if (hasError) return;

        state.name = nameVal;
        state.phone = phoneVal;
        state.occasion = selectOccasion.value || 'Comida o cena habitual';
        state.notes = textareaNotes.value.trim() || 'Ninguna especificada';

        btnConfirmBooking.disabled = true;
        btnConfirmBooking.style.opacity = '0.85';
        confirmSpinner.classList.remove('hidden');

        const totalComensales = state.adults + state.children;
        const shiftLabel = state.shift === 'lunch' ? 'Almuerzo' : 'Cena';

        const [year, month, day] = state.date.split('-');
        const mIndex = parseInt(month, 10) - 1;
        const monthName = translations[currentLang]?.months[mIndex] || month;
        const formattedDateForMsg = `${parseInt(day, 10)} ${monthName}, ${year}`;

        const message = 
`*NUEVA RESERVA — Buon Appetito*

📅 *Fecha:* ${formattedDateForMsg}
⏰ *Hora:* ${state.time} (${shiftLabel})
• *Comensales:* ${state.adults} Adultos${state.children > 0 ? `, ${state.children} Niños` : ''} (Total: ${totalComensales})
• *Nombre:* ${state.name}
• *Teléfono:* ${state.phone}
• *Zona:* ${state.zone}
• *Ocasión:* ${state.occasion}
• *Notas / Alergias:* ${state.notes}

_Tecnología MYNEXT_`;

        const waUrl = `https://wa.me/${RESTAURANT_WHATSAPP}?text=${encodeURIComponent(message)}`;

        setTimeout(() => {
          btnConfirmBooking.disabled = false;
          btnConfirmBooking.style.opacity = '1';
          confirmSpinner.classList.add('hidden');

          window.open(waUrl, '_blank');
        }, 400);
      });

      inputName.addEventListener('input', () => {
        if (inputName.value.trim()) errName.classList.add('hidden');
      });
      inputPhone.addEventListener('input', () => {
        if (inputPhone.value.trim()) errPhone.classList.add('hidden');
      });

      // Modal
      btnGroupInfo.addEventListener('click', () => {
        modalGroups.classList.remove('hidden');
      });

      btnCloseModal.addEventListener('click', () => {
        modalGroups.classList.add('hidden');
      });

      modalGroups.addEventListener('click', (e) => {
        if (e.target === modalGroups) {
          modalGroups.classList.add('hidden');
        }
      });

      // Idiomas
      function applyLanguage(lang) {
        if (!translations[lang]) return;
        currentLang = lang;
        currentLangText.textContent = lang.toUpperCase();

        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (translations[lang][key]) {
            el.textContent = translations[lang][key];
          }
        });

        document.querySelectorAll('.lang-option').forEach(opt => {
          opt.classList.toggle('active', opt.getAttribute('data-lang') === lang);
        });

        updateFormattedDate();
        renderTimeSlots();
      }

      langToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        langMenu.classList.toggle('hidden');
      });

      changeLangFooter.addEventListener('click', (e) => {
        e.stopPropagation();
        const nextLang = currentLang === 'es' ? 'en' : (currentLang === 'en' ? 'de' : 'es');
        applyLanguage(nextLang);
      });

      document.querySelectorAll('.lang-option').forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-lang');
          applyLanguage(lang);
          langMenu.classList.add('hidden');
        });
      });

      document.addEventListener('click', () => {
        if (!langMenu.classList.contains('hidden')) {
          langMenu.classList.add('hidden');
        }
      });

    });
  </script>
</body>
</html>
