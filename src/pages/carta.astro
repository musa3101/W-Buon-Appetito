---
// Carta & Menú Digital Oficial · Buon Appetito (Port d'Andratx)
import PizzaMenuLoader from '../components/PizzaMenuLoader.astro';
const title = "Carta & Menú Digital | Buon Appetito • Port d'Andratx";
const description = "Carta digital interactiva de Buon Appetito en Port d'Andratx. Cocina mediterránea tradicional italiana, pastas artesanales, pizzas en horno de leña y pescados frescos de Mallorca.";
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />

  <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <meta name="theme-color" content="#0E2015" />

  <!-- Control de Scroll Limpio -->
  <script is:inline>
    try {
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
    } catch (e) {}
  </script>
</head>
<body class="menu-body">

  <!-- Loader Oficial con Pizza Artesanal en Horno de Leña -->
  <PizzaMenuLoader />

  <!-- ======================================================== -->
  <!-- 1. TOP HEADER: VERDE CIPRÉS + LOGO COLORIDO               -->
  <!--    SELECTOR LATERAL DE IDIOMA + VOLVER GORDITO ROJITO    -->
  <!-- ======================================================== -->
  <header class="site-header">
    <div class="container header-container">
      
      <!-- Logotipo Oficial con letras blancas, bandera italiana y tomates a color -->
      <a href="/" class="brand-logo-link" title="Buon Appetito Port d'Andratx">
        <img 
          src="/assets/logos/logo-buon-appetito-color-dark.png" 
          alt="Buon Appetito Port d'Andratx" 
          class="brand-logo"
        />
      </a>

      <!-- Acciones de Cabecera: Selector Lateral Horizontal + Volver Terracota -->
      <div class="header-actions">
        
        <!-- Contenedor de Idioma: Selector Lateral Horizontal dentro del verde del header -->
        <div class="lang-nav-container" id="lang-nav-container">
          
          <!-- Botón disparador compacto -->
          <button 
            type="button" 
            class="lang-pill-btn" 
            id="lang-pill-btn" 
            aria-expanded="false" 
            aria-label="Cambiar idioma"
            title="Cambiar idioma"
          >
            <span id="lang-current-label">ES</span>
            <svg class="lang-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>

          <!-- Menú Lateral Horizontal Desplegable (Ocupa el verde del header hacia la izquierda) -->
          <div class="lang-lateral-menu" id="lang-lateral-menu" role="menu" aria-label="Seleccionar idioma">
            <button type="button" class="lang-opt-btn active" data-lang="es" role="menuitem">ES</button>
            <span class="lang-opt-sep" aria-hidden="true">·</span>
            <button type="button" class="lang-opt-btn" data-lang="en" role="menuitem">EN</button>
            <span class="lang-opt-sep" aria-hidden="true">·</span>
            <button type="button" class="lang-opt-btn" data-lang="de" role="menuitem">DE</button>
            <button type="button" class="lang-opt-close" id="lang-opt-close" aria-label="Cerrar selector de idioma">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>

        </div>

        <!-- Botón Volver Atrás: Más gordito, en terracota/rojito a la extrema derecha -->
        <button type="button" id="btn-back" class="btn-back" aria-label="Volver a la página principal">
          <svg class="back-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span id="txt-back">Volver</span>
        </button>

      </div>

    </div>
  </header>

  <!-- ======================================================== -->
  <!-- 2. HERO EDITORIAL: "Nuestra Carta" en Serif +             -->
  <!--    "GASTRONOMÍA ITALIANA · PORT D'ANDRATX" DEBAJO         -->
  <!-- ======================================================== -->
  <section class="menu-hero" id="inicio">
    <div class="container hero-container">
      <h1 class="hero-title" id="hero-title">Nuestra Carta</h1>
      <span class="hero-subtitle">GASTRONOMÍA ITALIANA · PORT D'ANDRATX</span>
    </div>
  </section>

  <!-- ======================================================== -->
  <!-- 3. BARRA DE CATEGORÍAS NAVBAR PLANA CON SUBRAYADO ACTIVO -->
  <!-- ======================================================== -->
  <div class="category-nav-bar">
    <div class="container nav-container">
      <nav class="category-nav-track" id="category-nav" aria-label="Categorías de la carta">
        <!-- Inyectado dinámicamente con iconos terracota y pestañas planas -->
      </nav>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- 4. LISTADO EDITORIAL LIMPIO DE PLATOS (SIN NÚMEROS)      -->
  <!-- ======================================================== -->
  <main class="container main-content">
    <div id="menu-content" class="menu-content-area">
      <!-- Se inyecta dinámicamente vía script -->
    </div>
  </main>

  <!-- ======================================================== -->
  <!-- 5. FOOTER SAGE MIST (VERDE SALVIA REFINADO)              -->
  <!-- ======================================================== -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-card">
        
        <!-- Precios e Información Dietética y de Alérgenos -->
        <p id="tax-note" class="tax-note">
          Precios con IVA incluido (10%).
        </p>
        <p id="allergen-note" class="allergen-note">
          Disponemos de opciones sin gluten (pastas y pizzas artesanales). Si tiene alguna alergia o intolerancia alimentaria, por favor comuníqueselo a nuestro equipo antes de realizar su comanda.
        </p>

        <!-- Dirección física del Restaurante -->
        <div class="footer-address">
          <svg class="location-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Av. de Mateo Bosch, 24 · Port d'Andratx, Mallorca</span>
        </div>

        <!-- Redes Sociales Oficiales: Instagram & TripAdvisor -->
        <div class="footer-social-row">
          <!-- Instagram -->
          <a 
            href="https://www.instagram.com/buonappetitomallorca/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="social-btn instagram-btn" 
            aria-label="Instagram Buon Appetito"
            title="Síguenos en Instagram"
          >
            <svg class="social-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- TripAdvisor -->
          <a 
            href="https://www.tripadvisor.es/Restaurant_Review-g616239-d24183908-Reviews-Grand_Pasta-Port_d_Andratx_Majorca_Balearic_Islands.html" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="social-btn tripadvisor-btn" 
            aria-label="TripAdvisor Buon Appetito"
            title="Ver opiniones en TripAdvisor"
          >
            <svg class="social-svg" width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.006 4.295c-2.67 0-5.338.784-7.645 2.353H0l1.963 2.135a5.997 5.997 0 0 0 4.04 10.43 5.976 5.976 0 0 0 4.075-1.6L12 19.705l1.922-2.09a5.972 5.972 0 0 0 4.072 1.598 6 6 0 0 0 6-5.998 5.982 5.982 0 0 0-1.957-4.432L24 6.648h-4.35a13.573 13.573 0 0 0-7.644-2.353zM12 6.255c1.531 0 3.063.303 4.504.903C13.943 8.138 12 10.43 12 13.1c0-2.671-1.942-4.962-4.504-5.942A11.72 11.72 0 0 1 12 6.256zM6.002 9.157a4.059 4.059 0 1 1 0 8.118 4.059 4.059 0 0 1 0-8.118zm11.992.002a4.057 4.057 0 1 1 .003 8.115 4.057 4.057 0 0 1-.003-8.115zm-11.992 1.93a2.128 2.128 0 0 0 0 4.256 2.128 2.128 0 0 0 0-4.256zm11.992 0a2.128 2.128 0 0 0 0 4.256 2.128 2.128 0 0 0 0-4.256z"/>
            </svg>
          </a>
        </div>

        <!-- Enlaces Legales Oficiales en Verde Muted -->
        <nav class="footer-legal-nav" aria-label="Enlaces legales">
          <a href="/aviso-legal" class="legal-link" id="legal-aviso">Aviso Legal</a>
          <span class="legal-divider">·</span>
          <a href="/privacidad" class="legal-link" id="legal-privacidad">Privacidad</a>
          <span class="legal-divider">·</span>
          <a href="/cookies" class="legal-link" id="legal-cookies">Cookies</a>
        </nav>

        <p class="footer-copyright">
          &copy; 2026 Buon Appetito · Port d'Andratx, Mallorca.
        </p>

      </div>
    </div>
  </footer>

  <!-- Scripts oficiales sincronizados -->
  <script is:inline src="/data/menu-data.js"></script>

  <script is:inline>
    const UI_TEXT = {
      es: {
        heroTitle: "Nuestra Carta",
        btnBack: "Volver",
        taxIncluded: "Precios con IVA incluido (10%).",
        allergensNote: "Disponemos de opciones sin gluten (pastas y pizzas artesanales). Si tiene alguna alergia o intolerancia alimentaria, por favor comuníqueselo a nuestro equipo antes de realizar su comanda.",
        legalAviso: "Aviso Legal",
        legalPrivacidad: "Privacidad",
        legalCookies: "Cookies"
      },
      en: {
        heroTitle: "Our Menu",
        btnBack: "Back",
        taxIncluded: "All prices include 10% VAT.",
        allergensNote: "Gluten-free options available (artisanal pasta and pizzas). If you have any food allergy or intolerance, please inform our team before ordering.",
        legalAviso: "Legal Notice",
        legalPrivacidad: "Privacy Policy",
        legalCookies: "Cookies"
      },
      de: {
        heroTitle: "Unsere Speisekarte",
        btnBack: "Zurück",
        taxIncluded: "Alle Preise inklusive 10% MwSt.",
        allergensNote: "Glutenfreie Optionen verfügbar (hausgemachte Pasta und Pizzen). Bitte informieren Sie unser Team vor Ihrer Bestellung über eventuelle Allergien oder Unverträglichkeiten.",
        legalAviso: "Impressum",
        legalPrivacidad: "Datenschutz",
        legalCookies: "Cookies"
      }
    };

    const CATEGORY_SVGS = {
      entrantes: `<svg class="cat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>`,
      ensaladas: `<svg class="cat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
      pescados: `<svg class="cat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 12c.94-3.46 4.94-6 8.5-6 3.56 0 6.06 2.54 7 6-.94 3.46-3.44 6-7 6s-7.56-2.54-8.5-6Z"/><path d="M18 12v.5"/><path d="M16 17.93a12.6 12.6 0 0 1-5.3-5.93 12.6 12.6 0 0 1 5.3-5.93"/><path d="M6.5 12 2 7.5v9L6.5 12Z"/></svg>`,
      carnes: `<svg class="cat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 14 1.5 1.5a3.54 3.54 0 0 0 5-5L19 9"/><path d="M16 16c-3.3 3.3-8.5 3-11.8-.3-3.3-3.3-3.6-8.5-.3-11.8 2.5-2.5 6.6-2.8 9.5-.7l-3.2 3.2a2 2 0 1 0 2.8 2.8L16.2 6c2.1 2.9 1.8 7-.2 9.5l0 .5Z"/><circle cx="12" cy="12" r="1.5"/></svg>`,
      arroces: `<svg class="cat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="13" rx="8" ry="4"/><path d="M4 13v2a8 4 0 0 0 16 0v-2"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="M8 8c.5-1.5 2-2 4-2s3.5.5 4 2"/></svg>`,
      pastas: `<svg class="cat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20"/><path d="M8 2v8a4 4 0 0 0 8 0V2"/><path d="M7 14c2.5 1 7.5 1 10 0"/><path d="M6 18c3 1 9 1 12 0"/></svg>`,
      pizzas: `<svg class="cat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2-9.5 17.5a15 15 0 0 0 19 0L12 2Z"/><path d="M5.5 16.5a12 12 0 0 0 13 0"/><circle cx="12" cy="9" r="1"/><circle cx="10" cy="13" r="1"/><circle cx="14" cy="13" r="1"/></svg>`,
      bebidas: `<svg class="cat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 22h8"/><path d="M12 15v7"/><path d="M5 3h14l-5 7.5v4.5h-4V10.5L5 3Z"/><path d="M6.5 6h11"/></svg>`
    };

    let currentLang = 'es';
    let menuData = null;
    let scrollObserver = null;

    async function initMenu() {
      if (window.MENU_DATA) {
        menuData = window.MENU_DATA;
      } else {
        try {
          const res = await fetch('/data/menu.json');
          if (res.ok) menuData = await res.json();
        } catch (e) {
          console.warn('Error loading menu.json', e);
        }
      }

      setupEventListeners();
      updateUILanguage();
      renderMenu();
    }

    function setupEventListeners() {
      const btnBack = document.getElementById('btn-back');
      if (btnBack) {
        btnBack.addEventListener('click', () => {
          if (window.history.length > 1) {
            window.history.back();
          } else {
            window.location.href = '/';
          }
        });
      }

      const langContainer = document.getElementById('lang-nav-container');
      const langPillBtn = document.getElementById('lang-pill-btn');
      const langCloseBtn = document.getElementById('lang-opt-close');
      const langLabel = document.getElementById('lang-current-label');

      if (langPillBtn && langContainer) {
        langPillBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          langContainer.classList.add('open');
          langPillBtn.setAttribute('aria-expanded', 'true');
        });

        if (langCloseBtn) {
          langCloseBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            langContainer.classList.remove('open');
            langPillBtn.setAttribute('aria-expanded', 'false');
          });
        }

        document.addEventListener('click', (e) => {
          if (langContainer && !langContainer.contains(e.target)) {
            langContainer.classList.remove('open');
            langPillBtn.setAttribute('aria-expanded', 'false');
          }
        });

        window.addEventListener('scroll', () => {
          if (langContainer.classList.contains('open')) {
            langContainer.classList.remove('open');
            langPillBtn.setAttribute('aria-expanded', 'false');
          }
        }, { passive: true });

        document.querySelectorAll('.lang-opt-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const selected = btn.getAttribute('data-lang');
            if (selected && selected !== currentLang) {
              const langMessages = {
                es: 'ACTUALIZANDO CARTA...',
                en: 'UPDATING MENU...',
                de: 'SPEISEKARTE WIRD GELADEN...'
              };
              if (typeof window.showPizzaMenuLoader === 'function') {
                window.showPizzaMenuLoader(langMessages[selected] || 'ACTUALIZANDO CARTA...', 750);
              }

              currentLang = selected;
              if (langLabel) langLabel.textContent = selected.toUpperCase();
              document.querySelectorAll('.lang-opt-btn').forEach(el => {
                el.classList.toggle('active', el.getAttribute('data-lang') === selected);
              });
              langContainer.classList.remove('open');
              langPillBtn.setAttribute('aria-expanded', 'false');
              updateUILanguage();
              renderMenu();
            } else {
              langContainer.classList.remove('open');
              langPillBtn.setAttribute('aria-expanded', 'false');
            }
          });
        });
      }
    }

    function updateUILanguage() {
      const t = UI_TEXT[currentLang];
      if (!t) return;

      const titleEl = document.getElementById('hero-title');
      const txtBackEl = document.getElementById('txt-back');
      const taxNoteEl = document.getElementById('tax-note');
      const allergenNoteEl = document.getElementById('allergen-note');
      const legalAvisoEl = document.getElementById('legal-aviso');
      const legalPrivacidadEl = document.getElementById('legal-privacidad');
      const legalCookiesEl = document.getElementById('legal-cookies');

      if (titleEl) titleEl.textContent = t.heroTitle;
      if (txtBackEl) txtBackEl.textContent = t.btnBack;
      if (taxNoteEl) taxNoteEl.textContent = t.taxIncluded;
      if (allergenNoteEl) allergenNoteEl.textContent = t.allergensNote;
      if (legalAvisoEl) legalAvisoEl.textContent = t.legalAviso;
      if (legalPrivacidadEl) legalPrivacidadEl.textContent = t.legalPrivacidad;
      if (legalCookiesEl) legalCookiesEl.textContent = t.legalCookies;

      if (menuData && menuData.categories) {
        const nav = document.getElementById('category-nav');
        if (nav) {
          nav.innerHTML = menuData.categories.map((cat, idx) => `
            <button type="button" class="cat-nav-link ${idx === 0 ? 'active' : ''}" data-cat="${cat.id}">
              <span class="cat-svg-box">${CATEGORY_SVGS[cat.id] || ''}</span>
              <span class="cat-text">${cat[currentLang] || cat.es}</span>
            </button>
          `).join('');

          nav.querySelectorAll('.cat-nav-link').forEach(btn => {
            btn.addEventListener('click', () => {
              nav.querySelectorAll('.cat-nav-link').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              const catId = btn.getAttribute('data-cat');
              const target = document.getElementById(`cat-${catId}`);
              if (target) {
                const headerOffset = 120;
                const elementPosition = target.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                window.scrollTo({
                  top: offsetPosition,
                  behavior: 'smooth'
                });
              }
            });
          });
        }
      }
    }

    function renderMenu() {
      if (!menuData || !menuData.items) return;

      const contentArea = document.getElementById('menu-content');
      if (!contentArea) return;

      const items = menuData.items;
      const categories = menuData.categories;

      let html = '';
      categories.forEach(cat => {
        const catItems = items.filter(i => i.category === cat.id);
        if (catItems.length === 0) return;

        const catTitle = cat[currentLang] || cat.es;

        html += `
          <section class="menu-category-section" id="cat-${cat.id}">
            <div class="menu-category-header">
              <h2 class="category-heading">${catTitle}</h2>
            </div>

            <div class="menu-editorial-list">
              ${catItems.map(item => {
                const trans = item[currentLang] || item.es;
                const hasDesc = Boolean(trans.description && trans.description.trim().length > 0);

                return `
                  <article class="menu-item-row" id="item-${item.id}">
                    <div class="menu-item-top">
                      <div class="menu-item-title-group">
                        <h3 class="menu-item-title">${trans.title}</h3>
                      </div>
                      <span class="menu-item-dots" aria-hidden="true"></span>
                      <span class="menu-item-price">${item.price.toFixed(2)} €</span>
                    </div>
                    ${hasDesc ? `<p class="menu-item-desc">${trans.description}</p>` : ''}
                  </article>
                `;
              }).join('')}
            </div>
          </section>
        `;
      });

      contentArea.innerHTML = html;
      setupScrollSpy();
    }

    function setupScrollSpy() {
      if (scrollObserver) {
        scrollObserver.disconnect();
      }

      const sections = document.querySelectorAll('.menu-category-section');
      const navBtns = document.querySelectorAll('.cat-nav-link');
      if (sections.length === 0 || navBtns.length === 0) return;

      const observerOptions = {
        root: null,
        rootMargin: '-130px 0px -65% 0px',
        threshold: 0
      };

      scrollObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id.replace('cat-', '');
            navBtns.forEach(btn => {
              if (btn.getAttribute('data-cat') === id) {
                btn.classList.add('active');
                btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
              } else {
                btn.classList.remove('active');
              }
            });
          }
        });
      }, observerOptions);

      sections.forEach(sec => scrollObserver.observe(sec));
    }

    document.addEventListener('DOMContentLoaded', initMenu);
  </script>

