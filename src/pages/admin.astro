    // ========================================================
    // NAVEGACIÓN ENTRE 3 CARTAS: COMIDA, BEBIDAS, BODEGA
    // ========================================================
    function switchMenuType(type) {
      state.currentMenuType = type;
      state.selectedCategory = 'all';

      // Pestañas desktop
      document.querySelectorAll('#menuTypeSelector .menu-tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.type === type);
      });

      // Barra inferior móvil
      document.querySelectorAll('.mobile-bottom-nav .bottom-nav-item').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.nav === type);
      });

      renderCategoriesBar();
      renderItems();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.querySelectorAll('#menuTypeSelector .menu-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => switchMenuType(btn.dataset.type));
    });

    document.querySelectorAll('.mobile-bottom-nav .bottom-nav-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const nav = btn.dataset.nav;
        if (nav === 'perfil') {
          openProfileDrawer();
        } else {
          switchMenuType(nav);
        }
      });
    });

    function getCurrentTypeCategories(menuType = state.currentMenuType) {
      let allowed = FOOD_CATEGORIES;
      if (menuType === 'bebidas') allowed = DRINK_CATEGORIES;
      else if (menuType === 'vinos') allowed = WINE_CATEGORIES;

      return state.categories.filter(c => allowed.includes(c.id));
    }

    function updateBadges() {
      const foodCount = state.items.filter(i => FOOD_CATEGORIES.includes(i.category_id)).length;
      const drinkCount = state.items.filter(i => DRINK_CATEGORIES.includes(i.category_id)).length;
      const wineCount = state.items.filter(i => WINE_CATEGORIES.includes(i.category_id)).length;

      const cComida = document.getElementById('countComida');
      const cBebidas = document.getElementById('countBebidas');
      const cVinos = document.getElementById('countVinos');

      if (cComida) cComida.textContent = foodCount;
      if (cBebidas) cBebidas.textContent = drinkCount;
      if (cVinos) cVinos.textContent = wineCount;

      if (statComida) statComida.textContent = foodCount;
      if (statBebidas) statBebidas.textContent = drinkCount;
      if (statVinos) statVinos.textContent = wineCount;
    }

    // Bloqueo de scroll seguro en móvil
