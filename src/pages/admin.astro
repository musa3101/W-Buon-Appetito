      text-transform: uppercase;
      color: var(--brand-primary);
    }
    .logs-title {
      font-size: 16px;
      font-weight: 700;
    }
    .logs-list {
      padding: 16px 20px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 65vh;
    }

    /* Toast */
    .toast-pill {
      position: fixed;
      bottom: calc(76px + var(--safe-bottom));
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      opacity: 0;
      pointer-events: none;
      z-index: 200;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .toast-pill.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    .toast-inner {
      background: #0F172A;
      color: #FFFFFF;
      padding: 10px 18px;
      border-radius: 9999px;
      font-size: 13px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 10px 25px -4px rgba(0, 0, 0, 0.3);
    }
    .toast-pill.error .toast-inner { background: #DC2626; }
  </style>
</head>
<body>

  <!-- ======================================================== -->
  <!-- 1. PANTALLA DE ACCESO (LOGIN) -->
  <!-- ======================================================== -->
  <div id="loginScreen" class="login-wrapper">
    <div class="login-card">
      
      <div style="display: flex; flex-direction: column; align-items: center;">
        <div class="login-logo-box">
          <img src="/assets/logos/logo-buon-appetito-white.png" alt="Buon Appetito">
        </div>
        <h2 class="login-heading">Gestión de Carta</h2>
        <p class="login-subhead">Acceso exclusivo para personal del restaurante</p>
      </div>

