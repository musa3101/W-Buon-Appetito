  <!-- SCRIPT DE CONTROL -->
  <script is:inline type="module">
    import { createClient, createAdminClient } from 'https://esm.sh/@insforge/sdk@latest';

    const INSFORGE_URL = 'https://pz3qiueg.eu-central.insforge.app';
    const ANON_KEY = 'anon_64c904f7d36d64a81882dd8b41b193c03240d144f6de6a656b1d85ba0683ccec';
    const API_KEY = 'ik_7334a7a922b9b5b02262f3bce4c4cad8';

    const VALID_USER = 'buonappetitoandratx@gmail.com';
    const VALID_PASS = 'admin';

    const client = createClient({ baseUrl: INSFORGE_URL, anonKey: ANON_KEY });
    const adminClient = createAdminClient({ baseUrl: INSFORGE_URL, apiKey: API_KEY });

    let state = {
      isAuthenticated: false,
      categories: [],
      items: [],
      selectedCategory: 'all',
      searchQuery: '',
      availabilityFilter: 'all',
      previewLang: 'es',
      activeModalLangTab: 'es'
    };

    // DOM Elements - Login
    const loginScreen = document.getElementById('loginScreen');
    const loginForm = document.getElementById('loginForm');
    const loginEmail = document.getElementById('loginEmail');
    const loginPassword = document.getElementById('loginPassword');
    const loginError = document.getElementById('loginError');
    const togglePasswordBtn = document.getElementById('togglePasswordBtn');
    const appShell = document.getElementById('appShell');
    const btnLogout = document.getElementById('btnLogout');

    // DOM Elements - Header & Metrics
    const dbStatusText = document.getElementById('dbStatusText');
    const metricAvailable = document.getElementById('metricAvailable');
    const metricUnavailable = document.getElementById('metricUnavailable');
    const metricCategories = document.getElementById('metricCategories');
    const metricAvailBar = document.getElementById('metricAvailBar');
    const metricUnavailBar = document.getElementById('metricUnavailBar');

    // DOM Elements - Admin Views
    const categoriesBar = document.getElementById('categoriesBar');
    const itemsList = document.getElementById('itemsList');
    const itemsCountBadge = document.getElementById('itemsCountBadge');
    const currentCategoryTitle = document.getElementById('currentCategoryTitle');
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const availabilityFilter = document.getElementById('availabilityFilter');
    const tabAdminBtn = document.getElementById('tabAdminBtn');
    const tabPreviewBtn = document.getElementById('tabPreviewBtn');
    const viewAdmin = document.getElementById('viewAdmin');
    const viewPreview = document.getElementById('viewPreview');
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toastMsg');
    const toastIcon = document.getElementById('toastIcon');

    // DOM Elements - Modal
    const dishModal = document.getElementById('dishModal');
    const dishForm = document.getElementById('dishForm');
    const modalHeading = document.getElementById('modalHeading');
    const modalSubheading = document.getElementById('modalSubheading');
    const dishId = document.getElementById('dishId');
    const dishOrder = document.getElementById('dishOrder');
    const dishCategory = document.getElementById('dishCategory');
    const dishPrice = document.getElementById('dishPrice');
    const dishAvailable = document.getElementById('dishAvailable');
    const title_es = document.getElementById('title_es');
    const desc_es = document.getElementById('desc_es');
    const title_en = document.getElementById('title_en');
    const desc_en = document.getElementById('desc_en');
    const title_de = document.getElementById('title_de');
    const desc_de = document.getElementById('desc_de');
    const btnAutoTranslate = document.getElementById('btnAutoTranslate');
    const transBtnSpinner = document.getElementById('transBtnSpinner');
    const transBtnText = document.getElementById('transBtnText');
    const deleteContainer = document.getElementById('deleteContainer');
    const btnDeleteDish = document.getElementById('btnDeleteDish');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const btnCancelModal = document.getElementById('btnCancelModal');
    const btnNewDishTop = document.getElementById('btnNewDishTop');
    const fabNewDish = document.getElementById('fabNewDish');
    const saveSpinner = document.getElementById('saveSpinner');
    const saveText = document.getElementById('saveText');

    // Responsive setup: Show desktop button on wide screens
    if (window.innerWidth >= 640 && btnNewDishTop) {
      btnNewDishTop.style.display = 'flex';
    }

    // GESTIÓN DE AUTENTICACIÓN
    function checkAuth() {
      const savedAuth = localStorage.getItem('buon_appetito_auth');
      if (savedAuth === 'true') {
        state.isAuthenticated = true;
        showApp();
      } else {
        showLogin();
      }
    }

    function showLogin() {
      loginScreen.style.display = 'flex';
      appShell.style.display = 'none';
    }

    function showApp() {
      loginScreen.style.display = 'none';
      appShell.style.display = 'flex';
      loadData();
    }

    togglePasswordBtn.addEventListener('click', () => {
      const isPassword = loginPassword.type === 'password';
      loginPassword.type = isPassword ? 'text' : 'password';
      togglePasswordBtn.textContent = isPassword ? '🙈' : '👁️';
    });

    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = loginEmail.value.trim().toLowerCase();
      const pass = loginPassword.value.trim();

      if (email === VALID_USER && pass === VALID_PASS) {
        loginError.style.display = 'none';
        localStorage.setItem('buon_appetito_auth', 'true');
        state.isAuthenticated = true;
        showApp();
      } else {
        loginError.style.display = 'block';
      }
    });

    btnLogout.addEventListener('click', () => {
      if (confirm('¿Cerrar sesión en el panel de administración?')) {
        localStorage.removeItem('buon_appetito_auth');
        state.isAuthenticated = false;
        showLogin();
      }
    });

    // TOAST
    window.hideToast = function() {
      toast.classList.remove('show');
    };

    function showToast(message, isError = false) {
      toastMsg.textContent = message;
      toastIcon.textContent = isError ? '✕' : '✓';
      toastIcon.style.color = isError ? '#F87171' : '#34D399';
      toast.classList.add('show');
      setTimeout(hideToast, 3500);
    }

    // CARGA DE DATOS
    async function loadData() {
      try {
        dbStatusText.textContent = 'Sincronizando...';
        
        const { data: catData, error: catError } = await client.database
          .from('menu_categories')
          .select()
          .order('display_order', { ascending: true });
        
        if (catError) throw catError;
        state.categories = catData || [];

        const { data: itemData, error: itemError } = await client.database
          .from('menu_items')
          .select()
          .order('display_order', { ascending: true });
          
        if (itemError) throw itemError;
        state.items = itemData || [];

        updateMetrics();
        dbStatusText.textContent = `${state.items.length} platos en carta`;
        populateCategorySelect();
        renderCategoriesBar();
        renderItems();
        renderPreview();
      } catch (err) {
        console.error('Error cargando datos:', err);
        dbStatusText.textContent = 'Error al sincronizar';
        showToast('Error cargando platos: ' + err.message, true);
      }
    }

    function updateMetrics() {
      const availCount = state.items.filter(i => i.is_available).length;
      const unavailCount = state.items.filter(i => !i.is_available).length;
      const total = state.items.length;

      metricAvailable.textContent = availCount;
      metricUnavailable.textContent = unavailCount;
      metricCategories.textContent = state.categories.length;

      const availPercent = total > 0 ? (availCount / total) * 100 : 100;
      const unavailPercent = total > 0 ? (unavailCount / total) * 100 : 0;

      metricAvailBar.style.width = `${availPercent}%`;
      metricUnavailBar.style.width = `${unavailPercent}%`;
    }

    function populateCategorySelect() {
      dishCategory.innerHTML = state.categories.map(c => `
        <option value="${c.id}">${c.name_es}</option>
      `).join('');
    }

    function renderCategoriesBar() {
      let html = `
        <button class="cat-pill ${state.selectedCategory === 'all' ? 'active' : ''}" data-cat="all">
          Todos (${state.items.length})
        </button>
      `;

      state.categories.forEach(cat => {
        const count = state.items.filter(i => i.category_id === cat.id).length;
        const active = state.selectedCategory === cat.id;
        html += `
          <button class="cat-pill ${active ? 'active' : ''}" data-cat="${cat.id}">
            ${cat.name_es} (${count})
          </button>
        `;
      });

      categoriesBar.innerHTML = html;

      categoriesBar.querySelectorAll('.cat-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          state.selectedCategory = btn.dataset.cat;
          renderCategoriesBar();
          renderItems();
        });
      });
    }

    function getFilteredItems() {
      return state.items.filter(item => {
        if (state.selectedCategory !== 'all' && item.category_id !== state.selectedCategory) return false;
        if (state.availabilityFilter === 'available' && !item.is_available) return false;
        if (state.availabilityFilter === 'unavailable' && item.is_available) return false;
        
        if (state.searchQuery) {
          const q = state.searchQuery.toLowerCase();
          const matchTitle = (item.title_es || '').toLowerCase().includes(q) ||
                             (item.title_en || '').toLowerCase().includes(q) ||
                             (item.title_de || '').toLowerCase().includes(q);
          const matchDesc = (item.description_es || '').toLowerCase().includes(q);
          const matchCode = (item.item_code || '').toLowerCase().includes(q);
          if (!matchTitle && !matchDesc && !matchCode) return false;
        }
        return true;
      });
    }

    function renderItems() {
      const filtered = getFilteredItems();
      itemsCountBadge.textContent = filtered.length;
      
      const currentCatObj = state.categories.find(c => c.id === state.selectedCategory);
      currentCategoryTitle.textContent = currentCatObj ? currentCatObj.name_es : 'Todos los Platos';

      if (filtered.length === 0) {
        itemsList.innerHTML = `<div style="padding: 40px; text-align: center; color: #78716C; font-size: 13px;">No se encontraron platos que coincidan con los filtros.</div>`;
        return;
      }

      itemsList.innerHTML = filtered.map(item => {
        const isAvail = item.is_available;
        const categoryObj = state.categories.find(c => c.id === item.category_id);
        const categoryName = categoryObj ? categoryObj.name_es : item.category_id;

        return `
          <div class="dish-row ${!isAvail ? 'unavailable' : ''}" data-id="${item.id}">
            
            <div class="dish-info dish-row-click" data-id="${item.id}">
              <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <span style="font-size: 11px; font-family: monospace; color: #A8A29E; font-weight: 700; text-transform: uppercase;">${item.item_code || 'PLATO'}</span>
                <span style="font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 9999px; ${isAvail ? 'background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0;' : 'background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA;'}">
                  ${isAvail ? '🟢 EN CARTA' : '🔴 AGOTADO'}
                </span>
                <span style="font-size: 11px; color: #A8A29E;">· ${categoryName}</span>
              </div>
              <h4 class="dish-title">${item.title_es}</h4>
              <p class="dish-desc">${item.description_es || 'Sin descripción'}</p>
            </div>

            <div class="dish-actions">
              
              <button class="btn-price btn-quick-price" data-id="${item.id}" data-price="${item.price}" title="Toca para cambiar precio">
                <span>${Number(item.price).toFixed(2)} €</span>
                <svg width="12" height="12" fill="none" stroke="#A8A29E" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
              </button>

              <button class="btn-avail ${isAvail ? 'available' : 'unavailable'} btn-toggle-avail" data-id="${item.id}" data-avail="${isAvail}">
                ${isAvail ? '🟢 Disponible' : '🔴 Agotado'}
              </button>

              <button class="btn-edit-details" data-id="${item.id}" title="Editar detalles" style="background: none; border: none; padding: 8px; color: #A8A29E; cursor: pointer; border-radius: 8px;">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </button>

            </div>

          </div>
        `;
      }).join('');

      itemsList.querySelectorAll('.btn-toggle-avail').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = btn.dataset.id;
          const currentAvail = btn.dataset.avail === 'true';
          await updateItemAvailability(id, !currentAvail);
        });
      });

      itemsList.querySelectorAll('.btn-quick-price').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = btn.dataset.id;
          const currentPrice = btn.dataset.price;
          const val = prompt(`Nuevo precio en € para este plato:`, currentPrice);
          if (val !== null && val.trim() !== '') {
            const num = parseFloat(val.replace(',', '.'));
            if (!isNaN(num) && num >= 0) {
              await updateItemPrice(id, num);
            } else {
              alert('Introduce un precio numérico válido.');
            }
          }
        });
      });

      itemsList.querySelectorAll('.btn-edit-details, .dish-row-click').forEach(el => {
        el.addEventListener('click', () => {
          const id = el.dataset.id;
          openEditModal(id);
        });
      });
    }

    async function updateItemAvailability(id, is_available) {
      const item = state.items.find(i => i.id === id);
      const original = item ? item.is_available : null;
      if (item) item.is_available = is_available;
      
      updateMetrics();
      renderItems();
      renderPreview();

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .update({ is_available, updated_at: new Date().toISOString() })
          .eq('id', id);

        if (error) throw error;
        showToast(is_available ? 'Plato disponible en carta' : 'Plato marcado como agotado');
      } catch (err) {
        if (item) item.is_available = original;
        updateMetrics();
        renderItems();
        renderPreview();
        showToast('Error al actualizar disponibilidad: ' + err.message, true);
      }
    }

    async function updateItemPrice(id, price) {
      const item = state.items.find(i => i.id === id);
      const originalPrice = item ? item.price : null;
      if (item) item.price = price;
      
      renderItems();
      renderPreview();

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .update({ price, updated_at: new Date().toISOString() })
          .eq('id', id);

        if (error) throw error;
        showToast(`Precio actualizado a ${price.toFixed(2)} €`);
      } catch (err) {
        if (item) item.price = originalPrice;
        renderItems();
        renderPreview();
        showToast('Error al actualizar precio: ' + err.message, true);
      }
    }

    function openEditModal(id) {
      const item = state.items.find(i => i.id === id);
      if (!item) return;

      dishId.value = item.id;
      dishOrder.value = item.display_order || 1;
      modalHeading.textContent = `Editar Plato`;
      modalSubheading.textContent = `${item.title_es} (${item.item_code || item.id})`;
      
      dishCategory.value = item.category_id;
      dishPrice.value = item.price;
      dishAvailable.value = item.is_available ? 'true' : 'false';

      title_es.value = item.title_es || '';
      desc_es.value = item.description_es || '';
      title_en.value = item.title_en || '';
      desc_en.value = item.description_en || '';
      title_de.value = item.title_de || '';
      desc_de.value = item.description_de || '';

      deleteContainer.style.display = 'block';
      switchModalLangTab('es');
      dishModal.style.display = 'flex';
    }

    function openNewDishModal() {
      dishId.value = '';
      dishOrder.value = state.items.length + 1;
      modalHeading.textContent = `Añadir Nuevo Plato`;
      modalSubheading.textContent = `Introduce el nombre en español y tradúcelo con 1 clic`;
      
      dishCategory.value = state.selectedCategory !== 'all' ? state.selectedCategory : (state.categories[0]?.id || 'entrantes');
      dishPrice.value = '';
      dishAvailable.value = 'true';

      title_es.value = '';
      desc_es.value = '';
      title_en.value = '';
      desc_en.value = '';
      title_de.value = '';
      desc_de.value = '';

      deleteContainer.style.display = 'none';
      switchModalLangTab('es');
      dishModal.style.display = 'flex';
      title_es.focus();
    }

    function closeDishModal() {
      dishModal.style.display = 'none';
    }

    function switchModalLangTab(lang) {
      state.activeModalLangTab = lang;
      document.querySelectorAll('.modal-lang-tab').forEach(t => {
        t.classList.toggle('active', t.dataset.lang === lang);
      });

      document.getElementById('tabContent_es').style.display = lang === 'es' ? 'flex' : 'none';
      document.getElementById('tabContent_en').style.display = lang === 'en' ? 'flex' : 'none';
      document.getElementById('tabContent_de').style.display = lang === 'de' ? 'flex' : 'none';
    }

    document.querySelectorAll('.modal-lang-tab').forEach(t => {
      t.addEventListener('click', () => switchModalLangTab(t.dataset.lang));
    });

    async function translateText(text, targetLang) {
      if (!text || !text.trim()) return '';
      try {
        const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text.trim())}&langpair=es|${targetLang}`;
        const res = await fetch(url);
        const data = await res.json();
        if (data && data.responseData && data.responseData.translatedText) {
          const translated = data.responseData.translatedText;
          if (!translated.toUpperCase().includes('MYMEMORY WARNING')) {
            return translated;
          }
        }
        return text;
      } catch (e) {
        console.warn(`Translation error for ${targetLang}:`, e);
        return text;
      }
    }

    btnAutoTranslate.addEventListener('click', async () => {
      const esTitle = title_es.value.trim();
      const esDesc = desc_es.value.trim();

      if (!esTitle) {
        alert('Por favor, escribe primero el nombre del plato en español.');
        title_es.focus();
        return;
      }

      transBtnSpinner.style.display = 'inline';
      transBtnText.textContent = 'Traduciendo...';
      btnAutoTranslate.disabled = true;

      try {
        const [enTitle, deTitle, enDesc, deDesc] = await Promise.all([
          translateText(esTitle, 'en'),
          translateText(esTitle, 'de'),
          esDesc ? translateText(esDesc, 'en') : Promise.resolve(''),
          esDesc ? translateText(esDesc, 'de') : Promise.resolve('')
        ]);

        title_en.value = enTitle;
        desc_en.value = enDesc;
        title_de.value = deTitle;
        desc_de.value = deDesc;

        showToast('✨ Traducciones en inglés y alemán listas');
        switchModalLangTab('en');
      } catch (err) {
        showToast('Error en la traducción: ' + err.message, true);
      } finally {
        transBtnSpinner.style.display = 'none';
        transBtnText.textContent = '✨ Auto-traducir';
        btnAutoTranslate.disabled = false;
      }
    });

    dishForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = dishId.value;
      const isNew = !id;
      const category_id = dishCategory.value;
      const price = parseFloat(dishPrice.value);
      const is_available = dishAvailable.value === 'true';

      const t_es = title_es.value.trim();
      const d_es = desc_es.value.trim();
      const t_en = title_en.value.trim() || t_es;
      const d_en = desc_en.value.trim() || d_es;
      const t_de = title_de.value.trim() || t_es;
      const d_de = desc_de.value.trim() || d_es;

      saveSpinner.style.display = 'inline';
      saveText.textContent = 'Guardando...';

      try {
        if (isNew) {
          const itemCode = `${category_id}-${String(state.items.length + 1).padStart(2, '0')}`;
          const newPayload = {
            id: itemCode,
            category_id,
            item_code: itemCode,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            is_available,
            display_order: parseInt(dishOrder.value) || state.items.length + 1
          };

          const { data, error } = await adminClient.database
            .from('menu_items')
            .insert([newPayload])
            .select();

          if (error) throw error;
          if (data && data[0]) state.items.push(data[0]);
          showToast('Plato nuevo añadido a la carta');
        } else {
          const updatePayload = {
            category_id,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            is_available,
            updated_at: new Date().toISOString()
          };

          const { error } = await adminClient.database
            .from('menu_items')
            .update(updatePayload)
            .eq('id', id);

          if (error) throw error;

          const item = state.items.find(i => i.id === id);
          if (item) Object.assign(item, updatePayload);
          showToast('Plato actualizado correctamente');
        }

        closeDishModal();
        updateMetrics();
        renderCategoriesBar();
        renderItems();
        renderPreview();
      } catch (err) {
        console.error('Error guardando plato:', err);
        showToast('Error al guardar: ' + err.message, true);
      } finally {
        saveSpinner.style.display = 'none';
        saveText.textContent = 'Guardar Cambios';
      }
    });

    btnDeleteDish.addEventListener('click', async () => {
      const id = dishId.value;
      if (!id) return;

      const item = state.items.find(i => i.id === id);
      const name = item ? item.title_es : 'este plato';

      if (!confirm(`¿Deseas eliminar permanentemente "${name}" de la carta?`)) {
        return;
      }

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .delete()
          .eq('id', id);

        if (error) throw error;

        state.items = state.items.filter(i => i.id !== id);
        closeDishModal();
        updateMetrics();
        renderCategoriesBar();
        renderItems();
        renderPreview();
        showToast('Plato eliminado de la carta');
      } catch (err) {
        showToast('Error al eliminar plato: ' + err.message, true);
      }
    });

    function renderPreview() {
      const previewCategories = document.getElementById('previewCategories');
      const previewDishes = document.getElementById('previewDishes');
      const lang = state.previewLang;

      previewCategories.innerHTML = state.categories.map((c, i) => {
        const title = lang === 'en' ? (c.name_en || c.name_es) : (lang === 'de' ? (c.name_de || c.name_es) : c.name_es);
        return `
          <button class="cat-pill" style="background: #FFFFFF; border: 1px solid #E7E5E4;">
            ${title}
          </button>
        `;
      }).join('');

      const dishes = state.items;
      previewDishes.innerHTML = dishes.map(item => {
        const title = lang === 'en' ? (item.title_en || item.title_es) : (lang === 'de' ? (item.title_de || item.title_es) : item.title_es);
        const desc = lang === 'en' ? (item.description_en || item.description_es) : (lang === 'de' ? (item.description_de || item.description_es) : item.description_es);
        const isAvail = item.is_available;

        return `
          <div style="background: #FFFFFF; padding: 16px; border-radius: 20px; border: 1px solid var(--color-border); box-shadow: 0 2px 8px rgba(0,0,0,0.02); display: flex; flex-direction: column; justify-content: space-between; ${!isAvail ? 'opacity: 0.5; filter: grayscale(1);' : ''}">
            <div>
              <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;">
                <h4 style="font-family: var(--font-serif); font-size: 18px; font-weight: 700; color: #171513;">${title}</h4>
                <span style="font-family: var(--font-serif); font-size: 16px; font-weight: 700; color: var(--color-primary);">${Number(item.price).toFixed(2)} €</span>
              </div>
              <p style="font-size: 12px; color: #57534E; margin-top: 4px;">${desc || ''}</p>
            </div>
            <div style="margin-top: 12px; padding-top: 8px; border-top: 1px solid #F5F4F0; display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: 10px; font-family: monospace; color: #A8A29E; font-weight: 700;">${item.item_code || ''}</span>
              ${!isAvail ? '<span style="font-size: 10px; font-weight: 700; color: #DC2626; background: #FEF2F2; padding: 2px 8px; border-radius: 6px;">No disponible hoy</span>' : '<span style="font-size: 10px; color: #059669; font-weight: 600;">Disponible</span>'}
            </div>
          </div>
        `;
      }).join('');
    }

    if (btnNewDishTop) btnNewDishTop.addEventListener('click', openNewDishModal);
    if (fabNewDish) fabNewDish.addEventListener('click', openNewDishModal);
    closeModalBtn.addEventListener('click', closeDishModal);
    btnCancelModal.addEventListener('click', closeDishModal);
    dishModal.addEventListener('click', (e) => {
      if (e.target === dishModal) closeDishModal();
    });

    document.querySelectorAll('.preview-lang').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.preview-lang').forEach(b => {
          b.style.background = 'transparent';
          b.style.color = '#A8A29E';
        });
        btn.style.background = 'var(--color-primary)';
        btn.style.color = '#FFFFFF';
        state.previewLang = btn.dataset.lang;
        renderPreview();
      });
    });

    tabAdminBtn.addEventListener('click', () => {
      viewAdmin.style.display = 'flex';
      viewPreview.style.display = 'none';
      tabAdminBtn.classList.add('active');
      tabPreviewBtn.classList.remove('active');
    });

    tabPreviewBtn.addEventListener('click', () => {
      viewAdmin.style.display = 'none';
      viewPreview.style.display = 'flex';
      tabPreviewBtn.classList.add('active');
      tabAdminBtn.classList.remove('active');
    });

    searchInput.addEventListener('input', (e) => {
      state.searchQuery = e.target.value.trim();
      clearSearchBtn.style.display = state.searchQuery.length > 0 ? 'block' : 'none';
      renderItems();
    });

    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      state.searchQuery = '';
      clearSearchBtn.style.display = 'none';
      renderItems();
    });

    availabilityFilter.addEventListener('change', (e) => {
      state.availabilityFilter = e.target.value;
      renderItems();
    });

    checkAuth();
  </script>
</body>
</html>
