    function checkAuth() {
      const urlParams = new URLSearchParams(window.location.search);
      const isAuth = localStorage.getItem('buon_appetito_auth') === 'true';
      const isRemember = localStorage.getItem('buon_appetito_remember') === 'true';

      if (urlParams.get('demo') === '1' || (isAuth && isRemember) || isAuth) {
        state.isAuthenticated = true;
        showApp();
      } else {
        showLogin();
      }
    }

