    .ios-item-title {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text-main);
      display: block;
    }
    .ios-item-sub {
      font-size: 11.5px;
      color: var(--text-muted);
      display: block;
    }
    .ios-chevron {
      color: var(--text-subtle);
      font-size: 18px;
    }

    .btn-logout-drawer {
      height: 44px;
      background: transparent;
      border: 1px solid #FCA5A5;
      color: #DC2626;
      border-radius: 12px;
      font-size: 13.5px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 10px;
    }

    /* Modal standard window */
    .modal-window {
      width: 100%;
      max-width: 440px;
      background: #FFFFFF;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: var(--shadow-float);
      margin: auto 16px;
    }
    .modal-head {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-subtle);
