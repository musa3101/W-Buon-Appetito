    function switchMenuType(type) {
      state.currentMenuType = type;
      state.selectedCategory = 'all';

      // Pestañas superiores (desktop y mobile)
      document.querySelectorAll('#menuTypeSelector .menu-tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.type === type);
      });

      // Barra inferior móvil
      document.querySelectorAll('.mobile-bottom-nav .bottom-nav-item').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.nav === type);
      });

      renderCategoriesBar();
      renderItems();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.querySelectorAll('#menuTypeSelector .menu-tab-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        switchMenuType(btn.dataset.type);
      });
    });

    document.querySelectorAll('.mobile-bottom-nav .bottom-nav-item').forEach(btn => {
      let touchMoved = false;
      btn.addEventListener('touchstart', () => { touchMoved = false; }, { passive: true });
      btn.addEventListener('touchmove', () => { touchMoved = true; }, { passive: true });
      btn.addEventListener('touchend', (e) => {
        if (!touchMoved) {
          e.preventDefault();
          const nav = btn.dataset.nav;
          if (nav === 'perfil') {
            openProfileDrawer();
          } else {
            switchMenuType(nav);
          }
        }
      }, { passive: false });

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const nav = btn.dataset.nav;
        if (nav === 'perfil') {
          openProfileDrawer();
        } else {
          switchMenuType(nav);
        }
