    // ========================================================
    // REGISTRO DE CAMBIOS (LOGS)
    // ========================================================
    const fmtEUR = n => Number(n).toFixed(2).replace('.', ',') + ' €';
    async function logAction(action, item_id, item_title, details = '') {
      try {
        await adminClient.database.from('menu_logs').insert([{ action, item_id, item_title, details }]);
      } catch (e) { console.warn('No se pudo registrar la acción', e); }
    }
    function describeChanges(before, after) {
      const out = [];
      if (Number(before.price) !== Number(after.price)) out.push(`Precio ${fmtEUR(before.price)} → ${fmtEUR(after.price)}`);
      if (before.category_id !== after.category_id) {
        const n = id => (state.categories.find(c => c.id === id) || {}).name_es || id;
        out.push(`Sección ${n(before.category_id)} → ${n(after.category_id)}`);
      }
      if ((before.title_es || '') !== after.title_es) out.push(`Nombre: "${before.title_es}" → "${after.title_es}"`);
      if ((before.description_es || '') !== after.description_es) out.push('Descripción modificada');
      const tr = ['title_en','title_de','description_en','description_de'].some(k => (before[k] || '') !== after[k]);
      if (tr) out.push('Traducciones EN/DE modificadas');
      if (before.is_available !== after.is_available) {
        out.push(after.is_available ? 'Disponible en carta' : 'Agotado');
      }
      if ((before.image_url || '') !== (after.image_url || '')) {
        out.push(after.image_url ? 'Foto actualizada' : 'Foto eliminada');
      }
      return out;
    }
    const logsModal = document.getElementById('logsModal');
    const logsList = document.getElementById('logsList');
    function closeLogsModal() {
      if (logsModal.style.display === 'none') return;
      logsModal.style.display = 'none';
      unlockBackgroundScroll();
    }
    async function openLogs() {
      closeProfileDrawer();
      lockBackgroundScroll();
      logsModal.style.display = 'flex';
      logsList.innerHTML = '<div style="padding: 30px; text-align: center; color: var(--text-muted); font-size: 13px;">Cargando…</div>';
      try {
        const { data, error } = await adminClient.database.from('menu_logs').select().order('created_at', { ascending: false }).limit(100);
        if (error) throw error;
        if (!data || !data.length) {
          logsList.innerHTML = '<div style="padding: 30px; text-align: center; color: var(--text-muted); font-size: 13px;">Todavía no hay cambios registrados.</div>';
          return;
        }
        const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
        const icons = { create: '➕', update: '✏️', price: '💶', delete: '🗑️' };
        const verbs = { create: 'Añadido', update: 'Modificado', price: 'Precio cambiado', delete: 'Eliminado' };
        const today = new Date().toDateString();
        const yest = new Date(Date.now() - 864e5).toDateString();
        let html = '', lastDay = '';
        data.forEach(l => {
          const d = new Date(l.created_at);
          const ds = d.toDateString();
          const label = ds === today ? 'Hoy' : ds === yest ? 'Ayer' : d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
          if (ds !== lastDay) { html += `<div class="logs-day">${label}</div>`; lastDay = ds; }
          html += `<div class="log-item">
            <div class="log-dot ${esc(l.action)}">${icons[l.action] || '•'}</div>
            <div class="log-body">
              <div class="log-line">${verbs[l.action] || esc(l.action)}: <b>${esc(l.item_title)}</b></div>
              ${l.details ? `<div class="log-details">${esc(l.details)}</div>` : ''}
            </div>
            <div class="log-time">${d.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}</div>
          </div>`;
        });
        logsList.innerHTML = html;
      } catch (e) {
        logsList.innerHTML = '<div style="padding: 30px; text-align: center; color: #B91C1C; font-size: 13px;">No se pudo cargar el registro.</div>';
      }
    }
    btnOpenLogsFromDrawer.addEventListener('click', (e) => {
      e.preventDefault();
      openLogs();
    });
    const closeLogsBtn = document.getElementById('closeLogsBtn');
    if (closeLogsBtn) {
      closeLogsBtn.addEventListener('click', (e) => {
        e.preventDefault();
        closeLogsModal();
      });
    }
    logsModal.addEventListener('click', e => { if (e.target === logsModal) closeLogsModal(); });
    logsModal.addEventListener('touchend', e => {
      if (e.target === logsModal) {
        e.preventDefault();
        closeLogsModal();
      }
    }, { passive: false });

    // Toast
    function showToast(message, isError = false) {
      toastMsg.textContent = message;
      toastIcon.textContent = isError ? '✕' : '✓';
      toast.classList.add('active');
      setTimeout(() => toast.classList.remove('active'), 2500);
