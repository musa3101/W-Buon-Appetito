---
// Página de Administración Privada de Carta - Buon Appetito
// Versión 2.0: Mobile-First Luxury, Shadcn & 21st.dev UI
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Buon Appetito · Gestión de Carta</title>
  <meta name="robots" content="noindex, nofollow">

  <!-- PWA & Mobile Web App Meta Tags -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Buon Appetito">
  <meta name="theme-color" content="#183321">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">
  
  <style is:global>
    :root {
      --bg: #F8FAFC;
      --card: #FFFFFF;
      --border: #E2E8F0;
      --border-subtle: #F1F5F9;
      --text-main: #0F172A;
      --text-muted: #64748B;
      --text-subtle: #94A3B8;
      
      --brand-header: #14281B;
      --brand-primary: #183321;
      --brand-hover: #102417;
      --brand-light: #EBF3ED;
      --brand-gold: #C5A880;
      --brand-gold-light: #F7F3EC;

      --emerald: #10B981;
      --emerald-bg: #ECFDF5;
      --emerald-border: #A7F3D0;
      --emerald-text: #065F46;

      --amber: #F59E0B;
      --amber-bg: #FFFBEB;
      --amber-border: #FDE68A;
      --amber-text: #92400E;

      --blue: #2563EB;
      --blue-bg: #EFF6FF;
      --blue-border: #BFDBFE;
      --blue-text: #1E40AF;

      --purple: #7C3AED;
      --purple-bg: #F5F3FF;
      --purple-border: #DDD6FE;
      --purple-text: #5B21B6;

      --radius-xl: 20px;
      --radius-lg: 16px;
      --radius-md: 12px;
      --radius-sm: 8px;

      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-card: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.04);
      --shadow-float: 0 10px 25px -5px rgba(15, 23, 42, 0.12), 0 8px 10px -6px rgba(15, 23, 42, 0.06);
      --shadow-sheet: 0 -12px 35px -8px rgba(15, 23, 42, 0.22);

      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    /* PREVENCIÓN ESTRICTA DE DOBLE CLIC ZOOM EN IPHONE */
    html, body, button, a, input, textarea, select, .dish-row, .modal-window, .dish-studio-window {
      touch-action: manipulation;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      -webkit-tap-highlight-color: transparent;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      font-size: 14px;
      line-height: 1.45;
      padding-top: var(--safe-top);
      padding-bottom: var(--safe-bottom);
      -webkit-font-smoothing: antialiased;
    }

    button, input, select, textarea {
      font-family: inherit;
    }

    img { max-width: 100%; height: auto; display: block; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* ========================================================
       1. LOGIN
       ======================================================== */
    .login-wrapper {
      position: fixed;
      inset: 0;
      z-index: 150;
      background: radial-gradient(ellipse at 50% 25%, #1F3F2B 0%, #112418 55%, #08110B 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: calc(16px + var(--safe-top)) 16px calc(16px + var(--safe-bottom));
      overflow-y: auto;
    }

    .login-card {
      width: 100%;
      max-width: 390px;
      background: rgba(25, 22, 20, 0.92);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-radius: 24px;
      border: 1px solid rgba(197, 168, 128, 0.25);
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.65), 0 0 45px -10px rgba(24, 51, 33, 0.6);
      padding: 32px 24px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 18px;
      animation: loginIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes loginIn {
      from { opacity: 0; transform: translateY(12px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .login-card.shake { animation: shakeCard 0.4s ease-in-out; }
    @keyframes shakeCard {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-7px); }
      40%, 80% { transform: translateX(7px); }
    }

    .login-logo-box {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(197, 168, 128, 0.3);
      padding: 10px 18px;
      border-radius: 14px;
      display: inline-flex;
      margin: 0 auto;
    }
    .login-logo-box img { height: 28px; width: auto; object-fit: contain; }

    .login-heading {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 27px;
      font-weight: 700;
      color: #FAF8F5;
      margin-top: 8px;
      line-height: 1.1;
    }

    .login-subhead {
      font-size: 12.5px;
      color: rgba(250, 248, 245, 0.7);
      margin-top: 2px;
    }

    .form-group {
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label {
      font-size: 12px;
      font-weight: 600;
      color: #FAF8F5;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .form-input-login {
      width: 100%;
      height: 44px;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(197, 168, 128, 0.3);
      border-radius: 12px;
      padding: 0 14px;
      font-size: 14px;
      color: #FAF8F5;
      transition: all 0.2s;
    }
    .form-input-login:focus {
      outline: none;
      border-color: #10B981;
      background: rgba(255, 255, 255, 0.12);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }

    .input-wrapper { position: relative; width: 100%; }
    .btn-toggle-pass {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: rgba(250, 248, 245, 0.6);
      cursor: pointer;
      display: flex;
      padding: 4px;
    }

    .remember-row {
      display: flex;
      align-items: center;
      gap: 10px;
      text-align: left;
      cursor: pointer;
      user-select: none;
      padding: 6px 0;
    }
    .remember-check {
      width: 18px;
      height: 18px;
      accent-color: #10B981;
      cursor: pointer;
    }
    .remember-title {
      font-size: 12.5px;
      font-weight: 600;
      color: #FAF8F5;
      display: block;
    }
    .remember-desc {
      font-size: 11px;
      color: rgba(250, 248, 245, 0.6);
      display: block;
    }

    .login-error {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #FCA5A5;
      padding: 10px;
      border-radius: 10px;
      font-size: 12.5px;
    }

    .btn-login {
      height: 46px;
      background: linear-gradient(135deg, #10B981 0%, #059669 100%);
      color: #FFFFFF;
      font-weight: 700;
      font-size: 14.5px;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
      transition: transform 0.15s, opacity 0.15s;
    }
    .btn-login:active { transform: scale(0.98); }

    /* ========================================================
       2. CABECERA PREMIUM (VERDE BOSQUE ITALIANO & CONTRASTE)
       ======================================================== */
    .app-shell {
      display: none;
      flex-direction: column;
      min-height: 100vh;
      min-height: 100dvh;
      background: var(--bg);
    }

    .top-header {
      position: sticky;
      top: 0;
      z-index: 40;
      background: linear-gradient(135deg, #183321 0%, #112518 100%);
      border-bottom: 1px solid rgba(197, 168, 128, 0.25);
      height: 58px;
      display: flex;
      align-items: center;
      padding: 0 16px;
      box-shadow: 0 4px 20px -5px rgba(24, 51, 33, 0.35);
    }

    .header-bar {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-logo-link {
      display: flex;
      align-items: center;
      text-decoration: none;
      gap: 8px;
    }
    .header-logo-img {
      height: 24px;
      width: auto;
      object-fit: contain;
      filter: brightness(0) invert(1); /* Logo blanco nítido sobre verde bosque */
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-sync {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.12);
      color: #FAF8F5;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-sync:hover { background: rgba(255, 255, 255, 0.2); }
    .sync-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #34D399;
      box-shadow: 0 0 8px #34D399;
    }
    .btn-sync.syncing .sync-dot {
      background: #60A5FA;
      animation: pulseDot 1s infinite;
    }
    @keyframes pulseDot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.8); } }

    .btn-profile {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px 4px 4px;
      border-radius: 9999px;
      border: 1px solid rgba(197, 168, 128, 0.35);
      background: rgba(255, 255, 255, 0.1);
      cursor: pointer;
      color: #FAF8F5;
      font-size: 12.5px;
      font-weight: 600;
      transition: background 0.15s;
    }
    .btn-profile:hover { background: rgba(255, 255, 255, 0.2); }
    .avatar-badge {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #C5A880;
      color: #183321;
      font-size: 11px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ========================================================
       3. TOP TABS SELECTOR (SOLO DESKTOP)
       ======================================================== */
    .menu-type-selector {
      display: flex;
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 4px;
      gap: 4px;
      margin-bottom: 16px;
    }

    @media (max-width: 768px) {
      .menu-type-selector {
        display: none !important; /* ELIMINA DUPLICACIÓN EN IPHONE */
      }
    }

    .menu-tab-btn {
      flex: 1;
      height: 42px;
      border: none;
      background: transparent;
      border-radius: var(--radius-md);
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.15s;
    }
    .menu-tab-btn:hover { color: var(--text-main); background: var(--border-subtle); }
    .menu-tab-btn.active {
      background: var(--brand-primary);
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(24, 51, 33, 0.2);
    }
    .tab-badge {
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 9999px;
      background: rgba(15, 23, 42, 0.08);
      color: inherit;
    }
    .menu-tab-btn.active .tab-badge {
      background: rgba(255, 255, 255, 0.2);
      color: #FFFFFF;
    }

    /* ========================================================
       4. MAIN CONTAINER & TOOLBAR (SHADCN STYLE)
       ======================================================== */
    .admin-container {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 14px 16px 100px;
      flex: 1;
    }

    .toolbar-card {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 12px 14px;
      box-shadow: var(--shadow-card);
      margin-bottom: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .toolbar-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .search-box {
      position: relative;
      flex: 1;
      width: 100%;
      display: flex;
      align-items: center;
    }
    .search-input {
      width: 100%;
      height: 42px;
      background: var(--border-subtle);
      border: 1px solid transparent;
      border-radius: 12px;
      padding: 0 12px 0 38px;
      font-size: 14px;
      color: var(--text-main);
      transition: all 0.15s;
    }
    .search-input:focus {
      outline: none;
      background: #FFFFFF;
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px var(--brand-ring);
    }

    .btn-add-dish {
      height: 42px;
      padding: 0 16px;
      background: var(--brand-primary);
      color: #FFFFFF;
      border: none;
      border-radius: 12px;
      font-size: 13.5px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: background 0.15s;
    }
    .btn-add-dish:hover { background: var(--brand-hover); }
    .btn-add-dish:active { transform: scale(0.98); }

    @media (max-width: 768px) {
      .btn-add-dish { display: none !important; } /* EN MÓVIL SE USA EL FAB FLOTANTE */
    }

    /* Category Chips Carousel */
    .categories-strip {
      display: flex;
      align-items: center;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 2px;
      -webkit-overflow-scrolling: touch;
    }

    .cat-chip {
      height: 34px;
      padding: 0 14px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid var(--border);
      background: #FFFFFF;
      color: var(--text-muted);
      cursor: pointer;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .cat-chip:hover {
      background: var(--border-subtle);
      color: var(--text-main);
    }
    .cat-chip.active {
      background: var(--brand-primary);
      border-color: var(--brand-primary);
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(24, 51, 33, 0.25);
    }
    .cat-chip-count {
      font-size: 11px;
      opacity: 0.85;
      font-variant-numeric: tabular-nums;
    }

    /* KPI Bar */
    .ops-kpi-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      margin-bottom: 14px;
      font-size: 12.5px;
    }
    .ops-kpi-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .ops-kpi-item {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--text-muted);
    }
    .kpi-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }
    .kpi-dot.live { background: var(--emerald); }
    .kpi-dot.out { background: var(--amber); }
    .kpi-val { font-weight: 700; color: var(--text-main); font-variant-numeric: tabular-nums; }
    .ops-kpi-divider { width: 1px; height: 12px; background: var(--border); }
    .ops-kpi-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--brand-primary);
      font-weight: 700;
      text-decoration: none;
      font-size: 12px;
    }

    /* Section Headings */
    .menu-section {
      margin-bottom: 20px;
    }
    .section-head {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
      padding: 0 4px;
    }
    .sec-name {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
    }
    .sec-line {
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    .sec-count {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-subtle);
      background: var(--border-subtle);
      padding: 2px 7px;
      border-radius: 999px;
      font-variant-numeric: tabular-nums;
    }

    /* ========================================================
       5. DISH CARDS (REDISEÑO LIMPIO - SIN SWITCH EN LA LISTA)
       ======================================================== */
    .section-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    @media (min-width: 769px) {
      .section-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }
    }

    .dish-row {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 14px 16px;
      box-shadow: var(--shadow-card);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      cursor: pointer;
      transition: border-color 0.15s, transform 0.1s, box-shadow 0.15s;
      position: relative;
    }
    .dish-row:hover {
      border-color: #CBD5E1;
      box-shadow: var(--shadow-sm);
    }
    .dish-row:active {
      transform: scale(0.995);
    }
    .dish-row.out-of-stock {
      background: #F8FAFC;
      border-color: #E2E8F0;
      opacity: 0.85;
    }

    .dish-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .dish-top-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
    }

    .dish-name {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.25;
      letter-spacing: -0.01em;
    }
    .dish-row.out-of-stock .dish-name {
      color: #64748B;
    }

    .dish-price {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-main);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .dish-desc {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .dish-meta-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
      font-size: 11.5px;
      color: var(--text-subtle);
    }

    .dish-badge-status {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 1px 7px;
      border-radius: 999px;
      font-size: 10.5px;
      font-weight: 700;
    }
    .dish-badge-status.in {
      background: var(--emerald-bg);
      color: var(--emerald-text);
    }
    .dish-badge-status.out {
      background: var(--amber-bg);
      color: var(--amber-text);
    }

    .dish-row-arrow {
      color: var(--text-subtle);
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    /* ========================================================
       6. FLOATING ACTION BUTTON (FAB) EN MÓVIL
       ======================================================== */
    .mobile-fab-btn {
      position: fixed;
      right: 18px;
      bottom: calc(72px + var(--safe-bottom));
      z-index: 35;
      background: var(--brand-primary);
      color: #FFFFFF;
      height: 48px;
      padding: 0 20px;
      border-radius: 9999px;
      font-size: 14px;
      font-weight: 700;
      border: none;
      box-shadow: 0 10px 25px -4px rgba(24, 51, 33, 0.5);
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .mobile-fab-btn:active { transform: scale(0.96); }

    @media (min-width: 769px) {
      .mobile-fab-btn { display: none !important; }
    }

    /* ========================================================
       7. MOBILE BOTTOM NAV (LUCIDE ICONS)
       ======================================================== */
    .mobile-bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 40;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid var(--border);
      height: calc(58px + var(--safe-bottom));
      padding-bottom: var(--safe-bottom);
      display: flex;
      align-items: center;
      justify-content: space-around;
    }

    @media (min-width: 769px) {
