    /* Language Tabs */
    .studio-lang-selector {
      display: flex;
      background: var(--border-subtle);
      border-radius: 10px;
      padding: 3px;
      gap: 3px;
    }
    .studio-lang-tab {
      flex: 1;
      height: 32px;
      border: none;
      background: transparent;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.15s;
