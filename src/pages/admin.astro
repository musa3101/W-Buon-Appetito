---
// Página de Administración Privada de Carta - Buon Appetito
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Buon Appetito · Gestión de Carta</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --bg: #F7F5F0;
      --surface: #FFFFFF;
      --dark: #191614;
      --burgundy: #7A1C28;
      --burgundy-hover: #5F141E;
      --gold: #C5A880;
      --border: #E8E5DF;
      --border-subtle: #F0ECE4;
      --text: #191614;
      --text-muted: #78716C;
      --text-light: #A8A29E;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      -webkit-tap-highlight-color: transparent;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      font-size: 14px;
      line-height: 1.4;
    }

    button, input, select, textarea {
      font-family: inherit;
      touch-action: manipulation;
    }

    img { max-width: 100%; height: auto; display: block; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* ========================================================
       1. PANTALLA DE ACCESO (LOGIN)
       ======================================================== */
    .login-wrapper {
      position: fixed;
      inset: 0;
      z-index: 50;
      background-color: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .login-card {
      width: 100%;
      max-width: 380px;
      background: var(--surface);
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
      padding: 32px 24px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .login-logo-box {
      background: var(--dark);
      padding: 12px 20px;
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
    }

    .login-logo-box img {
      height: 32px;
      width: auto;
      object-fit: contain;
    }

    .login-heading {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 26px;
      font-weight: 700;
      color: var(--dark);
      margin-top: 6px;
      line-height: 1.1;
    }

    .login-subhead {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .form-group {
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label {
      font-size: 12px;
      font-weight: 600;
      color: #44403C;
    }

    .form-input {
      width: 100%;
      padding: 11px 14px;
      font-size: 14px;
      background: #FAF9F6;
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text);
      outline: none;
      transition: all 0.2s ease;
    }

    .form-input:focus {
      background: #FFFFFF;
      border-color: var(--burgundy);
      box-shadow: 0 0 0 3px rgba(122, 28, 40, 0.1);
    }

    .btn-login {
      width: 100%;
      padding: 13px;
      background: var(--burgundy);
      color: #FFFFFF;
      border: none;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(122, 28, 40, 0.2);
      transition: all 0.2s ease;
    }

    .btn-login:active {
      transform: scale(0.98);
      background: var(--burgundy-hover);
    }

    .login-error {
      background: #FEF2F2;
      border: 1px solid #FECACA;
      color: #B91C1C;
      padding: 10px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 500;
    }

    /* ========================================================
       2. HEADER DEL PANEL (ULTRA-LIMPIO)
       ======================================================== */
    .top-header {
      background: var(--dark);
      color: #FFFFFF;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .header-bar {
      max-width: 1000px;
      margin: 0 auto;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .header-logo-link {
      display: flex;
      align-items: center;
      text-decoration: none;
    }

    .header-logo-link img {
      height: 28px;
      width: auto;
      object-fit: contain;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Botón de Sincronización */
    .btn-sync {
      background: rgba(255, 255, 255, 0.08);
      color: #E7E5E4;
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 6px 12px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .btn-sync:hover {
      background: rgba(255, 255, 255, 0.15);
      color: #FFFFFF;
    }

    .btn-sync.synced {
      background: rgba(5, 150, 105, 0.15);
      border-color: rgba(5, 150, 105, 0.35);
      color: #34D399;
    }

    .btn-sync.syncing {
      background: rgba(217, 119, 6, 0.15);
      border-color: rgba(217, 119, 6, 0.35);
      color: #FBBF24;
    }

    .spin-icon {
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .btn-logout {
      background: none;
      border: none;
      color: #A8A29E;
      padding: 6px 10px;
      border-radius: 8px;
      font-size: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      transition: color 0.2s ease;
    }

    .btn-logout:hover {
      color: #FFFFFF;
    }

    /* ========================================================
       3. CONTENIDO PRINCIPAL
       ======================================================== */
    .admin-container {
      max-width: 1000px;
      width: 100%;
      margin: 0 auto;
      padding: 16px;
      padding-bottom: 80px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    /* Barra Superior de Herramientas */
    .toolbar-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    }

    .toolbar-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .search-box {
      flex: 1;
      min-width: 200px;
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-input {
      width: 100%;
      padding: 9px 12px 9px 34px;
      font-size: 13px;
      background: #FAF9F6;
      border: 1px solid var(--border);
      border-radius: 10px;
      outline: none;
      color: var(--text);
    }

    .search-input:focus {
      background: #FFFFFF;
      border-color: var(--burgundy);
    }

    .filter-select {
      padding: 9px 12px;
      font-size: 13px;
      font-weight: 600;
      background: #FAF9F6;
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      cursor: pointer;
      outline: none;
    }

    .btn-add-dish {
      padding: 9px 16px;
      background: var(--burgundy);
      color: #FFFFFF;
      border: none;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: background 0.2s ease;
    }

    .btn-add-dish:active {
      transform: scale(0.98);
      background: var(--burgundy-hover);
    }

    /* Píldoras de Categorías */
    .categories-strip {
      display: flex;
      align-items: center;
      gap: 6px;
      overflow-x: auto;
      padding-top: 2px;
    }

    .cat-btn {
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
      border: 1px solid transparent;
      cursor: pointer;
      background: #F3F1EC;
      color: #57534E;
      transition: all 0.15s ease;
    }

    .cat-btn.active {
      background: var(--dark);
      color: #FFFFFF;
    }

    /* ========================================================
       4. LISTA DE PLATOS (EDITORIAL, AGRUPADA POR SECCIÓN)
       ======================================================== */
    .menu-card { background: transparent; border: none; box-shadow: none; overflow: visible; }
    .menu-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 4px 4px 10px;
    }
    .menu-header-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 24px; font-weight: 700; color: var(--dark);
      display: flex; align-items: center; gap: 8px; letter-spacing: -0.01em;
    }
    #itemsCountBadge {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 11px; font-weight: 700; color: var(--burgundy);
      background: rgba(122, 28, 40, 0.08); padding: 3px 9px; border-radius: 999px;
    }
    .menu-section { margin-bottom: 18px; }
    .section-head {
      position: sticky; top: 52px; z-index: 5;
      display: flex; align-items: center; gap: 10px;
      padding: 10px 4px 8px; background: var(--bg);
    }
    .section-head .sec-name {
      font-size: 11px; font-weight: 800; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--burgundy);
    }
    .section-head .sec-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--gold), transparent); opacity: .6; }
    .section-head .sec-count { font-size: 11px; color: var(--text-light); font-weight: 600; }
    .section-list {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 18px; overflow: hidden;
      box-shadow: 0 1px 2px rgba(25,22,20,.03), 0 8px 24px -12px rgba(25,22,20,.08);
    }
    .dish-row {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 16px; min-height: 64px;
      border-bottom: 1px solid var(--border-subtle);
      cursor: pointer; -webkit-tap-highlight-color: transparent;
      transition: background-color .15s ease;
      animation: rowIn .35s ease both;
    }
    .dish-row:last-child { border-bottom: none; }
    .dish-row:hover { background: #FBF8F3; }
    .dish-row:active { background: #F4EEE5; }
    @keyframes rowIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
    .dish-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
    .dish-name {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 19px; font-weight: 700; line-height: 1.15; color: var(--dark);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .dish-sub {
      font-size: 12.5px; color: var(--text-muted); line-height: 1.35;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .dish-sub.empty { color: var(--text-light); font-style: italic; }
    .dish-meta { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .dish-price {
      font-size: 14px; font-weight: 700; color: var(--burgundy);
      background: rgba(122, 28, 40, 0.06); border: 1px solid rgba(122, 28, 40, 0.12);
      padding: 5px 10px; border-radius: 999px; white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .dish-arrow { color: var(--text-light); display: flex; transition: transform .15s ease, color .15s ease; }
    .dish-row:hover .dish-arrow { color: var(--burgundy); transform: translateX(2px); }
    @media (min-width: 760px) {
      .dish-row { padding: 16px 22px; }
      .dish-name { font-size: 20px; }
      .section-head { top: 56px; }
    }

    /* ========================================================
       5. MODAL BOTTOM SHEET
       ======================================================== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(2px);
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    @media (min-width: 600px) {
      .modal-overlay {
        align-items: center;
        padding: 20px;
      }
    }

    .modal-window {
      width: 100%;
      max-width: 520px;
      background: #FFFFFF;
      border-top-left-radius: 24px;
      border-top-right-radius: 24px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.2);
    }

    @media (min-width: 600px) {
      .modal-window {
        border-radius: 20px;
        max-height: 85vh;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
      }
    }

    .modal-head {
      background: var(--dark);
      color: #FFFFFF;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-title {
      font-size: 16px;
      font-weight: 700;
    }

    .modal-close-btn {
      background: rgba(255, 255, 255, 0.12);
      border: none;
      color: #FFFFFF;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 13px;
    }

    .modal-body-scroll {
      padding: 18px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .modal-foot {
      padding: 14px 18px;
      border-top: 1px solid var(--border-subtle);
      background: #FAF9F6;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
    }

    .btn-cancel {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 13px;
      font-weight: 600;
      padding: 8px 14px;
      cursor: pointer;
    }

    /* Auto Translate Button */
    .btn-auto-trans {
      background: #D97706;
      color: #FFFFFF;
      border: none;
      padding: 7px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin-left: auto;
    }

    .btn-auto-trans:hover {
      background: #B45309;
    }

    /* Lang Tabs */
    .lang-tabs-bar {
      display: flex;
      border-bottom: 2px solid var(--border-subtle);
      gap: 6px;
    }

    .lang-tab-item {
      padding: 6px 12px;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
    }

    .lang-tab-item.active {
      color: var(--burgundy);
      border-bottom-color: var(--burgundy);
      font-weight: 700;
    }

    /* Toast */
    .toast-pill {
      position: fixed;
      bottom: 20px;
      right: 20px;
      left: 20px;
      z-index: 100;
      pointer-events: none;
      transition: all 0.25s ease;
      transform: translateY(80px);
      opacity: 0;
    }

    @media (min-width: 500px) {
      .toast-pill {
        left: auto;
        right: 20px;
        max-width: 320px;
      }
    }

    .toast-pill.active {
      transform: translateY(0);
      opacity: 1;
    }

    .toast-inner {
      background: var(--dark);
      color: #FFFFFF;
      border-radius: 12px;
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }
    /* ===== Ajustes móvil ===== */
    html, body { max-width: 100%; overflow-x: hidden; }
    .admin-container, .toolbar-card, .menu-card, #itemsList { min-width: 0; max-width: 100%; }
    .categories-strip { scrollbar-width: none; }
    .categories-strip::-webkit-scrollbar { display: none; }
    @media (max-width: 600px) {
      .admin-container { padding: 12px; }
      .toolbar-row { flex-wrap: nowrap; }
      .search-box { min-width: 0; }
      .btn-add-dish { padding: 9px 12px; }
      .btn-add-dish span { display: none; }
      .btn-sync { padding: 6px 10px; font-size: 11px; }
      .btn-logout span { display: none; }
      .dish-row { padding: 13px 14px; gap: 10px; }
      .dish-name { font-size: 18px; }
      .dish-price { font-size: 13px; padding: 4px 9px; }
      .dish-arrow { display: none; }
      .categories-strip { margin: 0 -14px; padding: 2px 14px; }
    }
  </style>
</head>
<body>

  <!-- ======================================================== -->
  <!-- 1. PANTALLA DE ACCESO (LOGIN) -->
  <!-- ======================================================== -->
  <div id="loginScreen" class="login-wrapper">
    <div class="login-card">
      
      <div style="display: flex; flex-direction: column; align-items: center;">
        <div class="login-logo-box">
          <img src="/assets/logos/logo-buon-appetito-white.png" alt="Buon Appetito">
        </div>
        <h2 class="login-heading">Gestión de Carta</h2>
        <p class="login-subhead">Acceso exclusivo para personal del restaurante</p>
      </div>

      <form id="loginForm" style="display: flex; flex-direction: column; gap: 14px;">
        <div class="form-group">
          <label class="form-label">Usuario</label>
          <input type="email" id="loginEmail" required value="buonappetitoandratx@gmail.com" class="form-input">
        </div>

        <div class="form-group">
          <label class="form-label">Contraseña</label>
          <input type="password" id="loginPassword" required placeholder="Introduce contraseña..." class="form-input">
          <p style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
            🔒 Clave predeterminada: <code style="font-weight: 700;">admin</code>
          </p>
        </div>

        <div id="loginError" class="login-error" style="display: none;">
          Credenciales incorrectas. Comprueba el usuario y la contraseña.
        </div>

        <button type="submit" class="btn-login" style="margin-top: 4px;">
          <span>Acceder</span>
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </form>

      <div style="border-top: 1px solid var(--border-subtle); padding-top: 10px; font-size: 11px; color: var(--text-light); display: flex; justify-content: space-between;">
        <span>Buon Appetito · Andratx</span>
        <a href="/" style="color: var(--burgundy); text-decoration: none; font-weight: 600;">Volver a la Web</a>
      </div>

    </div>
  </div>

  <!-- ======================================================== -->
  <!-- 2. PANEL PRINCIPAL (LIMPIO & COMPACTO) -->
  <!-- ======================================================== -->
  <div id="appShell" style="display: none; flex-direction: column; min-height: 100vh;">

    <!-- Header Principal Ultra-Limpio -->
    <header class="top-header">
      <div class="header-bar">
        
        <a href="/" class="header-logo-link" title="Ir a la web principal">
          <img src="/assets/logos/logo-buon-appetito-white.png" alt="Buon Appetito">
        </a>

        <div class="header-actions">
          <!-- Mini Botón de Sincronización Explícito -->
          <button id="btnSync" class="btn-sync synced" title="Comprobar y forzar sincronización con la base de datos">
            <svg id="syncIcon" width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            <span id="syncText">Sincronizado ✓</span>
          </button>

          <!-- Botón Salir -->
          <button id="btnLogout" class="btn-logout" title="Cerrar sesión">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            <span style="font-size: 11px;">Salir</span>
          </button>
        </div>

      </div>
    </header>

    <!-- Contenido -->
    <main class="admin-container">

      <!-- Barra de Herramientas -->
      <div class="toolbar-card">
        
        <div class="toolbar-row">
          
          <div class="search-box">
            <input type="text" id="searchInput" placeholder="Buscar plato o ingrediente..." class="search-input">
            <svg width="14" height="14" fill="none" stroke="#A8A29E" viewBox="0 0 24 24" style="position: absolute; left: 11px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>



          <button id="btnNewDish" class="btn-add-dish">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
            <span>Nuevo Plato</span>
          </button>

        </div>

        <!-- Píldoras de Categorías -->
        <div class="categories-strip no-scrollbar" id="categoriesBar">
          <!-- Populated by JS -->
        </div>

      </div>

      <!-- Tarjeta de Platos (Lista Compacta) -->
      <div class="menu-card">
        
        <div class="menu-header">
          <span class="menu-header-title">
            <span id="currentCategoryTitle">Todos los Platos</span>
            <span style="font-size: 11px; background: #E8E5DF; padding: 2px 7px; border-radius: 9999px; color: #57534E;" id="itemsCountBadge">0</span>
          </span>
          <a href="/carta" target="_blank" style="font-size: 11px; color: var(--burgundy); text-decoration: none; font-weight: 600;">Ver Carta Web ↗</a>
        </div>

        <div id="itemsList">
          <div style="padding: 32px; text-align: center; color: var(--text-muted); font-size: 13px;">Cargando carta...</div>
        </div>

      </div>

    </main>

    <!-- Toast de Feedback -->
    <div id="toast" class="toast-pill">
      <div class="toast-inner">
        <span id="toastIcon">✓</span>
        <span id="toastMsg">Cambio guardado</span>
      </div>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- 3. MODAL DE EDICIÓN / NUEVO PLATO -->
  <!-- ======================================================== -->
  <div id="dishModal" class="modal-overlay" style="display: none;">
    <div class="modal-window">
      
      <div class="modal-head">
        <span class="modal-title" id="modalHeading">Editar Plato</span>
        <button id="closeModalBtn" class="modal-close-btn">✕</button>
      </div>

      <form id="dishForm" class="modal-body-scroll">
        <input type="hidden" id="dishId">
        <input type="hidden" id="dishOrder">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label class="form-label">Categoría</label>
            <select id="dishCategory" required class="form-input"></select>
          </div>
          <div class="form-group">
            <label class="form-label">Precio (€)</label>
            <input type="number" step="0.05" id="dishPrice" required placeholder="0.00" class="form-input" style="font-weight: 700;">
          </div>
        </div>



        <!-- Pestañas de Idioma con Botón de Auto-traducción integrado -->
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
            <label class="form-label" style="margin-bottom: 0;">Traducciones</label>
            <button type="button" id="btnAutoTranslate" class="btn-auto-trans">
              <span id="transSpinner" style="display: none;">⏳</span>
              <span id="transText">✨ Auto-traducir</span>
            </button>
          </div>

          <div class="lang-tabs-bar">
            <button type="button" class="lang-tab-item active" data-lang="es">🇪🇸 Español</button>
            <button type="button" class="lang-tab-item" data-lang="en">🇬🇧 English</button>
            <button type="button" class="lang-tab-item" data-lang="de">🇩🇪 Deutsch</button>
          </div>

          <!-- Campos ES -->
          <div id="tabContent_es" style="display: flex; flex-direction: column; gap: 10px; padding-top: 10px;">
            <div class="form-group">
              <label class="form-label">Nombre (Español)</label>
              <input type="text" id="title_es" required placeholder="Ej: Bruschetta de Pan Tostado" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Descripción (Español)</label>
              <textarea id="desc_es" rows="2" placeholder="Ingredientes o descripción..." class="form-input"></textarea>
            </div>
          </div>

          <!-- Campos EN -->
          <div id="tabContent_en" style="display: none; flex-direction: column; gap: 10px; padding-top: 10px;">
            <div class="form-group">
              <label class="form-label">Name (English)</label>
              <input type="text" id="title_en" placeholder="Leave empty for Spanish fallback" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Description (English)</label>
              <textarea id="desc_en" rows="2" placeholder="Ingredients in English..." class="form-input"></textarea>
            </div>
          </div>

          <!-- Campos DE -->
          <div id="tabContent_de" style="display: none; flex-direction: column; gap: 10px; padding-top: 10px;">
            <div class="form-group">
              <label class="form-label">Name (Deutsch)</label>
              <input type="text" id="title_de" placeholder="Leer lassen für Spanisch als Fallback" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">Beschreibung (Deutsch)</label>
              <textarea id="desc_de" rows="2" placeholder="Zutaten auf Deutsch..." class="form-input"></textarea>
            </div>
          </div>
        </div>

        <div id="deleteContainer" style="display: none; border-top: 1px solid var(--border-subtle); padding-top: 10px;">
          <button type="button" id="btnDeleteDish" style="background: none; border: none; color: #DC2626; font-size: 12px; font-weight: 600; cursor: pointer;">
            🗑️ Eliminar plato de la carta
          </button>
        </div>

        <div class="modal-foot">
          <button type="button" id="btnCancelModal" class="btn-cancel">Cancelar</button>
          <button type="submit" id="btnSaveModal" class="btn-add-dish" style="padding: 10px 20px;">
            <span id="saveSpinner" style="display: none;">⏳</span>
            <span id="saveText">Guardar</span>
          </button>
        </div>

      </form>
    </div>
  </div>

  <!-- SCRIPT DE CONTROL -->
  <script is:inline type="module">
    import { createClient, createAdminClient } from 'https://esm.sh/@insforge/sdk@latest';

    const INSFORGE_URL = 'https://pz3qiueg.eu-central.insforge.app';
    const ANON_KEY = 'anon_64c904f7d36d64a81882dd8b41b193c03240d144f6de6a656b1d85ba0683ccec';
    const API_KEY = 'ik_7334a7a922b9b5b02262f3bce4c4cad8';

    const VALID_USER = 'buonappetitoandratx@gmail.com';
    const VALID_PASS = 'admin';

    const client = createClient({ baseUrl: INSFORGE_URL, anonKey: ANON_KEY });
    const adminClient = createAdminClient({ baseUrl: INSFORGE_URL, apiKey: API_KEY });

    let state = {
      isAuthenticated: false,
      categories: [],
      items: [],
      selectedCategory: 'all',
      searchQuery: '',
            activeModalLangTab: 'es',
      isSyncing: false
    };

    // DOM Elements - Login
    const loginScreen = document.getElementById('loginScreen');
    const loginForm = document.getElementById('loginForm');
    const loginEmail = document.getElementById('loginEmail');
    const loginPassword = document.getElementById('loginPassword');
    const loginError = document.getElementById('loginError');
    const appShell = document.getElementById('appShell');
    const btnLogout = document.getElementById('btnLogout');

    // DOM Elements - Header & Sync
    const btnSync = document.getElementById('btnSync');
    const syncIcon = document.getElementById('syncIcon');
    const syncText = document.getElementById('syncText');

    // DOM Elements - Admin Views
    const categoriesBar = document.getElementById('categoriesBar');
    const itemsList = document.getElementById('itemsList');
    const itemsCountBadge = document.getElementById('itemsCountBadge');
    const currentCategoryTitle = document.getElementById('currentCategoryTitle');
    const searchInput = document.getElementById('searchInput');
        const btnNewDish = document.getElementById('btnNewDish');
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toastMsg');
    const toastIcon = document.getElementById('toastIcon');

    // DOM Elements - Modal
    const dishModal = document.getElementById('dishModal');
    const dishForm = document.getElementById('dishForm');
    const modalHeading = document.getElementById('modalHeading');
    const dishId = document.getElementById('dishId');
    const dishOrder = document.getElementById('dishOrder');
    const dishCategory = document.getElementById('dishCategory');
    const dishPrice = document.getElementById('dishPrice');
        const title_es = document.getElementById('title_es');
    const desc_es = document.getElementById('desc_es');
    const title_en = document.getElementById('title_en');
    const desc_en = document.getElementById('desc_en');
    const title_de = document.getElementById('title_de');
    const desc_de = document.getElementById('desc_de');
    const btnAutoTranslate = document.getElementById('btnAutoTranslate');
    const transSpinner = document.getElementById('transSpinner');
    const transText = document.getElementById('transText');
    const deleteContainer = document.getElementById('deleteContainer');
    const btnDeleteDish = document.getElementById('btnDeleteDish');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const btnCancelModal = document.getElementById('btnCancelModal');
    const saveSpinner = document.getElementById('saveSpinner');
    const saveText = document.getElementById('saveText');

    // ========================================================
    // AUTENTICACIÓN
    // ========================================================
    function checkAuth() {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('demo') === '1' || localStorage.getItem('buon_appetito_auth') === 'true') {
        state.isAuthenticated = true;
        showApp();
      } else {
        showLogin();
      }
    }

    function showLogin() {
      loginScreen.style.display = 'flex';
      appShell.style.display = 'none';
    }

    function showApp() {
      loginScreen.style.display = 'none';
      appShell.style.display = 'flex';
      loadData();
    }

    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = loginEmail.value.trim().toLowerCase();
      const pass = loginPassword.value.trim();

      if (email === VALID_USER && pass === VALID_PASS) {
        loginError.style.display = 'none';
        localStorage.setItem('buon_appetito_auth', 'true');
        state.isAuthenticated = true;
        showApp();
      } else {
        loginError.style.display = 'block';
      }
    });

    btnLogout.addEventListener('click', () => {
      if (confirm('¿Cerrar sesión en el panel?')) {
        localStorage.removeItem('buon_appetito_auth');
        state.isAuthenticated = false;
        showLogin();
      }
    });

    // ========================================================
    // TOAST
    // ========================================================
    function showToast(message, isError = false) {
      toastMsg.textContent = message;
      toastIcon.textContent = isError ? '✕' : '✓';
      toast.classList.add('active');
      setTimeout(() => toast.classList.remove('active'), 2500);
    }

    // ========================================================
    // SINCRONIZACIÓN MANUAL / AUTOMÁTICA
    // ========================================================
    async function triggerSync() {
      if (state.isSyncing) return;
      state.isSyncing = true;

      btnSync.className = 'btn-sync syncing';
      syncIcon.classList.add('spin-icon');
      syncText.textContent = 'Sincronizando...';

      try {
        await loadData(false);
        btnSync.className = 'btn-sync synced';
        syncText.textContent = 'Sincronizado ✓';
        showToast('Todo sincronizado con éxito');
      } catch (e) {
        btnSync.className = 'btn-sync';
        syncText.textContent = 'Reintentar sync';
        showToast('Error de sincronización', true);
      } finally {
        syncIcon.classList.remove('spin-icon');
        state.isSyncing = false;
      }
    }

    btnSync.addEventListener('click', triggerSync);

    // ========================================================
    // CARGA DE DATOS
    // ========================================================
    async function loadData(showLoadingIndicator = true) {
      try {
        if (showLoadingIndicator) {
          btnSync.className = 'btn-sync syncing';
          syncIcon.classList.add('spin-icon');
          syncText.textContent = 'Cargando...';
        }

        const [catRes, itemRes] = await Promise.all([
          client.database.from('menu_categories').select().order('display_order', { ascending: true }),
          client.database.from('menu_items').select().order('display_order', { ascending: true })
        ]);

        if (catRes.error) throw catRes.error;
        if (itemRes.error) throw itemRes.error;

        state.categories = catRes.data || [];
        state.items = itemRes.data || [];

        populateCategorySelect();
        renderCategoriesBar();
        renderItems();

        btnSync.className = 'btn-sync synced';
        syncText.textContent = 'Sincronizado ✓';
      } catch (err) {
        console.error('Error cargando datos:', err);
        btnSync.className = 'btn-sync';
        syncText.textContent = 'Sin conexión';
        showToast('Error al conectar con la base de datos', true);
      } finally {
        syncIcon.classList.remove('spin-icon');
      }
    }

    function populateCategorySelect() {
      dishCategory.innerHTML = state.categories.map(c => `
        <option value="${c.id}">${c.name_es}</option>
      `).join('');
    }

    function renderCategoriesBar() {
      let html = `
        <button class="cat-btn ${state.selectedCategory === 'all' ? 'active' : ''}" data-cat="all">
          Todos (${state.items.length})
        </button>
      `;

      state.categories.forEach(cat => {
        const count = state.items.filter(i => i.category_id === cat.id).length;
        const active = state.selectedCategory === cat.id;
        html += `
          <button class="cat-btn ${active ? 'active' : ''}" data-cat="${cat.id}">
            ${cat.name_es} (${count})
          </button>
        `;
      });

      categoriesBar.innerHTML = html;

      categoriesBar.querySelectorAll('.cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.selectedCategory = btn.dataset.cat;
          renderCategoriesBar();
          renderItems();
        });
      });
    }

    function getFilteredItems() {
      return state.items.filter(item => {
        if (state.selectedCategory !== 'all' && item.category_id !== state.selectedCategory) return false;
        
        if (state.searchQuery) {
          const q = state.searchQuery.toLowerCase();
          const matchTitle = (item.title_es || '').toLowerCase().includes(q) ||
                             (item.title_en || '').toLowerCase().includes(q) ||
                             (item.title_de || '').toLowerCase().includes(q);
          const matchDesc = (item.description_es || '').toLowerCase().includes(q);
          if (!matchTitle && !matchDesc) return false;
        }
        return true;
      });
    }

    // ========================================================
    // RENDERIZADO DE PLATOS (LISTA EDITORIAL LIMPIA)
    // ========================================================
    function renderItems() {
      const filtered = getFilteredItems();
      itemsCountBadge.textContent = filtered.length;
      const currentCatObj = state.categories.find(c => c.id === state.selectedCategory);
      currentCategoryTitle.textContent = currentCatObj ? currentCatObj.name_es : 'La Carta';

      if (filtered.length === 0) {
        itemsList.innerHTML = `<div class="section-list" style="padding: 40px 20px; text-align: center; color: var(--text-muted); font-size: 13px;">No se ha encontrado ningún plato.</div>`;
        return;
      }

      const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      const row = (item, i) => `
        <div class="dish-row" data-id="${esc(item.id)}" style="animation-delay:${Math.min(i, 12) * 18}ms">
          <div class="dish-main">
            <span class="dish-name">${esc(item.title_es)}</span>
            ${item.description_es ? `<span class="dish-sub">${esc(item.description_es)}</span>` : `<span class="dish-sub empty">Sin descripción</span>`}
          </div>
          <div class="dish-meta">
            <span class="dish-price">${Number(item.price).toFixed(2).replace('.', ',')} €</span>
            <span class="dish-arrow"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
          </div>
        </div>`;

      const cats = state.selectedCategory === 'all' ? state.categories : state.categories.filter(c => c.id === state.selectedCategory);
      itemsList.innerHTML = cats.map(cat => {
        const list = filtered.filter(it => it.category_id === cat.id);
        if (!list.length) return '';
        return `
          <section class="menu-section">
            <div class="section-head">
              <span class="sec-name">${esc(cat.name_es)}</span>
              <span class="sec-line"></span>
              <span class="sec-count">${list.length}</span>
            </div>
            <div class="section-list">${list.map(row).join('')}</div>
          </section>`;
      }).join('');

      itemsList.querySelectorAll('.dish-row').forEach(r => {
        r.addEventListener('click', () => openEditModal(r.dataset.id));
      });
    }

    // ========================================================
    // MODAL
    // ========================================================
    function openEditModal(id) {
      const item = state.items.find(i => i.id === id);
      if (!item) return;

      dishId.value = item.id;
      dishOrder.value = item.display_order || 1;
      modalHeading.textContent = `Editar: ${item.title_es}`;
      
      dishCategory.value = item.category_id;
      dishPrice.value = item.price;
      
      title_es.value = item.title_es || '';
      desc_es.value = item.description_es || '';
      title_en.value = item.title_en || '';
      desc_en.value = item.description_en || '';
      title_de.value = item.title_de || '';
      desc_de.value = item.description_de || '';

      deleteContainer.style.display = 'block';
      switchModalLangTab('es');
      dishModal.style.display = 'flex';
    }

    function openNewDishModal() {
      dishId.value = '';
      dishOrder.value = state.items.length + 1;
      modalHeading.textContent = `Añadir Nuevo Plato`;
      
      dishCategory.value = state.selectedCategory !== 'all' ? state.selectedCategory : (state.categories[0]?.id || 'entrantes');
      dishPrice.value = '';
      
      title_es.value = '';
      desc_es.value = '';
      title_en.value = '';
      desc_en.value = '';
      title_de.value = '';
      desc_de.value = '';

      deleteContainer.style.display = 'none';
      switchModalLangTab('es');
      dishModal.style.display = 'flex';
      title_es.focus();
    }

    function closeDishModal() {
      dishModal.style.display = 'none';
    }

    function switchModalLangTab(lang) {
      state.activeModalLangTab = lang;
      document.querySelectorAll('.lang-tab-item').forEach(t => {
        t.classList.toggle('active', t.dataset.lang === lang);
      });

      document.getElementById('tabContent_es').style.display = lang === 'es' ? 'flex' : 'none';
      document.getElementById('tabContent_en').style.display = lang === 'en' ? 'flex' : 'none';
      document.getElementById('tabContent_de').style.display = lang === 'de' ? 'flex' : 'none';
    }

    document.querySelectorAll('.lang-tab-item').forEach(t => {
      t.addEventListener('click', () => switchModalLangTab(t.dataset.lang));
    });

    // Traducción
    async function translateText(text, targetLang) {
      if (!text || !text.trim()) return '';
      try {
        const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text.trim())}&langpair=es|${targetLang}`;
        const res = await fetch(url);
        const data = await res.json();
        if (data && data.responseData && data.responseData.translatedText) {
          const t = data.responseData.translatedText;
          if (!t.toUpperCase().includes('MYMEMORY WARNING')) return t;
        }
        return text;
      } catch (e) {
        return text;
      }
    }

    btnAutoTranslate.addEventListener('click', async () => {
      const esTitle = title_es.value.trim();
      const esDesc = desc_es.value.trim();

      if (!esTitle) {
        alert('Escribe el nombre en español primero.');
        title_es.focus();
        return;
      }

      transSpinner.style.display = 'inline';
      transText.textContent = 'Traduciendo...';
      btnAutoTranslate.disabled = true;

      try {
        const [enTitle, deTitle, enDesc, deDesc] = await Promise.all([
          translateText(esTitle, 'en'),
          translateText(esTitle, 'de'),
          esDesc ? translateText(esDesc, 'en') : Promise.resolve(''),
          esDesc ? translateText(esDesc, 'de') : Promise.resolve('')
        ]);

        title_en.value = enTitle;
        desc_en.value = enDesc;
        title_de.value = deTitle;
        desc_de.value = deDesc;

        showToast('Traducciones generadas');
        switchModalLangTab('en');
      } catch (err) {
        showToast('Error al traducir', true);
      } finally {
        transSpinner.style.display = 'none';
        transText.textContent = '✨ Auto-traducir';
        btnAutoTranslate.disabled = false;
      }
    });

    dishForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = dishId.value;
      const isNew = !id;
      const category_id = dishCategory.value;
      const price = parseFloat(dishPrice.value);
      const is_available = true;

      const t_es = title_es.value.trim();
      const d_es = desc_es.value.trim();
      const t_en = title_en.value.trim() || t_es;
      const d_en = desc_en.value.trim() || d_es;
      const t_de = title_de.value.trim() || t_es;
      const d_de = desc_de.value.trim() || d_es;

      saveSpinner.style.display = 'inline';
      saveText.textContent = 'Guardando...';

      try {
        if (isNew) {
          const itemCode = `${category_id}-${String(state.items.length + 1).padStart(2, '0')}`;
          const newPayload = {
            id: itemCode,
            category_id,
            item_code: itemCode,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            is_available,
            display_order: parseInt(dishOrder.value) || state.items.length + 1
          };

          const { data, error } = await adminClient.database
            .from('menu_items')
            .insert([newPayload])
            .select();

          if (error) throw error;
          if (data && data[0]) state.items.push(data[0]);
          showToast('Plato añadido a la carta');
        } else {
          const updatePayload = {
            category_id,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            is_available,
            updated_at: new Date().toISOString()
          };

          const { error } = await adminClient.database
            .from('menu_items')
            .update(updatePayload)
            .eq('id', id);

          if (error) throw error;

          const item = state.items.find(i => i.id === id);
          if (item) Object.assign(item, updatePayload);
          showToast('Plato guardado');
        }

        closeDishModal();
        renderCategoriesBar();
        renderItems();
        btnSync.className = 'btn-sync synced';
        syncText.textContent = 'Sincronizado ✓';
      } catch (err) {
        console.error('Error guardando plato:', err);
        showToast('Error al guardar plato', true);
      } finally {
        saveSpinner.style.display = 'none';
        saveText.textContent = 'Guardar';
      }
    });

    btnDeleteDish.addEventListener('click', async () => {
      const id = dishId.value;
      if (!id) return;

      const item = state.items.find(i => i.id === id);
      if (!confirm(`¿Eliminar "${item?.title_es || 'este plato'}" de la carta?`)) return;

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .delete()
          .eq('id', id);

        if (error) throw error;

        state.items = state.items.filter(i => i.id !== id);
        closeDishModal();
        renderCategoriesBar();
        renderItems();
        showToast('Plato eliminado');
      } catch (err) {
        showToast('Error al eliminar', true);
      }
    });

    btnNewDish.addEventListener('click', openNewDishModal);
    closeModalBtn.addEventListener('click', closeDishModal);
    btnCancelModal.addEventListener('click', closeDishModal);
    dishModal.addEventListener('click', (e) => {
      if (e.target === dishModal) closeDishModal();
    });

    searchInput.addEventListener('input', (e) => {
      state.searchQuery = e.target.value.trim();
      renderItems();
    });

    
    checkAuth();
  </script>
</body>
</html>
