      align-items: center;
      justify-content: space-between;
    }
    .modal-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-main);
    }

    /* Mini Mockups Ilustrativos de Instalación PWA */
    .pwa-step-card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
    }
    .pwa-step-badge {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--brand-primary);
      color: #FFFFFF;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .pwa-mockup-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: #EFF6FF;
      border: 1px solid #BFDBFE;
      color: #2563EB;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 800;
      flex-shrink: 0;
    }

    /* Logs Sheet */
    .logs-sheet {
      width: 100%;
      max-width: 520px;
      max-height: 85vh;
      background: #FFFFFF;
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: var(--shadow-float);
      margin: auto 16px;
    }
    .logs-head {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-subtle);
