    /* Sticky Bottom Actions */
    .studio-foot {
      padding: 12px 18px calc(14px + var(--safe-bottom));
      border-top: 1px solid var(--border-subtle);
      background: #FFFFFF;
      flex-shrink: 0;
    }
    .btn-studio-save-main {
      width: 100%;
      height: 48px;
      background: var(--brand-primary);
      color: #FFFFFF;
      border: none;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(24, 51, 33, 0.3);
      transition: transform 0.15s;
    }
    .btn-studio-save-main:active { transform: scale(0.98); }

    /* ========================================================
       9. PANTALLA COMPLETA DE AJUSTES & GERENCIA (100DVH)
       ======================================================== */
    .profile-drawer-overlay {
      position: fixed;
      inset: 0;
      z-index: 120;
      background: rgba(15, 23, 42, 0.5);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .profile-drawer-sheet {
      width: 100%;
      height: 100vh;
      height: 100dvh;
      max-height: 100dvh;
      background: #F8FAFC;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      animation: slideUpSheet 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @media (min-width: 769px) {
      .profile-drawer-overlay {
        justify-content: flex-end;
      }
      .profile-drawer-sheet {
        max-width: 480px;
        border-radius: 20px 0 0 20px;
      }
    }

    .drawer-header {
      padding: calc(14px + var(--safe-top)) 18px 14px;
      background: linear-gradient(135deg, #183321 0%, #112518 100%);
      color: #FAF8F5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(197, 168, 128, 0.3);
      flex-shrink: 0;
    }
    .drawer-user-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .drawer-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #C5A880;
      color: #183321;
      font-size: 15px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-close-btn-white {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.25);
