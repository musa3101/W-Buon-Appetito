    // ========================================================
    // AUDITORÍA / HISTORIAL CON FECHA Y HORA EXACTA
    // ========================================================
    const LOGS_KEY = 'buon_admin_logs';
    function getLogs() {
      try { return JSON.parse(localStorage.getItem(LOGS_KEY)) || []; }
      catch { return []; }
    }
    async function logAction(action, item_id, item_title, details = '') {
      const logs = getLogs();
      const newEntry = { 
        id: Date.now(), 
        action, 
        item_id, 
        item_title, 
        details, 
        timestamp: new Date().toISOString() 
      };
      logs.unshift(newEntry);
      localStorage.setItem(LOGS_KEY, JSON.stringify(logs.slice(0, 50)));

      // Registro en InsForge (en segundo plano si aplica)
      try {
        adminClient.database.from('audit_logs').insert([{
          action,
          item_id,
          item_title,
          details,
          created_at: newEntry.timestamp
        }]).then(() => {}).catch(() => {});
      } catch (e) {}
    }

    function describeChanges(before, after) {
      const changes = [];
      if (before.price !== after.price) changes.push(`Precio: ${fmtEUR(before.price)} → ${fmtEUR(after.price)}`);
      if (before.is_available !== after.is_available) changes.push(after.is_available ? 'Marcado disponible' : 'Marcado agotado');
      if (before.category_id !== after.category_id) changes.push(`Categoría cambiada`);
      if (before.title_es !== after.title_es) changes.push('Nombre modificado');
      return changes;
    }

    function formatFullDate(isoString) {
      try {
        const d = new Date(isoString);
        const dateStr = d.toLocaleDateString('es-ES', { 
          day: 'numeric', 
          month: 'short', 
          year: 'numeric' 
        });
        const timeStr = d.toLocaleTimeString('es-ES', { 
          hour: '2-digit', 
          minute: '2-digit', 
          second: '2-digit' 
        });
        return `${dateStr} · ${timeStr}`;
      } catch {
        return isoString;
      }
    }

    function closeLogsModal() {
      unlockBackgroundScroll();
      logsModal.style.display = 'none';
    }

    async function openLogs() {
      closeProfileDrawer();
      const list = getLogs();
      const logsList = document.getElementById('logsList');
      if (!list.length) {
        logsList.innerHTML = '<div style="padding: 32px 16px; text-align: center; color: var(--text-muted); font-size: 13px;">No hay cambios registrados todavía en esta sesión.</div>';
      } else {
        logsList.innerHTML = list.map(l => {
          let badgeColor = '#2563EB';
          let badgeBg = '#EFF6FF';
          let badgeText = 'Modificación';

          if (l.action === 'create') {
            badgeColor = '#059669';
            badgeBg = '#ECFDF5';
            badgeText = 'Nuevo Plato';
          } else if (l.action === 'delete') {
            badgeColor = '#DC2626';
            badgeBg = '#FEF2F2';
            badgeText = 'Eliminado';
          } else if (l.action === 'availability') {
            badgeColor = '#D97706';
            badgeBg = '#FFFBEB';
            badgeText = 'Disponibilidad';
          }

          return `
            <div style="background: #FFFFFF; border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; box-shadow: var(--shadow-card);">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                <span style="font-weight: 700; font-size: 14px; color: var(--text-main);">${l.item_title || 'Elemento'}</span>
                <span style="font-size: 10px; font-weight: 700; color: ${badgeColor}; background: ${badgeBg}; padding: 2px 8px; border-radius: 999px;">${badgeText}</span>
              </div>
              <div style="color: var(--text-muted); font-size: 12.5px; margin: 4px 0 6px;">${l.details || l.action}</div>
              <div style="font-size: 11px; font-weight: 600; color: var(--text-subtle); display: flex; align-items: center; gap: 4px;">
                <span>🕒</span>
                <span>${formatFullDate(l.timestamp)}</span>
              </div>
            </div>
          `;
        }).join('');
      }
      lockBackgroundScroll();
      logsModal.style.display = 'flex';
    }
    if (btnOpenLogsFromDrawer) btnOpenLogsFromDrawer.addEventListener('click', openLogs);
    const closeLogsBtn = document.getElementById('closeLogsBtn');
    if (closeLogsBtn) closeLogsBtn.addEventListener('click', closeLogsModal);

    // Toast
    let toastTimeout;
    function showToast(message, isError = false) {
      clearTimeout(toastTimeout);
      toastMsg.textContent = message;
      toastIcon.textContent = isError ? '✕' : '✓';
      toast.classList.toggle('error', isError);
      toast.classList.add('show');
      toastTimeout = setTimeout(() => toast.classList.remove('show'), 2500);
    }

    // Sincronización Web
    async function triggerSync() {
      if (state.isSyncing) return;
      state.isSyncing = true;
      btnSync.classList.add('syncing');
      syncText.textContent = 'Actualizando...';

      try {
        await loadData(false);
        showToast('Carta web sincronizada');
        syncText.textContent = 'En línea';
      } catch (err) {
        showToast('Error al sincronizar', true);
        syncText.textContent = 'Error';
      } finally {
        state.isSyncing = false;
        btnSync.classList.remove('syncing');
      }
    }
    btnSync.addEventListener('click', triggerSync);

    // ========================================================
    // CARGA DE DATOS & RENDERIZADO
    // ========================================================
    const fmtEUR = n => (Number(n) || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

    async function loadData(showLoadingIndicator = true) {
      if (showLoadingIndicator) {
        itemsList.innerHTML = '<div style="padding: 40px; text-align: center; color: var(--text-muted); font-size: 13.5px;">Cargando carta...</div>';
      }

      try {
        const [catsRes, itemsRes] = await Promise.all([
          client.database.from('menu_categories').select().order('display_order', { ascending: true }),
          client.database.from('menu_items').select().order('display_order', { ascending: true })
        ]);

        if (catsRes.error) throw catsRes.error;
        if (itemsRes.error) throw itemsRes.error;

        state.categories = catsRes.data || [];
        state.items = itemsRes.data || [];

        updateBadges();
        renderCategoriesBar();
        renderItems();
      } catch (err) {
        console.error('Error cargando carta:', err);
        itemsList.innerHTML = '<div style="padding: 40px; text-align: center; color: #DC2626; font-size: 13.5px;">Error al conectar con la base de datos. Pulsa en En línea para reintentar.</div>';
      }
    }

    function renderCategoriesBar() {
      const typeCats = getCurrentTypeCategories();
      const allItemCount = state.items.filter(i => {
        let allowed = FOOD_CATEGORIES;
        if (state.currentMenuType === 'bebidas') allowed = DRINK_CATEGORIES;
        else if (state.currentMenuType === 'vinos') allowed = WINE_CATEGORIES;
        return allowed.includes(i.category_id);
      }).length;

      let html = `
        <button type="button" class="cat-chip ${state.selectedCategory === 'all' ? 'active' : ''}" data-cat="all">
          <span>Todos</span>
          <span class="cat-chip-count">(${allItemCount})</span>
        </button>
      `;

      typeCats.forEach(cat => {
        const count = state.items.filter(i => i.category_id === cat.id).length;
        html += `
          <button type="button" class="cat-chip ${state.selectedCategory === cat.id ? 'active' : ''}" data-cat="${cat.id}">
            <span>${cat.name_es}</span>
            <span class="cat-chip-count">(${count})</span>
          </button>
        `;
      });

      categoriesBar.innerHTML = html;

      categoriesBar.querySelectorAll('.cat-chip').forEach(btn => {
        btn.addEventListener('click', () => {
          state.selectedCategory = btn.dataset.cat;
          renderCategoriesBar();
          renderItems();
        });
      });
    }

    function getFilteredItems() {
      let allowed = FOOD_CATEGORIES;
      if (state.currentMenuType === 'bebidas') allowed = DRINK_CATEGORIES;
      else if (state.currentMenuType === 'vinos') allowed = WINE_CATEGORIES;

      return state.items.filter(item => {
        if (!allowed.includes(item.category_id)) return false;
        if (state.selectedCategory !== 'all' && item.category_id !== state.selectedCategory) return false;
        if (state.searchQuery) {
          const q = state.searchQuery.toLowerCase();
          const matchTitle = (item.title_es || '').toLowerCase().includes(q) ||
                             (item.title_en || '').toLowerCase().includes(q) ||
                             (item.title_de || '').toLowerCase().includes(q);
          const matchDesc = (item.description_es || '').toLowerCase().includes(q);
          if (!matchTitle && !matchDesc) return false;
        }
        return true;
      });
    }

    function updateKpiCounts() {
      let allowed = FOOD_CATEGORIES;
      if (state.currentMenuType === 'bebidas') allowed = DRINK_CATEGORIES;
      else if (state.currentMenuType === 'vinos') allowed = WINE_CATEGORIES;

      const currentTypeItems = state.items.filter(i => allowed.includes(i.category_id));
      const active = currentTypeItems.filter(i => i.is_available !== false).length;
      const out = currentTypeItems.length - active;

      if (kpiActiveCount) kpiActiveCount.textContent = active;
      if (kpiOutCount) kpiOutCount.textContent = out;
    }

    function renderItems() {
      const filtered = getFilteredItems();
      itemsCountBadge.textContent = filtered.length;
      updateKpiCounts();

      const typeCats = getCurrentTypeCategories();
      const currentCatObj = typeCats.find(c => c.id === state.selectedCategory);

      if (state.selectedCategory !== 'all' && currentCatObj) {
        currentCategoryTitle.textContent = currentCatObj.name_es;
      } else {
        if (state.currentMenuType === 'comida') currentCategoryTitle.textContent = 'Carta de Comida';
        else if (state.currentMenuType === 'bebidas') currentCategoryTitle.textContent = 'Carta de Bebidas';
        else if (state.currentMenuType === 'vinos') currentCategoryTitle.textContent = 'Carta de Vinos · Bodega';
      }

      if (filtered.length === 0) {
        itemsList.innerHTML = `
          <div style="background: #FFFFFF; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 48px 20px; text-align: center; color: var(--text-muted); display: flex; flex-direction: column; align-items: center; gap: 10px;">
            <p style="font-size: 14px; font-weight: 700; color: var(--text-main);">No hay elementos en esta sección</p>
            <p style="font-size: 12.5px;">Prueba a cambiar el filtro o pulsa en Añadir para registrar un nuevo plato, bebida o vino.</p>
          </div>`;
        return;
      }

      const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      
      // TARJETA LIMPIA: SIN BOTÓN DE ACTIVO EN LA LISTA PRINCIPAL
      const row = (item) => {
        const isAvailable = item.is_available !== false;
        const catObj = state.categories.find(c => c.id === item.category_id);
        const catName = catObj ? catObj.name_es : item.category_id;

        return `
          <div class="dish-row ${!isAvailable ? 'out-of-stock' : ''}" data-id="${esc(item.id)}">
            <div class="dish-content">
              <div class="dish-top-row">
                <span class="dish-name">${esc(item.title_es)}</span>
                <span class="dish-price">${fmtEUR(item.price)}</span>
              </div>
              ${item.description_es ? `<p class="dish-desc">${esc(item.description_es)}</p>` : ''}
              <div class="dish-meta-row">
                <span>${esc(catName)}</span>
                ${!isAvailable ? '<span>•</span><span class="dish-badge-status out">○ Fuera de carta</span>' : ''}
              </div>
            </div>
            <div class="dish-row-arrow">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </div>`;
      };

      let catsToRender = state.selectedCategory === 'all' 
        ? typeCats 
        : typeCats.filter(c => c.id === state.selectedCategory);

      if (!catsToRender.length) {
        const uniqueCatIds = [...new Set(filtered.map(i => i.category_id))];
        catsToRender = uniqueCatIds.map(id => state.categories.find(c => c.id === id) || { id, name_es: id });
      }

      itemsList.innerHTML = catsToRender.map(cat => {
        const list = filtered.filter(it => it.category_id === cat.id);
        if (!list.length) return '';
        return `
          <section class="menu-section">
            <div class="section-head">
              <span class="sec-name">${esc(cat.name_es)}</span>
              <span class="sec-line"></span>
              <span class="sec-count">${list.length}</span>
            </div>
            <div class="section-list">${list.map(row).join('')}</div>
          </section>`;
      }).join('');

      // Click en cualquier fila para abrir el modal de edición
      itemsList.querySelectorAll('.dish-row').forEach(r => {
        r.addEventListener('click', () => openEditModal(r.dataset.id));
      });
    }

    // ========================================================
    // MODAL DE EDICIÓN & BOTTOM SHEET (SELECTOR MULTICARTA)
    // ========================================================
    function updateStockBadge(isAvailable) {
      if (isAvailable) {
        stockStatusBadge.textContent = 'Disponible en cocina';
        stockStatusBadge.style.color = 'var(--emerald-text)';
        stockExplainer.textContent = 'Visible y disponible para comandas en cocina.';
      } else {
        stockStatusBadge.textContent = 'Marcado como Agotado';
        stockStatusBadge.style.color = 'var(--amber-text)';
        stockExplainer.textContent = 'Oculto o bloqueado para evitar pedidos en cocina.';
      }
    }

    dishAvailableCheck.addEventListener('change', (e) => {
      updateStockBadge(e.target.checked);
    });

    function getMenuTypeForCategory(catId) {
      if (DRINK_CATEGORIES.includes(catId)) return 'bebidas';
      if (WINE_CATEGORIES.includes(catId)) return 'vinos';
      return 'comida';
    }

    function renderModalCategoryChips(selectedId, menuType) {
      state.currentModalTargetType = menuType;
      
      // Actualizar pestañas de carta dentro del modal
      document.querySelectorAll('#modalMenuTypeTabs .modal-type-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.targetType === menuType);
      });

      const typeCats = getCurrentTypeCategories(menuType);
      let activeCat = typeCats.find(c => c.id === selectedId);
      if (!activeCat && typeCats.length) {
        activeCat = typeCats[0];
        selectedId = activeCat.id;
      }
      
      if (activeCategoryName && activeCat) {
        activeCategoryName.textContent = activeCat.name_es;
      }
      dishCategory.value = selectedId;

      categoryChipsGrid.innerHTML = typeCats.map(cat => {
        const isSel = cat.id === selectedId;
        return `
          <button type="button" class="modal-cat-chip ${isSel ? 'active' : ''}" data-cat-id="${cat.id}">
            ${cat.name_es}
          </button>
        `;
      }).join('');

      categoryChipsGrid.querySelectorAll('.modal-cat-chip').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.dataset.catId;
          dishCategory.value = targetId;
          const found = typeCats.find(c => c.id === targetId);
          if (activeCategoryName && found) activeCategoryName.textContent = found.name_es;
          categoryChipsGrid.querySelectorAll('.modal-cat-chip').forEach(b => {
            b.classList.toggle('active', b.dataset.catId === targetId);
          });
        });
      });
    }

    // Eventos de cambio de tipo de carta dentro del modal
    document.querySelectorAll('#modalMenuTypeTabs .modal-type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetType = btn.dataset.targetType;
        renderModalCategoryChips(null, targetType);
      });
    });

    function openEditModal(id) {
      const item = state.items.find(i => i.id === id);
      if (!item) return;

      dishId.value = item.id;
      dishOrder.value = item.display_order || 1;
      modalHeading.textContent = 'Editar Ficha';
      
      dishPrice.value = item.price !== undefined ? item.price : '';
      dishImageUrl.value = item.image_url || '';
      dishImageFile.value = '';

      const isAvail = item.is_available !== false;
      dishAvailableCheck.checked = isAvail;
      updateStockBadge(isAvail);

      const itemMenuType = getMenuTypeForCategory(item.category_id);
      renderModalCategoryChips(item.category_id, itemMenuType);

      title_es.value = item.title_es || '';
      desc_es.value = item.description_es || '';
      title_en.value = item.title_en || '';
      desc_en.value = item.description_en || '';
      title_de.value = item.title_de || '';
      desc_de.value = item.description_de || '';

      deleteContainer.style.display = 'block';
      switchModalLangTab('es');
      lockBackgroundScroll();
      dishModal.style.display = 'flex';
      dishForm.scrollTop = 0;
    }

    function openNewDishModal() {
      dishId.value = '';
      dishOrder.value = state.items.length + 1;
      modalHeading.textContent = 'Añadir a la Carta';

      const initialType = state.currentMenuType; // Hereda la carta actual (comida, bebidas o vinos)
      dishPrice.value = '';
      dishImageUrl.value = '';
      dishImageFile.value = '';

      dishAvailableCheck.checked = true;
      updateStockBadge(true);
      renderModalCategoryChips(null, initialType);

      title_es.value = '';
      desc_es.value = '';
      title_en.value = '';
      desc_en.value = '';
      title_de.value = '';
      desc_de.value = '';

      deleteContainer.style.display = 'none';
      switchModalLangTab('es');
      lockBackgroundScroll();
      dishModal.style.display = 'flex';
      dishForm.scrollTop = 0;
    }

    function closeDishModal() {
      unlockBackgroundScroll();
      dishModal.style.display = 'none';
    }

    function switchModalLangTab(lang) {
      state.activeModalLangTab = lang;
      document.querySelectorAll('.studio-lang-tab').forEach(b => {
        b.classList.toggle('active', b.dataset.lang === lang);
      });
      document.getElementById('tabContent_es').style.display = lang === 'es' ? 'block' : 'none';
      document.getElementById('tabContent_en').style.display = lang === 'en' ? 'block' : 'none';
      document.getElementById('tabContent_de').style.display = lang === 'de' ? 'block' : 'none';
    }

    document.querySelectorAll('.studio-lang-tab').forEach(b => {
      b.addEventListener('click', () => switchModalLangTab(b.dataset.lang));
    });

    // Incrementos Rápidos de Precio
    document.querySelectorAll('.btn-q-price[data-add]').forEach(btn => {
      btn.addEventListener('click', () => {
        const add = parseFloat(btn.dataset.add) || 0;
        let curr = parseFloat(dishPrice.value) || 0;
        dishPrice.value = (curr + add).toFixed(2);
      });
    });

    if (btnRoundPrice) {
      btnRoundPrice.addEventListener('click', () => {
        let curr = parseFloat(dishPrice.value) || 0;
        dishPrice.value = Math.round(curr).toFixed(2);
      });
    }

    // Traducción IA
    async function translateText(text, targetLang) {
      if (!text || !text.trim()) return '';
      try {
        const langMap = { en: 'en', de: 'de', es: 'es' };
        const tgt = langMap[targetLang] || targetLang;
        const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=es&tl=${tgt}&dt=t&q=${encodeURIComponent(text.trim())}`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        if (Array.isArray(data) && Array.isArray(data[0])) {
          return data[0].map(s => s[0]).join('').trim();
        }
      } catch (err) {
        console.warn('Fallo traducción:', err);
      }
      return text;
    }

    btnAutoTranslate.addEventListener('click', async () => {
      const srcTitle = title_es.value.trim();
      const srcDesc = desc_es.value.trim();

      if (!srcTitle && !srcDesc) {
        showToast('Escribe primero el nombre en español', true);
        title_es.focus();
        return;
      }

      transSpinner.style.display = 'inline-block';
      transText.textContent = 'Traduciendo...';
      btnAutoTranslate.disabled = true;

      try {
        const [enTitle, enDesc, deTitle, deDesc] = await Promise.all([
          translateText(srcTitle, 'en'),
          translateText(srcDesc, 'en'),
          translateText(srcTitle, 'de'),
          translateText(srcDesc, 'de')
        ]);

        if (enTitle) title_en.value = enTitle;
        if (enDesc) desc_en.value = enDesc;
        if (deTitle) title_de.value = deTitle;
        if (deDesc) desc_de.value = deDesc;

        showToast('Traducción completada con éxito');
      } catch (err) {
        showToast('Error en la traducción automática', true);
      } finally {
        transSpinner.style.display = 'none';
        transText.textContent = '✨ Auto-traducir (IA)';
        btnAutoTranslate.disabled = false;
      }
    });

    // Guardado de Plato / Bebida / Vino
    dishForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = dishId.value;
      const t_es = title_es.value.trim();
      const d_es = desc_es.value.trim();
      const t_en = title_en.value.trim();
      const d_en = desc_en.value.trim();
      const t_de = title_de.value.trim();
      const d_de = desc_de.value.trim();
      const price = parseFloat(dishPrice.value);
      const category_id = dishCategory.value;
      const is_available = dishAvailableCheck.checked;
      const image_url = dishImageUrl.value.trim();

      if (!t_es) {
        showToast('El nombre en español es obligatorio', true);
        return;
      }
      if (isNaN(price) || price < 0) {
        showToast('Introduce un precio válido', true);
        return;
      }

      saveSpinner.style.display = 'inline-block';
      saveText.textContent = 'Guardando...';

      try {
        if (!id) {
          const newPayload = {
            id: 'item_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
            category_id,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            image_url,
            is_available,
            display_order: parseInt(dishOrder.value) || state.items.length + 1,
            created_at: new Date().toISOString(),
            updated_at: new Date().toISOString()
          };

          const { data, error } = await adminClient.database
            .from('menu_items')
            .insert([newPayload])
            .select();

          if (error) throw error;
          if (data && data[0]) state.items.push(data[0]);
          logAction('create', newPayload.id, t_es, `${fmtEUR(price)} · ${(state.categories.find(c => c.id === category_id) || {}).name_es || category_id}`);
          showToast('Elemento añadido a la carta');
        } else {
          const updatePayload = {
            category_id,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            image_url,
            is_available,
            updated_at: new Date().toISOString()
          };

          const { error } = await adminClient.database
            .from('menu_items')
            .update(updatePayload)
            .eq('id', id);

          if (error) throw error;

          const item = state.items.find(i => i.id === id);
          if (item) {
            const changes = describeChanges(item, updatePayload);
            if (changes.length) {
              const onlyPrice = changes.length === 1 && changes[0].startsWith('Precio');
              logAction(onlyPrice ? 'price' : 'update', id, t_es, changes.join(' · '));
            }
            Object.assign(item, updatePayload);
          }
          showToast('Guardado con éxito');
        }

        closeDishModal();
        updateBadges();
        renderCategoriesBar();
        renderItems();
      } catch (err) {
        console.error('Error guardando:', err);
        showToast('Error al guardar datos', true);
      } finally {
        saveSpinner.style.display = 'none';
        saveText.textContent = 'Guardar en Carta';
      }
    });

    btnDeleteDish.addEventListener('click', async () => {
      const id = dishId.value;
      if (!id) return;

      const item = state.items.find(i => i.id === id);
      if (!confirm(`¿Eliminar "${item?.title_es || 'este elemento'}" de la carta?`)) return;

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .delete()
          .eq('id', id);

        if (error) throw error;

        logAction('delete', id, item?.title_es || id, item ? fmtEUR(item.price) : '');
        state.items = state.items.filter(i => i.id !== id);
        closeDishModal();
        updateBadges();
        renderCategoriesBar();
        renderItems();
        showToast('Eliminado de la carta');
      } catch (err) {
        showToast('Error al eliminar', true);
      }
    });

    btnNewDish.addEventListener('click', openNewDishModal);
    if (btnFabNewDish) btnFabNewDish.addEventListener('click', openNewDishModal);
    if (closeModalBtn) closeModalBtn.addEventListener('click', closeDishModal);
    dishModal.addEventListener('click', (e) => {
      if (e.target === dishModal) closeDishModal();
    });

    searchInput.addEventListener('input', (e) => {
      state.searchQuery = e.target.value.trim();
      renderItems();
    });

    // Tecla Escape para cerrar modales
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (dishModal.style.display === 'flex') closeDishModal();
        else if (securityModal.style.display === 'flex') closeSecurityModal();
        else if (pwaModal.style.display === 'flex') closePwaModal();
        else if (logsModal.style.display === 'flex') closeLogsModal();
        else if (profileDrawer.style.display === 'flex') closeProfileDrawer();
      }
    });

    // Iniciar verificación de sesión
    checkAuth();
  </script>
</body>
</html>
