---
// Página de Administración Privada de Carta - Buon Appetito
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Buon Appetito · Panel de Carta</title>
  <meta name="robots" content="noindex, nofollow">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              cream: '#FAF7F2',
              surface: '#FFFFFF',
              dark: '#171513',
              charcoal: '#221E1C',
              burgundy: '#7A1C28',
              burgundyHover: '#60141E',
              gold: '#C5A880',
              goldLight: '#E8DCC9',
              border: 'rgba(28, 25, 23, 0.08)',
              borderDark: 'rgba(255, 255, 255, 0.10)',
              muted: '#78716C'
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif']
          },
          boxShadow: {
            'card': '0 2px 10px rgba(28, 25, 23, 0.04), 0 1px 3px rgba(28, 25, 23, 0.02)',
            'card-hover': '0 10px 25px -5px rgba(28, 25, 23, 0.08), 0 8px 10px -6px rgba(28, 25, 23, 0.04)',
            'sheet': '0 -10px 40px rgba(0, 0, 0, 0.25)'
          }
        }
      }
    }
  </script>
  <style>
    body { background-color: #FAF7F2; color: #171513; font-family: 'Plus Jakarta Sans', sans-serif; -webkit-tap-highlight-color: transparent; }
    .font-cormorant { font-family: 'Cormorant Garamond', serif; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    button, input, select, textarea { touch-action: manipulation; }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- ======================================================== -->
  <!-- 1. PANTALLA DE ACCESO (LOGIN EXCLUSIVO) -->
  <!-- ======================================================== -->
  <div id="loginScreen" class="fixed inset-0 z-50 bg-[#FAF7F2] flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-3xl border border-brand-border shadow-2xl overflow-hidden p-6 sm:p-10 text-center space-y-6">
      
      <!-- Brand Logo -->
      <div class="flex flex-col items-center justify-center space-y-2">
        <div class="p-3 rounded-2xl bg-[#171513] shadow-md inline-block">
          <img src="/assets/logos/logo-buon-appetito-white.png" alt="Buon Appetito" class="h-10 sm:h-12 w-auto object-contain">
        </div>
        <div class="pt-2">
          <span class="text-[10px] uppercase tracking-[0.25em] text-brand-gold font-bold block">Port d'Andratx · Mallorca</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#171513] mt-1">Gestión de Carta</h2>
          <p class="text-xs text-stone-500 mt-1">Acceso privado para el personal del restaurante</p>
        </div>
      </div>

      <!-- Login Form -->
      <form id="loginForm" class="space-y-4 text-left">
        <div>
          <label class="block text-xs font-semibold text-stone-700 mb-1.5">Usuario o Correo Electrónico</label>
          <div class="relative">
            <input type="email" id="loginEmail" required value="buonappetitoandratx@gmail.com" class="w-full text-xs sm:text-sm px-3.5 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-burgundy/20 focus:border-brand-burgundy transition-all text-stone-800 font-medium">
            <svg class="w-4 h-4 text-stone-400 absolute right-3.5 top-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206"></path></svg>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-stone-700 mb-1.5">Contraseña</label>
          <div class="relative">
            <input type="password" id="loginPassword" required placeholder="Introduce contraseña..." class="w-full text-xs sm:text-sm px-3.5 py-3 bg-stone-50 border border-stone-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-burgundy/20 focus:border-brand-burgundy transition-all text-stone-800 font-medium">
            <button type="button" id="togglePasswordBtn" class="absolute right-3.5 top-3 text-stone-400 hover:text-stone-600 text-xs">👁️</button>
          </div>
          <p class="text-[11px] text-stone-400 mt-1.5 flex items-center gap-1">
            <span>🔒</span> Clave predeterminada: <code class="bg-stone-100 text-stone-600 px-1.5 py-0.5 rounded font-mono text-[10px]">admin</code>
          </p>
        </div>

        <div id="loginError" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 font-medium text-center">
          Credenciales incorrectas. Comprueba el usuario y la contraseña.
        </div>

        <button type="submit" id="loginSubmitBtn" class="w-full py-3.5 px-4 bg-brand-burgundy hover:bg-brand-burgundyHover text-white rounded-xl text-xs sm:text-sm font-bold tracking-wide shadow-lg hover:shadow-xl active:scale-[0.98] transition-all flex items-center justify-center gap-2">
          <span>Acceder al Panel</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </form>

      <div class="pt-2 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
        <span>Buon Appetito · Puerto de Andratx</span>
        <a href="/" class="text-brand-burgundy hover:underline">Volver a la Web</a>
      </div>

    </div>
  </div>

  <!-- ======================================================== -->
  <!-- 2. APLICACIÓN PRINCIPAL (PANEL DE GESTIÓN) -->
  <!-- ======================================================== -->
  <div id="appShell" class="hidden flex-1 flex flex-col">

    <!-- Header Principal -->
    <header class="bg-[#171513] text-white border-b border-brand-borderDark sticky top-0 z-40 shadow-md">
      <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-2.5 sm:py-3 flex items-center justify-between gap-3">
        
        <!-- Logo & Brand Info -->
        <div class="flex items-center gap-3 min-w-0">
          <a href="/" title="Ir a la web principal">
            <img src="/assets/logos/logo-buon-appetito-white.png" alt="Buon Appetito" class="h-8 sm:h-9 w-auto object-contain shrink-0">
          </a>
          <div class="border-l border-stone-700/80 pl-3 hidden xs:block">
            <div class="flex items-center gap-2">
              <span class="text-xs font-serif tracking-wider text-white font-bold uppercase">Carta Digital</span>
              <span class="flex items-center gap-1 text-[10px] text-emerald-400 bg-emerald-950/80 border border-emerald-800/80 px-2 py-0.5 rounded-full font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                En directo
              </span>
            </div>
            <p class="text-[10px] text-stone-400 truncate" id="dbStatusText">Sincronizando platos...</p>
          </div>
        </div>

        <!-- Central Tabs: Gestión / Vista QR -->
        <div class="flex items-center bg-[#221E1C] border border-stone-800 p-1 rounded-xl text-xs shrink-0">
          <button id="tabAdminBtn" class="px-3 py-1.5 rounded-lg font-semibold bg-brand-burgundy text-white shadow-sm transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            <span>Carta</span>
          </button>
          <button id="tabPreviewBtn" class="px-3 py-1.5 rounded-lg text-stone-400 hover:text-white transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
            <span>Vista QR</span>
          </button>
        </div>

        <!-- User profile & Logout -->
        <div class="flex items-center gap-2">
          <a href="/carta" target="_blank" title="Abrir carta web" class="hidden md:flex items-center gap-1 text-xs text-stone-300 hover:text-white bg-stone-800/80 px-2.5 py-1.5 rounded-lg border border-stone-700">
            <span>Ver Carta Web</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
          <button id="btnLogout" title="Cerrar sesión" class="p-2 text-stone-400 hover:text-white hover:bg-stone-800 rounded-xl transition-colors flex items-center gap-1.5 text-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            <span class="hidden sm:inline">Salir</span>
          </button>
        </div>

      </div>
    </header>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-20 md:bottom-6 right-4 left-4 md:left-auto md:right-6 z-50 transform transition-all duration-300 translate-y-24 opacity-0 pointer-events-none">
      <div class="bg-[#171513] text-white border border-stone-700 shadow-2xl rounded-2xl px-4 py-3 flex items-center justify-between gap-3 text-sm max-w-md ml-auto">
        <div class="flex items-center gap-2.5 min-w-0">
          <span id="toastIcon" class="text-emerald-400 font-bold text-base shrink-0">✓</span>
          <span id="toastMsg" class="font-medium text-xs sm:text-sm truncate">Cambio guardado con éxito</span>
        </div>
        <button onclick="hideToast()" class="text-stone-400 hover:text-white text-xs px-2 py-1 shrink-0">Cerrar</button>
      </div>
    </div>

    <!-- MAIN BODY -->
    <main class="flex-1 max-w-7xl mx-auto w-full px-3.5 sm:px-6 lg:px-8 py-4 sm:py-6 pb-24 md:pb-12">

      <!-- ============================================== -->
      <!-- VISTA A: GESTIÓN DE CARTA -->
      <!-- ============================================== -->
      <section id="viewAdmin" class="space-y-4 sm:space-y-6">

        <!-- Bento Summary Cards -->
        <div class="grid grid-cols-3 gap-2.5 sm:gap-4">
          
          <div class="bg-white rounded-2xl border border-brand-border p-3 sm:p-4 shadow-card flex flex-col justify-between">
            <span class="text-[10px] sm:text-xs font-semibold text-stone-500 uppercase tracking-wider">En Carta</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="font-serif text-2xl sm:text-4xl font-bold text-[#171513]" id="metricAvailable">--</span>
              <span class="text-[11px] text-emerald-600 font-semibold hidden sm:inline">activos</span>
            </div>
            <div class="w-full bg-emerald-100 rounded-full h-1 mt-2 overflow-hidden">
              <div class="bg-emerald-600 h-1 rounded-full" id="metricAvailBar" style="width: 90%"></div>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-brand-border p-3 sm:p-4 shadow-card flex flex-col justify-between">
            <span class="text-[10px] sm:text-xs font-semibold text-stone-500 uppercase tracking-wider">Agotados Hoy</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="font-serif text-2xl sm:text-4xl font-bold text-rose-600" id="metricUnavailable">0</span>
              <span class="text-[11px] text-rose-500 font-medium hidden sm:inline">en cocina</span>
            </div>
            <div class="w-full bg-rose-100 rounded-full h-1 mt-2 overflow-hidden">
              <div class="bg-rose-500 h-1 rounded-full" id="metricUnavailBar" style="width: 10%"></div>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-brand-border p-3 sm:p-4 shadow-card flex flex-col justify-between">
            <span class="text-[10px] sm:text-xs font-semibold text-stone-500 uppercase tracking-wider">Categorías</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="font-serif text-2xl sm:text-4xl font-bold text-brand-burgundy" id="metricCategories">8</span>
              <span class="text-[11px] text-stone-400 hidden sm:inline">secciones</span>
            </div>
            <div class="w-full bg-stone-100 rounded-full h-1 mt-2 overflow-hidden">
              <div class="bg-brand-burgundy h-1 rounded-full" style="width: 100%"></div>
            </div>
          </div>

        </div>

        <!-- Controls Box: Search, Filters & Quick Add -->
        <div class="bg-white rounded-2xl sm:rounded-3xl border border-brand-border shadow-card p-4 sm:p-6 space-y-4">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#171513]">Control de Precios y Platos</h2>
              <p class="text-xs text-stone-500 mt-0.5">Toca el estado para marcarlo agotado o el precio para editarlo al instante.</p>
            </div>

            <!-- Botón Añadir Plato Desktop -->
            <button id="btnNewDishTop" class="hidden sm:flex px-4 py-2.5 bg-brand-burgundy hover:bg-brand-burgundyHover text-white rounded-xl text-xs sm:text-sm font-bold shadow-md hover:shadow-lg transition-all items-center gap-2 active:scale-95">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
              <span>Añadir Nuevo Plato</span>
            </button>
          </div>

          <!-- Buscador y filtro -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <div class="relative sm:col-span-2">
              <input type="text" id="searchInput" placeholder="Buscar por nombre, ingrediente o código..." class="w-full text-xs sm:text-sm pl-10 pr-4 py-2.5 sm:py-3 bg-stone-50 border border-stone-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-burgundy/15 focus:border-brand-burgundy transition-all">
              <svg class="w-4 h-4 text-stone-400 absolute left-3.5 top-3 sm:top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <button id="clearSearchBtn" class="hidden absolute right-3 top-3 text-stone-400 hover:text-stone-600 text-xs px-1">✕</button>
            </div>

            <select id="availabilityFilter" class="w-full text-xs sm:text-sm py-2.5 sm:py-3 px-3 bg-stone-50 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy text-stone-700 font-medium">
              <option value="all">Ver todos los platos</option>
              <option value="available">🟢 Solo Disponibles</option>
              <option value="unavailable">🔴 Solo Agotados</option>
            </select>
          </div>

          <!-- Píldoras de Categorías Deslizables -->
          <div class="border-t border-stone-100 pt-3 flex items-center gap-2 overflow-x-auto no-scrollbar pb-1" id="categoriesBar">
            <!-- Populated via JS -->
          </div>

        </div>

        <!-- Lista de Platos Principal -->
        <div class="bg-white rounded-2xl sm:rounded-3xl border border-brand-border shadow-card overflow-hidden">
          
          <div class="px-4 sm:px-6 py-3.5 bg-stone-50/70 border-b border-stone-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="font-serif text-lg font-bold text-[#171513]" id="currentCategoryTitle">Todos los Platos</span>
              <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-stone-200 text-stone-700" id="itemsCountBadge">0</span>
            </div>
            <span class="text-[11px] text-stone-400 hidden sm:inline">Actualizaciones automáticas para los clientes</span>
          </div>

          <!-- Items Container -->
          <div class="divide-y divide-stone-100" id="itemsList">
            <div class="p-12 text-center text-stone-400 text-xs sm:text-sm">Cargando platos de la carta...</div>
          </div>

        </div>

      </section>

      <!-- ============================================== -->
      <!-- VISTA B: SIMULADOR DE CARTA COMENSAL (QR) -->
      <!-- ============================================== -->
      <section id="viewPreview" class="hidden space-y-4 sm:space-y-6">
        
        <div class="bg-[#221E1C] text-white p-4 sm:p-6 rounded-2xl sm:rounded-3xl shadow-lg border border-stone-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="text-[10px] sm:text-xs uppercase tracking-widest text-brand-gold font-bold">Simulador de Menú QR</span>
            <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mt-0.5">Vista en Tiempo Real del Comensal</h2>
            <p class="text-xs text-stone-300">Así ven la carta los clientes desde sus móviles al escanear el QR en las mesas.</p>
          </div>

          <!-- Language Selector -->
          <div class="flex items-center gap-2 self-end sm:self-center">
            <span class="text-xs text-stone-400">Idioma:</span>
            <div class="bg-stone-900 p-1 rounded-xl border border-stone-700 flex gap-1 text-xs">
              <button class="px-2.5 py-1 rounded-lg bg-brand-burgundy text-white font-bold preview-lang" data-lang="es">ES</button>
              <button class="px-2.5 py-1 rounded-lg text-stone-400 hover:text-white preview-lang" data-lang="en">EN</button>
              <button class="px-2.5 py-1 rounded-lg text-stone-400 hover:text-white preview-lang" data-lang="de">DE</button>
            </div>
          </div>
        </div>

        <!-- Preview Categories Swipe -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1" id="previewCategories"></div>

        <!-- Preview Grid of Dishes -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5" id="previewDishes"></div>

      </section>

    </main>

    <!-- Botón Flotante para Móvil (+ Nuevo Plato) -->
    <button id="fabNewDish" class="sm:hidden fixed bottom-6 right-5 z-40 w-14 h-14 bg-brand-burgundy hover:bg-brand-burgundyHover text-white rounded-full shadow-2xl flex items-center justify-center border-2 border-white active:scale-90 transition-all">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
    </button>

    <!-- Footer Discreto -->
    <footer class="bg-white border-t border-brand-border py-4 text-center text-xs text-stone-400">
      Ristorante Buon Appetito · Puerto de Andratx · Carta Digital
    </footer>

  </div>

  <!-- ======================================================== -->
  <!-- 3. MODAL DE EDICIÓN / NUEVO PLATO (BOTTOM SHEET EN MÓVIL) -->
  <!-- ======================================================== -->
  <div id="dishModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-white w-full sm:max-w-xl sm:rounded-3xl rounded-t-3xl shadow-sheet sm:shadow-2xl border border-stone-200 overflow-hidden flex flex-col max-h-[92vh] sm:max-h-[85vh] animate-in slide-in-from-bottom duration-200">
      
      <!-- Mobile Drag Handle -->
      <div class="sm:hidden w-12 h-1 bg-stone-300 rounded-full mx-auto my-2.5"></div>

      <!-- Modal Header -->
      <div class="bg-[#171513] text-white px-5 py-4 flex items-center justify-between shrink-0">
        <div>
          <h3 class="font-serif text-lg font-bold text-white" id="modalHeading">Editar Plato</h3>
          <p class="text-xs text-stone-400" id="modalSubheading">Modifica los detalles, precios y traducciones</p>
        </div>
        <button id="closeModalBtn" class="w-8 h-8 rounded-full bg-stone-800 hover:bg-stone-700 flex items-center justify-center text-stone-300 hover:text-white text-sm">✕</button>
      </div>

      <!-- Modal Body (Scrollable) -->
      <form id="dishForm" class="p-5 overflow-y-auto space-y-4 flex-1">
        <input type="hidden" id="dishId">
        <input type="hidden" id="dishOrder">

        <!-- Categoría y Precio -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-stone-700 mb-1">Categoría</label>
            <select id="dishCategory" required class="w-full text-xs sm:text-sm px-3 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy font-medium">
              <!-- Categorías -->
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-stone-700 mb-1">Precio (€)</label>
            <input type="number" step="0.05" id="dishPrice" required placeholder="0.00" class="w-full text-xs sm:text-sm px-3 py-2.5 bg-stone-50 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy font-serif font-bold text-base text-[#171513]">
          </div>
        </div>

        <!-- Disponibilidad Rápida -->
        <div class="flex items-center justify-between bg-stone-50 p-3 rounded-2xl border border-stone-200">
          <div>
            <span class="text-xs font-bold text-stone-800 block">Disponibilidad en Sala</span>
            <span class="text-[11px] text-stone-500">Si está agotado, se desactivará en la carta de las mesas</span>
          </div>
          <select id="dishAvailable" class="text-xs font-bold px-3 py-2 rounded-xl border focus:outline-none bg-white">
            <option value="true">🟢 En Carta</option>
            <option value="false">🔴 Agotado</option>
          </select>
        </div>

        <!-- Bloque de Traducción Inteligente -->
        <div class="bg-amber-50/70 border border-amber-200/80 rounded-2xl p-3 sm:p-3.5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-base">✨</span>
              <span class="text-xs font-bold text-amber-900">Traducción Automática Asistida</span>
            </div>
            <p class="text-[11px] text-amber-700 mt-0.5">Rellena el plato en español y pulsa para generar inglés y alemán al instante.</p>
          </div>
          <button type="button" id="btnAutoTranslate" class="px-3.5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold shrink-0 shadow-sm flex items-center justify-center gap-1.5 active:scale-95 transition-all">
            <span id="transBtnSpinner" class="hidden animate-spin">⏳</span>
            <span id="transBtnText">✨ Auto-traducir</span>
          </button>
        </div>

        <!-- Pestañas de Idioma (ES, EN, DE) -->
        <div>
          <div class="flex items-center border-b border-stone-200 text-xs font-semibold gap-1">
            <button type="button" class="lang-tab px-3 py-2 border-b-2 border-brand-burgundy text-brand-burgundy font-bold flex items-center gap-1" data-lang="es">
              <span>🇪🇸</span> Español <span class="text-[10px] bg-stone-100 px-1 rounded text-stone-500 font-normal">Base</span>
            </button>
            <button type="button" class="lang-tab px-3 py-2 border-b-2 border-transparent text-stone-500 hover:text-stone-800 flex items-center gap-1" data-lang="en">
              <span>🇬🇧</span> Inglés
            </button>
            <button type="button" class="lang-tab px-3 py-2 border-b-2 border-transparent text-stone-500 hover:text-stone-800 flex items-center gap-1" data-lang="de">
              <span>🇩🇪</span> Alemán
            </button>
          </div>

          <!-- Campos ES -->
          <div id="tabContent_es" class="space-y-3 pt-3">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Nombre del Plato (Español)</label>
              <input type="text" id="title_es" required placeholder="Ej: Bruschetta de Pan Tostado" class="w-full text-xs sm:text-sm px-3.5 py-2.5 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy font-medium">
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Descripción / Ingredientes (Español)</label>
              <textarea id="desc_es" rows="2" placeholder="Ej: Con tomate fresco picado, albahaca y aceite de oliva virgen" class="w-full text-xs sm:text-sm px-3.5 py-2.5 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy"></textarea>
            </div>
          </div>

          <!-- Campos EN -->
          <div id="tabContent_en" class="space-y-3 pt-3 hidden">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Dish Name (English)</label>
              <input type="text" id="title_en" placeholder="Leave blank to use Spanish as fallback" class="w-full text-xs sm:text-sm px-3.5 py-2.5 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy font-medium">
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Description (English)</label>
              <textarea id="desc_en" rows="2" placeholder="Ingredients description in English" class="w-full text-xs sm:text-sm px-3.5 py-2.5 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy"></textarea>
            </div>
          </div>

          <!-- Campos DE -->
          <div id="tabContent_de" class="space-y-3 pt-3 hidden">
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Gerichtsname (Deutsch)</label>
              <input type="text" id="title_de" placeholder="Leer lassen für Spanisch als Fallback" class="w-full text-xs sm:text-sm px-3.5 py-2.5 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy font-medium">
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1">Beschreibung (Deutsch)</label>
              <textarea id="desc_de" rows="2" placeholder="Zutaten und Beschreibung auf Deutsch" class="w-full text-xs sm:text-sm px-3.5 py-2.5 border border-stone-200 rounded-xl focus:outline-none focus:border-brand-burgundy"></textarea>
            </div>
          </div>

        </div>

        <!-- Botón Eliminar Plato (si existe) -->
        <div id="deleteContainer" class="pt-2 hidden border-t border-stone-100">
          <button type="button" id="btnDeleteDish" class="text-xs text-rose-600 hover:text-rose-700 flex items-center gap-1.5 font-semibold py-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            <span>Eliminar permanentemente este plato</span>
          </button>
        </div>

        <!-- Botones de Acción del Modal -->
        <div class="pt-3 border-t border-stone-100 flex items-center justify-end gap-2.5">
          <button type="button" id="btnCancelModal" class="px-4 py-2.5 text-xs font-semibold text-stone-600 hover:bg-stone-100 rounded-xl transition-colors">
            Cancelar
          </button>
          <button type="submit" id="btnSaveModal" class="px-5 py-2.5 text-xs font-bold bg-brand-burgundy text-white hover:bg-brand-burgundyHover rounded-xl shadow-md transition-all flex items-center gap-1.5 active:scale-95">
            <span id="saveSpinner" class="hidden animate-spin">⏳</span>
            <span id="saveText">Guardar Cambios</span>
          </button>
        </div>

      </form>
    </div>
  </div>

  <!-- SCRIPT DE LA APLICACIÓN -->
  <script type="module">
    import { createClient, createAdminClient } from 'https://esm.sh/@insforge/sdk@latest';

    // Configuración de conexión privada
    const INSFORGE_URL = 'https://pz3qiueg.eu-central.insforge.app';
    const ANON_KEY = 'anon_64c904f7d36d64a81882dd8b41b193c03240d144f6de6a656b1d85ba0683ccec';
    const API_KEY = 'ik_7334a7a922b9b5b02262f3bce4c4cad8';

    // Credenciales autorizadas
    const VALID_USER = 'buonappetitoandratx@gmail.com';
    const VALID_PASS = 'admin';

    // Clientes de backend
    const client = createClient({ baseUrl: INSFORGE_URL, anonKey: ANON_KEY });
    const adminClient = createAdminClient({ baseUrl: INSFORGE_URL, apiKey: API_KEY });

    // Estado global de la aplicación
    let state = {
      isAuthenticated: false,
      categories: [],
      items: [],
      selectedCategory: 'all',
      searchQuery: '',
      availabilityFilter: 'all',
      previewLang: 'es',
      activeModalLangTab: 'es'
    };

    // DOM Elements - Login
    const loginScreen = document.getElementById('loginScreen');
    const loginForm = document.getElementById('loginForm');
    const loginEmail = document.getElementById('loginEmail');
    const loginPassword = document.getElementById('loginPassword');
    const loginError = document.getElementById('loginError');
    const togglePasswordBtn = document.getElementById('togglePasswordBtn');
    const appShell = document.getElementById('appShell');
    const btnLogout = document.getElementById('btnLogout');

    // DOM Elements - Header & Metrics
    const dbStatusText = document.getElementById('dbStatusText');
    const metricAvailable = document.getElementById('metricAvailable');
    const metricUnavailable = document.getElementById('metricUnavailable');
    const metricCategories = document.getElementById('metricCategories');
    const metricAvailBar = document.getElementById('metricAvailBar');
    const metricUnavailBar = document.getElementById('metricUnavailBar');

    // DOM Elements - Admin Views
    const categoriesBar = document.getElementById('categoriesBar');
    const itemsList = document.getElementById('itemsList');
    const itemsCountBadge = document.getElementById('itemsCountBadge');
    const currentCategoryTitle = document.getElementById('currentCategoryTitle');
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const availabilityFilter = document.getElementById('availabilityFilter');
    const tabAdminBtn = document.getElementById('tabAdminBtn');
    const tabPreviewBtn = document.getElementById('tabPreviewBtn');
    const viewAdmin = document.getElementById('viewAdmin');
    const viewPreview = document.getElementById('viewPreview');
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toastMsg');
    const toastIcon = document.getElementById('toastIcon');

    // DOM Elements - Modal
    const dishModal = document.getElementById('dishModal');
    const dishForm = document.getElementById('dishForm');
    const modalHeading = document.getElementById('modalHeading');
    const modalSubheading = document.getElementById('modalSubheading');
    const dishId = document.getElementById('dishId');
    const dishOrder = document.getElementById('dishOrder');
    const dishCategory = document.getElementById('dishCategory');
    const dishPrice = document.getElementById('dishPrice');
    const dishAvailable = document.getElementById('dishAvailable');
    const title_es = document.getElementById('title_es');
    const desc_es = document.getElementById('desc_es');
    const title_en = document.getElementById('title_en');
    const desc_en = document.getElementById('desc_en');
    const title_de = document.getElementById('title_de');
    const desc_de = document.getElementById('desc_de');
    const btnAutoTranslate = document.getElementById('btnAutoTranslate');
    const transBtnSpinner = document.getElementById('transBtnSpinner');
    const transBtnText = document.getElementById('transBtnText');
    const deleteContainer = document.getElementById('deleteContainer');
    const btnDeleteDish = document.getElementById('btnDeleteDish');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const btnCancelModal = document.getElementById('btnCancelModal');
    const btnNewDishTop = document.getElementById('btnNewDishTop');
    const fabNewDish = document.getElementById('fabNewDish');
    const saveSpinner = document.getElementById('saveSpinner');
    const saveText = document.getElementById('saveText');

    // GESTIÓN DE AUTENTICACIÓN
    function checkAuth() {
      const savedAuth = localStorage.getItem('buon_appetito_auth');
      if (savedAuth === 'true') {
        state.isAuthenticated = true;
        showApp();
      } else {
        showLogin();
      }
    }

    function showLogin() {
      loginScreen.classList.remove('hidden');
      appShell.classList.add('hidden');
    }

    function showApp() {
      loginScreen.classList.add('hidden');
      appShell.classList.remove('hidden');
      loadData();
    }

    togglePasswordBtn.addEventListener('click', () => {
      const isPassword = loginPassword.type === 'password';
      loginPassword.type = isPassword ? 'text' : 'password';
      togglePasswordBtn.textContent = isPassword ? '🙈' : '👁️';
    });

    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = loginEmail.value.trim().toLowerCase();
      const pass = loginPassword.value.trim();

      if (email === VALID_USER && pass === VALID_PASS) {
        loginError.classList.add('hidden');
        localStorage.setItem('buon_appetito_auth', 'true');
        state.isAuthenticated = true;
        showApp();
      } else {
        loginError.classList.remove('hidden');
      }
    });

    btnLogout.addEventListener('click', () => {
      if (confirm('¿Cerrar sesión en el panel de administración?')) {
        localStorage.removeItem('buon_appetito_auth');
        state.isAuthenticated = false;
        showLogin();
      }
    });

    // TOAST
    window.hideToast = function() {
      toast.classList.add('opacity-0', 'translate-y-24', 'pointer-events-none');
    };

    function showToast(message, isError = false) {
      toastMsg.textContent = message;
      toastIcon.textContent = isError ? '✕' : '✓';
      toastIcon.className = isError ? 'text-rose-400 font-bold' : 'text-emerald-400 font-bold';
      toast.classList.remove('opacity-0', 'translate-y-24', 'pointer-events-none');
      setTimeout(hideToast, 3500);
    }

    // CARGA DE DATOS
    async function loadData() {
      try {
        dbStatusText.textContent = 'Sincronizando...';
        
        const { data: catData, error: catError } = await client.database
          .from('menu_categories')
          .select()
          .order('display_order', { ascending: true });
        
        if (catError) throw catError;
        state.categories = catData || [];

        const { data: itemData, error: itemError } = await client.database
          .from('menu_items')
          .select()
          .order('display_order', { ascending: true });
          
        if (itemError) throw itemError;
        state.items = itemData || [];

        updateMetrics();
        dbStatusText.textContent = `${state.items.length} platos en carta`;
        populateCategorySelect();
        renderCategoriesBar();
        renderItems();
        renderPreview();
      } catch (err) {
        console.error('Error cargando datos:', err);
        dbStatusText.textContent = 'Error al sincronizar';
        showToast('Error cargando platos: ' + err.message, true);
      }
    }

    function updateMetrics() {
      const availCount = state.items.filter(i => i.is_available).length;
      const unavailCount = state.items.filter(i => !i.is_available).length;
      const total = state.items.length;

      metricAvailable.textContent = availCount;
      metricUnavailable.textContent = unavailCount;
      metricCategories.textContent = state.categories.length;

      const availPercent = total > 0 ? (availCount / total) * 100 : 100;
      const unavailPercent = total > 0 ? (unavailCount / total) * 100 : 0;

      metricAvailBar.style.width = `${availPercent}%`;
      metricUnavailBar.style.width = `${unavailPercent}%`;
    }

    function populateCategorySelect() {
      dishCategory.innerHTML = state.categories.map(c => `
        <option value="${c.id}">${c.name_es}</option>
      `).join('');
    }

    function renderCategoriesBar() {
      let html = `
        <button class="cat-pill px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${state.selectedCategory === 'all' ? 'bg-brand-burgundy text-white shadow-sm' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'}" data-cat="all">
          Todos (${state.items.length})
        </button>
      `;

      state.categories.forEach(cat => {
        const count = state.items.filter(i => i.category_id === cat.id).length;
        const active = state.selectedCategory === cat.id;
        html += `
          <button class="cat-pill px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${active ? 'bg-brand-burgundy text-white shadow-sm' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'}" data-cat="${cat.id}">
            ${cat.name_es} (${count})
          </button>
        `;
      });

      categoriesBar.innerHTML = html;

      categoriesBar.querySelectorAll('.cat-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          state.selectedCategory = btn.dataset.cat;
          renderCategoriesBar();
          renderItems();
        });
      });
    }

    function getFilteredItems() {
      return state.items.filter(item => {
        if (state.selectedCategory !== 'all' && item.category_id !== state.selectedCategory) return false;
        if (state.availabilityFilter === 'available' && !item.is_available) return false;
        if (state.availabilityFilter === 'unavailable' && item.is_available) return false;
        
        if (state.searchQuery) {
          const q = state.searchQuery.toLowerCase();
          const matchTitle = (item.title_es || '').toLowerCase().includes(q) ||
                             (item.title_en || '').toLowerCase().includes(q) ||
                             (item.title_de || '').toLowerCase().includes(q);
          const matchDesc = (item.description_es || '').toLowerCase().includes(q);
          const matchCode = (item.item_code || '').toLowerCase().includes(q);
          if (!matchTitle && !matchDesc && !matchCode) return false;
        }
        return true;
      });
    }

    function renderItems() {
      const filtered = getFilteredItems();
      itemsCountBadge.textContent = filtered.length;
      
      const currentCatObj = state.categories.find(c => c.id === state.selectedCategory);
      currentCategoryTitle.textContent = currentCatObj ? currentCatObj.name_es : 'Todos los Platos';

      if (filtered.length === 0) {
        itemsList.innerHTML = `<div class="p-10 text-center text-stone-400 text-xs sm:text-sm">No se encontraron platos que coincidan con los filtros.</div>`;
        return;
      }

      itemsList.innerHTML = filtered.map(item => {
        const isAvail = item.is_available;
        const categoryObj = state.categories.find(c => c.id === item.category_id);
        const categoryName = categoryObj ? categoryObj.name_es : item.category_id;

        return `
          <div class="p-4 sm:px-6 sm:py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3.5 hover:bg-stone-50/80 transition-colors group ${!isAvail ? 'opacity-60 bg-stone-50/50' : ''}" data-id="${item.id}">
            
            <div class="flex-1 min-w-0 cursor-pointer dish-row-click" data-id="${item.id}">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[11px] font-mono text-stone-400 uppercase font-semibold">${item.item_code || 'PLATO'}</span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${isAvail ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}">
                  ${isAvail ? '🟢 EN CARTA' : '🔴 AGOTADO'}
                </span>
                <span class="text-[11px] text-stone-400">· ${categoryName}</span>
              </div>
              <h4 class="font-serif text-lg sm:text-xl font-bold text-[#171513] mt-1">${item.title_es}</h4>
              <p class="text-xs text-stone-600 line-clamp-2 mt-0.5">${item.description_es || 'Sin descripción'}</p>
            </div>

            <div class="flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t border-stone-100 sm:border-0 shrink-0">
              
              <div class="text-left sm:text-right">
                <button class="btn-quick-price px-3.5 py-1.5 bg-stone-100 hover:bg-stone-200 rounded-xl font-serif text-lg font-bold text-[#171513] hover:text-brand-burgundy transition-all flex items-center gap-1 active:scale-95" data-id="${item.id}" data-price="${item.price}" title="Toca para cambiar precio">
                  <span>${Number(item.price).toFixed(2)} €</span>
                  <svg class="w-3 h-3 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                </button>
              </div>

              <button class="btn-toggle-avail min-h-[42px] px-4 py-2 rounded-xl text-xs font-bold border transition-all active:scale-95 ${isAvail ? 'bg-emerald-50 text-emerald-800 border-emerald-300 hover:bg-rose-50 hover:text-rose-700 hover:border-rose-300' : 'bg-rose-50 text-rose-800 border-rose-300 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300'}" data-id="${item.id}" data-avail="${isAvail}">
                ${isAvail ? '🟢 Disponible' : '🔴 Agotado'}
              </button>

              <button class="btn-edit-details p-2.5 text-stone-400 hover:text-brand-burgundy hover:bg-stone-100 rounded-xl transition-colors" data-id="${item.id}" title="Editar traducciones y detalles">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </button>

            </div>

          </div>
        `;
      }).join('');

      itemsList.querySelectorAll('.btn-toggle-avail').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = btn.dataset.id;
          const currentAvail = btn.dataset.avail === 'true';
          await updateItemAvailability(id, !currentAvail);
        });
      });

      itemsList.querySelectorAll('.btn-quick-price').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = btn.dataset.id;
          const currentPrice = btn.dataset.price;
          const val = prompt(`Nuevo precio en € para este plato:`, currentPrice);
          if (val !== null && val.trim() !== '') {
            const num = parseFloat(val.replace(',', '.'));
            if (!isNaN(num) && num >= 0) {
              await updateItemPrice(id, num);
            } else {
              alert('Introduce un precio numérico válido.');
            }
          }
        });
      });

      itemsList.querySelectorAll('.btn-edit-details, .dish-row-click').forEach(el => {
        el.addEventListener('click', () => {
          const id = el.dataset.id;
          openEditModal(id);
        });
      });
    }

    async function updateItemAvailability(id, is_available) {
      const item = state.items.find(i => i.id === id);
      const original = item ? item.is_available : null;
      if (item) item.is_available = is_available;
      
      updateMetrics();
      renderItems();
      renderPreview();

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .update({ is_available, updated_at: new Date().toISOString() })
          .eq('id', id);

        if (error) throw error;
        showToast(is_available ? 'Plato disponible en carta' : 'Plato marcado como agotado');
      } catch (err) {
        if (item) item.is_available = original;
        updateMetrics();
        renderItems();
        renderPreview();
        showToast('Error al actualizar disponibilidad: ' + err.message, true);
      }
    }

    async function updateItemPrice(id, price) {
      const item = state.items.find(i => i.id === id);
      const originalPrice = item ? item.price : null;
      if (item) item.price = price;
      
      renderItems();
      renderPreview();

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .update({ price, updated_at: new Date().toISOString() })
          .eq('id', id);

        if (error) throw error;
        showToast(`Precio actualizado a ${price.toFixed(2)} €`);
      } catch (err) {
        if (item) item.price = originalPrice;
        renderItems();
        renderPreview();
        showToast('Error al actualizar precio: ' + err.message, true);
      }
    }

    function openEditModal(id) {
      const item = state.items.find(i => i.id === id);
      if (!item) return;

      dishId.value = item.id;
      dishOrder.value = item.display_order || 1;
      modalHeading.textContent = `Editar Plato`;
      modalSubheading.textContent = `${item.title_es} (${item.item_code || item.id})`;
      
      dishCategory.value = item.category_id;
      dishPrice.value = item.price;
      dishAvailable.value = item.is_available ? 'true' : 'false';

      title_es.value = item.title_es || '';
      desc_es.value = item.description_es || '';
      title_en.value = item.title_en || '';
      desc_en.value = item.description_en || '';
      title_de.value = item.title_de || '';
      desc_de.value = item.description_de || '';

      deleteContainer.classList.remove('hidden');
      switchModalLangTab('es');
      dishModal.classList.remove('hidden');
      dishModal.classList.add('flex');
    }

    function openNewDishModal() {
      dishId.value = '';
      dishOrder.value = state.items.length + 1;
      modalHeading.textContent = `Añadir Nuevo Plato`;
      modalSubheading.textContent = `Introduce el nombre en español y tradúcelo con 1 clic`;
      
      dishCategory.value = state.selectedCategory !== 'all' ? state.selectedCategory : (state.categories[0]?.id || 'entrantes');
      dishPrice.value = '';
      dishAvailable.value = 'true';

      title_es.value = '';
      desc_es.value = '';
      title_en.value = '';
      desc_en.value = '';
      title_de.value = '';
      desc_de.value = '';

      deleteContainer.classList.add('hidden');
      switchModalLangTab('es');
      dishModal.classList.remove('hidden');
      dishModal.classList.add('flex');
      title_es.focus();
    }

    function closeDishModal() {
      dishModal.classList.add('hidden');
      dishModal.classList.remove('flex');
    }

    function switchModalLangTab(lang) {
      state.activeModalLangTab = lang;
      document.querySelectorAll('.lang-tab').forEach(t => {
        if (t.dataset.lang === lang) {
          t.className = 'lang-tab px-3 py-2 border-b-2 border-brand-burgundy text-brand-burgundy font-bold flex items-center gap-1';
        } else {
          t.className = 'lang-tab px-3 py-2 border-b-2 border-transparent text-stone-500 hover:text-stone-800 flex items-center gap-1';
        }
      });

      document.getElementById('tabContent_es').classList.toggle('hidden', lang !== 'es');
      document.getElementById('tabContent_en').classList.toggle('hidden', lang !== 'en');
      document.getElementById('tabContent_de').classList.toggle('hidden', lang !== 'de');
    }

    document.querySelectorAll('.lang-tab').forEach(t => {
      t.addEventListener('click', () => switchModalLangTab(t.dataset.lang));
    });

    async function translateText(text, targetLang) {
      if (!text || !text.trim()) return '';
      try {
        const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text.trim())}&langpair=es|${targetLang}`;
        const res = await fetch(url);
        const data = await res.json();
        if (data && data.responseData && data.responseData.translatedText) {
          const translated = data.responseData.translatedText;
          if (!translated.toUpperCase().includes('MYMEMORY WARNING')) {
            return translated;
          }
        }
        return text;
      } catch (e) {
        console.warn(`Translation error for ${targetLang}:`, e);
        return text;
      }
    }

    btnAutoTranslate.addEventListener('click', async () => {
      const esTitle = title_es.value.trim();
      const esDesc = desc_es.value.trim();

      if (!esTitle) {
        alert('Por favor, escribe primero el nombre del plato en español.');
        title_es.focus();
        return;
      }

      transBtnSpinner.classList.remove('hidden');
      transBtnText.textContent = 'Traduciendo...';
      btnAutoTranslate.disabled = true;

      try {
        const [enTitle, deTitle, enDesc, deDesc] = await Promise.all([
          translateText(esTitle, 'en'),
          translateText(esTitle, 'de'),
          esDesc ? translateText(esDesc, 'en') : Promise.resolve(''),
          esDesc ? translateText(esDesc, 'de') : Promise.resolve('')
        ]);

        title_en.value = enTitle;
        desc_en.value = enDesc;
        title_de.value = deTitle;
        desc_de.value = deDesc;

        showToast('✨ Traducciones en inglés y alemán listas');
        switchModalLangTab('en');
      } catch (err) {
        showToast('Error en la traducción: ' + err.message, true);
      } finally {
        transBtnSpinner.classList.add('hidden');
        transBtnText.textContent = '✨ Auto-traducir';
        btnAutoTranslate.disabled = false;
      }
    });

    dishForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = dishId.value;
      const isNew = !id;
      const category_id = dishCategory.value;
      const price = parseFloat(dishPrice.value);
      const is_available = dishAvailable.value === 'true';

      const t_es = title_es.value.trim();
      const d_es = desc_es.value.trim();
      const t_en = title_en.value.trim() || t_es;
      const d_en = desc_en.value.trim() || d_es;
      const t_de = title_de.value.trim() || t_es;
      const d_de = desc_de.value.trim() || d_es;

      saveSpinner.classList.remove('hidden');
      saveText.textContent = 'Guardando...';

      try {
        if (isNew) {
          const itemCode = `${category_id}-${String(state.items.length + 1).padStart(2, '0')}`;
          const newPayload = {
            id: itemCode,
            category_id,
            item_code: itemCode,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            is_available,
            display_order: parseInt(dishOrder.value) || state.items.length + 1
          };

          const { data, error } = await adminClient.database
            .from('menu_items')
            .insert([newPayload])
            .select();

          if (error) throw error;
          if (data && data[0]) state.items.push(data[0]);
          showToast('Plato nuevo añadido a la carta');
        } else {
          const updatePayload = {
            category_id,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            is_available,
            updated_at: new Date().toISOString()
          };

          const { error } = await adminClient.database
            .from('menu_items')
            .update(updatePayload)
            .eq('id', id);

          if (error) throw error;

          const item = state.items.find(i => i.id === id);
          if (item) Object.assign(item, updatePayload);
          showToast('Plato actualizado correctamente');
        }

        closeDishModal();
        updateMetrics();
        renderCategoriesBar();
        renderItems();
        renderPreview();
      } catch (err) {
        console.error('Error guardando plato:', err);
        showToast('Error al guardar: ' + err.message, true);
      } finally {
        saveSpinner.classList.add('hidden');
        saveText.textContent = 'Guardar Cambios';
      }
    });

    btnDeleteDish.addEventListener('click', async () => {
      const id = dishId.value;
      if (!id) return;

      const item = state.items.find(i => i.id === id);
      const name = item ? item.title_es : 'este plato';

      if (!confirm(`¿Deseas eliminar permanentemente "${name}" de la carta?`)) {
        return;
      }

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .delete()
          .eq('id', id);

        if (error) throw error;

        state.items = state.items.filter(i => i.id !== id);
        closeDishModal();
        updateMetrics();
        renderCategoriesBar();
        renderItems();
        renderPreview();
        showToast('Plato eliminado de la carta');
      } catch (err) {
        showToast('Error al eliminar plato: ' + err.message, true);
      }
    });

    function renderPreview() {
      const previewCategories = document.getElementById('previewCategories');
      const previewDishes = document.getElementById('previewDishes');
      const lang = state.previewLang;

      previewCategories.innerHTML = state.categories.map((c, i) => {
        const title = lang === 'en' ? (c.name_en || c.name_es) : (lang === 'de' ? (c.name_de || c.name_es) : c.name_es);
        return `
          <button class="px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-white border border-stone-200 text-stone-700 hover:border-brand-burgundy transition-all">
            ${title}
          </button>
        `;
      }).join('');

      const dishes = state.items;
      previewDishes.innerHTML = dishes.map(item => {
        const title = lang === 'en' ? (item.title_en || item.title_es) : (lang === 'de' ? (item.title_de || item.title_es) : item.title_es);
        const desc = lang === 'en' ? (item.description_en || item.description_es) : (lang === 'de' ? (item.description_de || item.description_es) : item.description_es);
        const isAvail = item.is_available;

        return `
          <div class="bg-white p-4 sm:p-5 rounded-2xl border border-brand-border shadow-card flex flex-col justify-between transition-all ${!isAvail ? 'opacity-55 grayscale bg-stone-50/70' : 'hover:border-brand-burgundy/30'}">
            <div>
              <div class="flex items-start justify-between gap-3">
                <h4 class="font-serif text-lg font-bold text-[#171513] leading-snug">${title}</h4>
                <span class="font-serif text-base font-bold text-brand-burgundy shrink-0">${Number(item.price).toFixed(2)} €</span>
              </div>
              <p class="text-xs text-stone-600 mt-1.5 leading-relaxed">${desc || ''}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between">
              <span class="text-[10px] font-mono text-stone-400 font-semibold">${item.item_code || ''}</span>
              ${!isAvail ? '<span class="text-[10px] font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">No disponible hoy</span>' : '<span class="text-[10px] text-emerald-700 font-semibold">Disponible</span>'}
            </div>
          </div>
        `;
      }).join('');
    }

    btnNewDishTop.addEventListener('click', openNewDishModal);
    fabNewDish.addEventListener('click', openNewDishModal);
    closeModalBtn.addEventListener('click', closeDishModal);
    btnCancelModal.addEventListener('click', closeDishModal);
    dishModal.addEventListener('click', (e) => {
      if (e.target === dishModal) closeDishModal();
    });

    document.querySelectorAll('.preview-lang').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.preview-lang').forEach(b => {
          b.className = 'px-2.5 py-1 rounded-lg text-stone-400 hover:text-white preview-lang';
        });
        btn.className = 'px-2.5 py-1 rounded-lg bg-brand-burgundy text-white font-bold preview-lang';
        state.previewLang = btn.dataset.lang;
        renderPreview();
      });
    });

    tabAdminBtn.addEventListener('click', () => {
      viewAdmin.classList.remove('hidden');
      viewPreview.classList.add('hidden');
      tabAdminBtn.className = 'px-3 py-1.5 rounded-lg font-semibold bg-brand-burgundy text-white shadow-sm transition-all flex items-center gap-1.5';
      tabPreviewBtn.className = 'px-3 py-1.5 rounded-lg text-stone-400 hover:text-white transition-all flex items-center gap-1.5';
    });

    tabPreviewBtn.addEventListener('click', () => {
      viewAdmin.classList.add('hidden');
      viewPreview.classList.remove('hidden');
      tabPreviewBtn.className = 'px-3 py-1.5 rounded-lg font-semibold bg-brand-burgundy text-white shadow-sm transition-all flex items-center gap-1.5';
      tabAdminBtn.className = 'px-3 py-1.5 rounded-lg text-stone-400 hover:text-white transition-all flex items-center gap-1.5';
    });

    searchInput.addEventListener('input', (e) => {
      state.searchQuery = e.target.value.trim();
      clearSearchBtn.classList.toggle('hidden', state.searchQuery.length === 0);
      renderItems();
    });

    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      state.searchQuery = '';
      clearSearchBtn.classList.add('hidden');
      renderItems();
    });

    availabilityFilter.addEventListener('change', (e) => {
      state.availabilityFilter = e.target.value;
      renderItems();
    });

    checkAuth();
  </script>
</body>
</html>
