    // ========================================================
    // PUBLICAR / SINCRONIZAR CAMBIOS CON LA WEB
    // ========================================================
    async function triggerSync() {
      if (state.isSyncing) return;
      state.isSyncing = true;

      btnSync.className = 'btn-sync syncing';
      syncText.textContent = 'Publicando...';
      if (drawerSyncBadge) {
        drawerSyncBadge.textContent = 'Publicando...';
        drawerSyncBadge.style.color = '#D97706';
        drawerSyncBadge.style.background = 'rgba(217,119,6,0.15)';
      }
      if (drawerSyncIcon) drawerSyncIcon.textContent = '⏳';
      if (drawerSyncText) drawerSyncText.textContent = 'Publicando en la Web...';

      try {
        await loadData(false);
        btnSync.className = 'btn-sync synced';
        syncText.textContent = 'Carta al día';
        if (drawerSyncBadge) {
          drawerSyncBadge.textContent = 'Al día';
          drawerSyncBadge.style.color = '#059669';
          drawerSyncBadge.style.background = 'rgba(5,150,105,0.12)';
        }
        if (drawerSyncIcon) drawerSyncIcon.textContent = '⚡';
        if (drawerSyncText) drawerSyncText.textContent = 'Publicar cambios en la Web';
        showToast('Carta sincronizada y publicada en la web');
      } catch (e) {
        btnSync.className = 'btn-sync needs-sync';
        syncText.textContent = 'Reintentar sync';
        if (drawerSyncBadge) {
          drawerSyncBadge.textContent = 'Sin conexión';
          drawerSyncBadge.style.color = '#DC2626';
          drawerSyncBadge.style.background = 'rgba(220,38,38,0.15)';
        }
        if (drawerSyncIcon) drawerSyncIcon.textContent = '⚠️';
        if (drawerSyncText) drawerSyncText.textContent = 'Reintentar sincronización';
        showToast('Error al sincronizar con la base de datos', true);
      } finally {
        state.isSyncing = false;
      }
    }

    btnSync.addEventListener('click', triggerSync);
    btnDrawerSync.addEventListener('click', triggerSync);

    // ========================================================
    // CARGA DE DATOS DESDE INSFORGE
    // ========================================================
    async function loadData(showLoadingIndicator = true) {
      try {
        if (showLoadingIndicator) {
          btnSync.className = 'btn-sync syncing';
          syncText.textContent = 'Cargando...';
        }

        const [catRes, itemRes] = await Promise.all([
          client.database.from('menu_categories').select().order('display_order', { ascending: true }),
          client.database.from('menu_items').select().order('display_order', { ascending: true })
        ]);

        if (catRes.error) throw catRes.error;
        if (itemRes.error) throw itemRes.error;

        state.categories = catRes.data || [];
        state.items = itemRes.data || [];

        populateCategorySelect();
        updateBadges();
        renderCategoriesBar();
        renderItems();

        btnSync.className = 'btn-sync synced';
        syncText.textContent = 'Carta al día';
      } catch (err) {
        console.error('Error cargando datos:', err);
        btnSync.className = 'btn-sync needs-sync';
        syncText.textContent = 'Sin conexión';
        showToast('Error al conectar con la base de datos', true);
      }
    }

    function populateCategorySelect() {
      dishCategory.innerHTML = state.categories.map(c => `
        <option value="${c.id}">${c.name_es}</option>
      `).join('');
    }

    function renderCategoriesBar() {
      const typeCats = getCurrentTypeCategories();
      const currentItems = state.items.filter(item => {
        if (state.currentMenuType === 'comida') return FOOD_CATEGORIES.includes(item.category_id);
        if (state.currentMenuType === 'bebidas') return DRINK_CATEGORIES.includes(item.category_id);
        return WINE_CATEGORIES.includes(item.category_id);
      });

      // Si sólo hay una categoría en este tipo de carta, ocultar completamente la barra para no saturar
      if (typeCats.length <= 1) {
        categoriesBar.style.display = 'none';
        categoriesBar.innerHTML = '';
        return;
      }

      categoriesBar.style.display = 'flex';

      let html = `
        <button class="cat-btn ${state.selectedCategory === 'all' ? 'active' : ''}" data-cat="all">
          Todos (${currentItems.length})
        </button>
      `;

      typeCats.forEach(cat => {
        const count = currentItems.filter(i => i.category_id === cat.id).length;
        const active = state.selectedCategory === cat.id;
        html += `
          <button class="cat-btn ${active ? 'active' : ''}" data-cat="${cat.id}">
            ${cat.name_es} (${count})
          </button>
        `;
      });

      categoriesBar.innerHTML = html;

      categoriesBar.querySelectorAll('.cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.selectedCategory = btn.dataset.cat;
          renderCategoriesBar();
          renderItems();
        });
      });
    }

    function getFilteredItems() {
      return state.items.filter(item => {
        if (state.currentMenuType === 'comida' && !FOOD_CATEGORIES.includes(item.category_id)) return false;
        if (state.currentMenuType === 'bebidas' && !DRINK_CATEGORIES.includes(item.category_id)) return false;
        if (state.currentMenuType === 'vinos' && !WINE_CATEGORIES.includes(item.category_id)) return false;

        if (state.selectedCategory !== 'all' && item.category_id !== state.selectedCategory) return false;
        
        if (state.searchQuery) {
          const q = state.searchQuery.toLowerCase();
          const matchTitle = (item.title_es || '').toLowerCase().includes(q) ||
                             (item.title_en || '').toLowerCase().includes(q) ||
                             (item.title_de || '').toLowerCase().includes(q);
          const matchDesc = (item.description_es || '').toLowerCase().includes(q);
          if (!matchTitle && !matchDesc) return false;
        }
        return true;
      });
    }

    // ========================================================
    // GESTIÓN DE KPIS & DISPONIBILIDAD OPERATIVA (POS)
    // ========================================================
    function updateKpiCounts() {
      const currentFiltered = getFilteredItems();
      const activeCount = currentFiltered.filter(i => i.is_available !== false).length;
      const outCount = currentFiltered.filter(i => i.is_available === false).length;

      if (kpiActiveCount) kpiActiveCount.textContent = activeCount;
      if (kpiOutCount) kpiOutCount.textContent = outCount;
    }

    async function toggleAvailability(id, isAvailable) {
      const item = state.items.find(i => i.id === id);
      if (!item) return;

      const previousState = item.is_available !== false;
      item.is_available = isAvailable;

      // Actualización optimista ultra-rápida en DOM
      const rowEl = document.querySelector(`.dish-row[data-id="${id}"]`);
      if (rowEl) {
        rowEl.classList.toggle('out-of-stock', !isAvailable);
        const badge = rowEl.querySelector('.badge-stock');
        if (badge) {
          badge.className = `badge-stock ${isAvailable ? 'in' : 'out'}`;
          badge.textContent = isAvailable ? '● En carta' : '✕ Agotado';
        }
      }

      updateKpiCounts();

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .update({ is_available: isAvailable, updated_at: new Date().toISOString() })
          .eq('id', id);

        if (error) throw error;

        logAction('update', id, item.title_es, isAvailable ? 'Marcado como disponible en carta' : 'Marcado como agotado temporalmente');
        showToast(isAvailable ? `"${item.title_es}" disponible en carta` : `"${item.title_es}" marcado como agotado`);
        btnSync.className = 'btn-sync synced';
        syncText.textContent = 'Carta al día';
      } catch (err) {
        console.error('Error actualizando disponibilidad:', err);
        // Rollback
        item.is_available = previousState;
        if (rowEl) {
          rowEl.classList.toggle('out-of-stock', !previousState);
          const badge = rowEl.querySelector('.badge-stock');
          if (badge) {
            badge.className = `badge-stock ${previousState ? 'in' : 'out'}`;
            badge.textContent = previousState ? '● En carta' : '✕ Agotado';
          }
          const cb = rowEl.querySelector('.stock-toggle-cb');
          if (cb) cb.checked = previousState;
        }
        updateKpiCounts();
        showToast('Error al actualizar disponibilidad', true);
      }
    }

    // ========================================================
    // RENDERIZADO DE PLATOS (CONSOLA POS OPERATIVA)
    // ========================================================
    function renderItems() {
      const filtered = getFilteredItems();
      itemsCountBadge.textContent = filtered.length;
      updateKpiCounts();
      
      const typeCats = getCurrentTypeCategories();
      const currentCatObj = typeCats.find(c => c.id === state.selectedCategory);

      if (state.selectedCategory !== 'all' && currentCatObj) {
        currentCategoryTitle.textContent = currentCatObj.name_es;
      } else {
        if (state.currentMenuType === 'comida') currentCategoryTitle.textContent = 'Carta de Comida';
        else if (state.currentMenuType === 'bebidas') currentCategoryTitle.textContent = 'Carta de Bebidas';
        else if (state.currentMenuType === 'vinos') currentCategoryTitle.textContent = 'Carta de Vinos · Bodega';
      }

      if (filtered.length === 0) {
        if (state.currentMenuType === 'vinos') {
          itemsList.innerHTML = `
            <div class="section-list" style="padding: 48px 20px; text-align: center; color: var(--text-muted); display: flex; flex-direction: column; align-items: center; gap: 12px;">
              <span style="font-size: 32px;">🍷</span>
              <div>
                <h4 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: var(--dark);">Bodega de Vinos</h4>
                <p style="font-size: 13px; margin-top: 4px;">No hay vinos registrados todavía en esta sección.</p>
              </div>
              <button type="button" class="btn-add-dish" id="btnEmptyAddWine" style="margin-top: 6px;">
                + Añadir Vino a la Bodega
              </button>
            </div>`;
          const btnEmptyAddWine = document.getElementById('btnEmptyAddWine');
          if (btnEmptyAddWine) btnEmptyAddWine.addEventListener('click', openNewDishModal);
        } else {
          itemsList.innerHTML = `<div class="section-list" style="padding: 40px 20px; text-align: center; color: var(--text-muted); font-size: 13px;">No se ha encontrado ningún producto.</div>`;
        }
        return;
      }

      const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      const row = (item, i) => {
        const isAvailable = item.is_available !== false;
        const catIcon = CAT_ICONS[item.category_id] || '🍽️';
        const thumbHtml = item.image_url
          ? `<img src="${esc(item.image_url)}" alt="${esc(item.title_es)}" class="dish-thumb-img" onerror="this.onerror=null;this.parentElement.innerHTML='<span class=\\'dish-thumb-icon\\'>${catIcon}</span>';">`
          : `<span class="dish-thumb-icon">${catIcon}</span>`;

        return `
          <div class="dish-row ${!isAvailable ? 'out-of-stock' : ''}" data-id="${esc(item.id)}" style="animation-delay:${Math.min(i, 12) * 18}ms">
            <div class="dish-thumb">
              ${thumbHtml}
            </div>
            <div class="dish-content">
              <div class="dish-top-row">
                <span class="dish-name">${esc(item.title_es)}</span>
                <span class="dish-price">${fmtEUR(item.price)}</span>
              </div>
              ${item.description_es ? `<p class="dish-desc">${esc(item.description_es)}</p>` : ''}
              <div class="dish-bottom-row">
                <div class="dish-status-left">
                  <span class="badge-stock ${isAvailable ? 'in' : 'out'}">${isAvailable ? '● En carta' : '✕ Agotado'}</span>
                  <button type="button" class="btn-quick-edit" data-id="${esc(item.id)}" title="Editar plato" onclick="event.stopPropagation();">
                    <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                    <span>Editar</span>
                  </button>
                </div>
                <div class="dish-switch-wrap" onclick="event.stopPropagation();">
                  <label class="ios-switch" title="${isAvailable ? 'Marcar agotado' : 'Marcar disponible'}">
                    <input type="checkbox" class="stock-toggle-cb" data-id="${esc(item.id)}" ${isAvailable ? 'checked' : ''}>
                    <span class="ios-slider"></span>
                  </label>
                </div>
              </div>
            </div>
          </div>`;
      };

      let catsToRender = state.selectedCategory === 'all' 
        ? typeCats 
        : typeCats.filter(c => c.id === state.selectedCategory);

      if (!catsToRender.length) {
        const uniqueCatIds = [...new Set(filtered.map(i => i.category_id))];
        catsToRender = uniqueCatIds.map(id => state.categories.find(c => c.id === id) || { id, name_es: id });
      }

      itemsList.innerHTML = catsToRender.map(cat => {
        const list = filtered.filter(it => it.category_id === cat.id);
        if (!list.length) return '';
        return `
          <section class="menu-section">
            <div class="section-head">
              <span class="sec-name">${esc(cat.name_es)}</span>
              <span class="sec-line"></span>
              <span class="sec-count">${list.length}</span>
            </div>
            <div class="section-list">${list.map(row).join('')}</div>
          </section>`;
      }).join('');

      // Click en fila para abrir modal
      itemsList.querySelectorAll('.dish-row').forEach(r => {
        r.addEventListener('click', () => openEditModal(r.dataset.id));
      });

      // Click en botón editar (Editar)
      itemsList.querySelectorAll('.btn-quick-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          openEditModal(btn.dataset.id);
        });
      });

      // Switch instantáneo de disponibilidad
      itemsList.querySelectorAll('.stock-toggle-cb').forEach(cb => {
        cb.addEventListener('change', (e) => {
          e.stopPropagation();
          toggleAvailability(cb.dataset.id, cb.checked);
        });
      });
    }

    // ========================================================
    // MODAL DE EDICIÓN / ALTA DE PLATO (NEO-BENTO STUDIO)
    // ========================================================
    function updateStockBadge(isAvailable) {
      const badge = document.getElementById('stockStatusBadge');
      const explainer = document.getElementById('stockExplainer');
      if (!badge || !explainer) return;

      if (isAvailable) {
        badge.className = 'bento-tag tag-emerald';
        badge.textContent = '● En Carta Activo';
        explainer.textContent = 'Visible y disponible para comandas en cocina.';
      } else {
        badge.className = 'bento-tag tag-ruby';
        badge.textContent = '✕ Agotado en Cocina';
        explainer.textContent = 'Temporalmente oculto a clientes hasta reposición.';
      }
    }

    if (dishAvailableCheck) {
      dishAvailableCheck.addEventListener('change', () => {
        updateStockBadge(dishAvailableCheck.checked);
      });
    }

    // Botones de incremento rápido de precio (+0.50€, +1.00€, etc.)
    document.querySelectorAll('.btn-q-price').forEach(btn => {
      btn.addEventListener('click', () => {
        const addVal = parseFloat(btn.dataset.add);
        let curr = parseFloat(dishPrice.value) || 0;
        if (!isNaN(addVal)) {
          curr = Math.round((curr + addVal) * 100) / 100;
          dishPrice.value = curr.toFixed(2);
        } else if (btn.id === 'btnRoundPrice') {
          curr = Math.ceil(curr);
          dishPrice.value = curr.toFixed(2);
        }
      });
    });

    function renderModalCategoryChips(selectedId) {
      const grid = document.getElementById('categoryChipsGrid');
      const activeNameEl = document.getElementById('activeCategoryName');
      if (!grid) return;

      const typeCats = getCurrentTypeCategories();
      let cats = [...typeCats];
      if (selectedId && !cats.some(c => c.id === selectedId)) {
        const found = state.categories.find(c => c.id === selectedId);
        if (found) cats.unshift(found);
      }
      if (!cats.length) cats = state.categories;

      const activeCat = state.categories.find(c => c.id === selectedId) || cats[0];
      if (activeNameEl && activeCat) {
        activeNameEl.textContent = activeCat.name_es;
      }

      grid.innerHTML = cats.map(cat => {
        const isActive = cat.id === selectedId;
        const icon = CAT_ICONS[cat.id] || '🏷️';
        return `
          <button type="button" class="cat-chip ${isActive ? 'active' : ''}" data-cat-id="${cat.id}">
            <span>${icon}</span>
            <span>${cat.name_es}</span>
          </button>
        `;
      }).join('');

      grid.querySelectorAll('.cat-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const cid = chip.dataset.catId;
          dishCategory.value = cid;
          grid.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          const cObj = state.categories.find(c => c.id === cid);
          if (activeNameEl && cObj) {
            activeNameEl.textContent = cObj.name_es;
          }
        });
      });
    }

    function openEditModal(id) {
      const item = state.items.find(i => i.id === id);
      if (!item) return;

      dishId.value = item.id;
      dishOrder.value = item.display_order || 1;
      modalHeading.textContent = `Editar: ${item.title_es}`;
      
      dishCategory.value = item.category_id;
      dishPrice.value = item.price !== undefined ? item.price : '';
      dishImageUrl.value = item.image_url || '';
      dishImageFile.value = '';

      // Disponibilidad en cocina
      const isAvail = item.is_available !== false;
      dishAvailableCheck.checked = isAvail;
      updateStockBadge(isAvail);

      // Categoría Bento Chips
      renderModalCategoryChips(item.category_id);

      title_es.value = item.title_es || '';
      desc_es.value = item.description_es || '';
      title_en.value = item.title_en || '';
      desc_en.value = item.description_en || '';
      title_de.value = item.title_de || '';
      desc_de.value = item.description_de || '';

      deleteContainer.style.display = 'block';
      switchModalLangTab('es');
      lockBackgroundScroll();
      dishModal.style.display = 'flex';
    }

    function openNewDishModal() {
      dishId.value = '';
      dishOrder.value = state.items.length + 1;
      
      let defaultCat = 'entrantes';
      if (state.currentMenuType === 'bebidas') {
        modalHeading.textContent = 'Añadir Bebida';
        defaultCat = 'bebidas';
      } else if (state.currentMenuType === 'vinos') {
        modalHeading.textContent = 'Añadir Vino a Bodega';
        defaultCat = state.categories.find(c => WINE_CATEGORIES.includes(c.id))?.id || (state.categories[0]?.id || 'bebidas');
      } else {
        modalHeading.textContent = 'Añadir Nuevo Plato';
        defaultCat = state.selectedCategory !== 'all' ? state.selectedCategory : (state.categories[0]?.id || 'entrantes');
      }
      dishCategory.value = defaultCat;
      
      dishPrice.value = '';
      dishImageUrl.value = '';
      dishImageFile.value = '';
      dishAvailableCheck.checked = true;
      updateStockBadge(true);

      // Categoría Bento Chips
      renderModalCategoryChips(defaultCat);

      title_es.value = '';
      desc_es.value = '';
      title_en.value = '';
      desc_en.value = '';
      title_de.value = '';
      desc_de.value = '';

      deleteContainer.style.display = 'none';
      switchModalLangTab('es');
      lockBackgroundScroll();
      dishModal.style.display = 'flex';
      setTimeout(() => title_es.focus(), 120);
    }

    function closeDishModal() {
      if (dishModal.style.display === 'none') return;
      dishModal.style.display = 'none';
      unlockBackgroundScroll();
    }

    function switchModalLangTab(lang) {
      state.activeModalLangTab = lang;
      document.querySelectorAll('.studio-lang-tab').forEach(t => {
        t.classList.toggle('active', t.dataset.lang === lang);
      });

      const tabEs = document.getElementById('tabContent_es');
      const tabEn = document.getElementById('tabContent_en');
      const tabDe = document.getElementById('tabContent_de');
      if (tabEs) tabEs.style.display = lang === 'es' ? 'flex' : 'none';
      if (tabEn) tabEn.style.display = lang === 'en' ? 'flex' : 'none';
      if (tabDe) tabDe.style.display = lang === 'de' ? 'flex' : 'none';
    }

    document.querySelectorAll('.studio-lang-tab').forEach(t => {
      t.addEventListener('click', () => switchModalLangTab(t.dataset.lang));
    });

    // Traducción asistida gratuita
    async function translateText(text, targetLang) {
      if (!text || !text.trim()) return '';
      try {
        const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text.trim())}&langpair=es|${targetLang}`;
        const res = await fetch(url);
        const data = await res.json();
        if (data && data.responseData && data.responseData.translatedText) {
          const t = data.responseData.translatedText;
          if (!t.toUpperCase().includes('MYMEMORY WARNING')) return t;
        }
        return text;
      } catch (e) {
        return text;
      }
    }

    btnAutoTranslate.addEventListener('click', async () => {
      const esTitle = title_es.value.trim();
      const esDesc = desc_es.value.trim();

      if (!esTitle) {
        alert('Escribe el nombre en español primero.');
        title_es.focus();
        return;
      }

      transSpinner.style.display = 'inline';
      transText.textContent = 'Traduciendo...';
      btnAutoTranslate.disabled = true;

      try {
        const [enTitle, deTitle, enDesc, deDesc] = await Promise.all([
          translateText(esTitle, 'en'),
          translateText(esTitle, 'de'),
          esDesc ? translateText(esDesc, 'en') : Promise.resolve(''),
          esDesc ? translateText(esDesc, 'de') : Promise.resolve('')
        ]);

        title_en.value = enTitle;
        desc_en.value = enDesc;
        title_de.value = deTitle;
        desc_de.value = deDesc;

        showToast('Traducciones generadas');
        switchModalLangTab('en');
      } catch (err) {
        showToast('Error al traducir', true);
      } finally {
        transSpinner.style.display = 'none';
        transText.textContent = '✨ Auto-traducir';
        btnAutoTranslate.disabled = false;
      }
    });

    dishForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = dishId.value;
      const isNew = !id;
      const category_id = dishCategory.value;
      const price = parseFloat(dishPrice.value);
      const is_available = dishAvailableCheck.checked;
      const image_url = dishImageUrl.value.trim() || null;

      const t_es = title_es.value.trim();
      const d_es = desc_es.value.trim();
      const t_en = title_en.value.trim() || t_es;
      const d_en = desc_en.value.trim() || d_es;
      const t_de = title_de.value.trim() || t_es;
      const d_de = desc_de.value.trim() || d_es;

      saveSpinner.style.display = 'inline';
      saveText.textContent = 'Guardando...';

      try {
        if (isNew) {
          const itemCode = `${category_id}-${String(state.items.length + 1).padStart(2, '0')}`;
          const newPayload = {
            id: itemCode,
            category_id,
            item_code: itemCode,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            image_url,
            is_available,
            display_order: parseInt(dishOrder.value) || state.items.length + 1
          };

          const { data, error } = await adminClient.database
            .from('menu_items')
            .insert([newPayload])
            .select();

          if (error) throw error;
          if (data && data[0]) state.items.push(data[0]);
          logAction('create', newPayload.id, t_es, `${fmtEUR(price)} · ${(state.categories.find(c => c.id === category_id) || {}).name_es || category_id}`);
          showToast('Elemento añadido a la carta');
        } else {
          const updatePayload = {
            category_id,
            title_es: t_es,
            title_en: t_en,
            title_de: t_de,
            description_es: d_es,
            description_en: d_en,
            description_de: d_de,
            price,
            image_url,
            is_available,
            updated_at: new Date().toISOString()
          };

          const { error } = await adminClient.database
            .from('menu_items')
            .update(updatePayload)
            .eq('id', id);

          if (error) throw error;

          const item = state.items.find(i => i.id === id);
          if (item) {
            const changes = describeChanges(item, updatePayload);
            if (changes.length) {
              const onlyPrice = changes.length === 1 && changes[0].startsWith('Precio');
              logAction(onlyPrice ? 'price' : 'update', id, t_es, changes.join(' · '));
            }
            Object.assign(item, updatePayload);
          }
          showToast('Guardado con éxito');
        }

        closeDishModal();
        updateBadges();
        renderCategoriesBar();
        renderItems();
        btnSync.className = 'btn-sync synced';
        syncText.textContent = 'Carta al día';
      } catch (err) {
        console.error('Error guardando:', err);
        showToast('Error al guardar datos', true);
      } finally {
        saveSpinner.style.display = 'none';
        saveText.textContent = 'Guardar Plato';
      }
    });

    btnDeleteDish.addEventListener('click', async () => {
      const id = dishId.value;
      if (!id) return;

      const item = state.items.find(i => i.id === id);
      if (!confirm(`¿Eliminar "${item?.title_es || 'este elemento'}" de la carta?`)) return;

      try {
        const { error } = await adminClient.database
          .from('menu_items')
          .delete()
          .eq('id', id);

        if (error) throw error;

        logAction('delete', id, item?.title_es || id, item ? fmtEUR(item.price) : '');
        state.items = state.items.filter(i => i.id !== id);
        closeDishModal();
        updateBadges();
        renderCategoriesBar();
        renderItems();
        showToast('Eliminado de la carta');
      } catch (err) {
        showToast('Error al eliminar', true);
      }
    });

    btnNewDish.addEventListener('click', openNewDishModal);
    if (closeModalBtn) closeModalBtn.addEventListener('click', closeDishModal);
    if (btnCancelModal) btnCancelModal.addEventListener('click', closeDishModal);
    dishModal.addEventListener('click', (e) => {
      if (e.target === dishModal) closeDishModal();
    });
    dishModal.addEventListener('touchend', (e) => {
      if (e.target === dishModal) {
        e.preventDefault();
        closeDishModal();
      }
    }, { passive: false });

    searchInput.addEventListener('input', (e) => {
      state.searchQuery = e.target.value.trim();
      renderItems();
    });

    // Tecla Escape para cerrar cualquier modal abierto
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (dishModal.style.display === 'flex') closeDishModal();
        else if (securityModal.style.display === 'flex') closeSecurityModal();
        else if (pwaModal.style.display === 'flex') closePwaModal();
        else if (logsModal.style.display === 'flex') closeLogsModal();
        else if (profileDrawer.style.display === 'flex') closeProfileDrawer();
      }
    });

    // Iniciar verificación de sesión
    checkAuth();
  </script>
</body>
</html>
