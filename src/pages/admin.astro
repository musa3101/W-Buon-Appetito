      const pass = loginPassword.value.trim();
      const currentValidPass = localStorage.getItem('buon_custom_pass') || DEFAULT_PASS;

      if (email === VALID_USER && pass === currentValidPass) {
        loginError.style.display = 'none';
        localStorage.setItem('buon_appetito_auth', 'true');
        if (rememberMe && rememberMe.checked) {
          localStorage.setItem('buon_appetito_remember', 'true');
