    .studio-textarea:focus {
      outline: none;
      background: #FFFFFF;
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px var(--brand-ring);
    }

    .btn-danger-studio {
      width: 100%;
      height: 40px;
      background: transparent;
      border: 1px dashed #FCA5A5;
      color: #DC2626;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
