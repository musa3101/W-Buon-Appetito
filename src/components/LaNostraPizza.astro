<!-- ======================================================== -->
<!-- 4. LA NOSTRA PIZZA (Artesanía, Fermentación 48h & Trazos)  -->
<!-- ======================================================== -->
<section class="py-20 sm:py-28 md:py-36 bg-[#F5EFEB] border-b border-[#D9D4CC]/30 overflow-hidden" id="pizza">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3 sm:space-y-4 mb-12 md:mb-16">
      <span data-i18n="pizza_eyebrow" class="font-satoshi text-xs font-semibold text-[#9E4221] uppercase tracking-[0.25em]">Especialidad &bull; Tradición Italiana</span>
      <h2 data-i18n="pizza_title" class="font-boska text-3xl sm:text-4xl md:text-5xl text-[#183321] font-normal tracking-tight">
        Il Nostro Calzone Tradizionale
      </h2>
      <p data-i18n="pizza_desc" class="font-satoshi text-[#424842] text-sm sm:text-base leading-relaxed">
        Doblado a mano y horneado a fuego vivo para concentrar todo el vapor, fundir el relleno y lograr una masa ligera e irresistible.
      </p>
    </div>

    <!-- Desktop Infographic Stage (md and up) -->
    <div class="hidden md:block relative max-w-5xl mx-auto h-[640px] select-none">
      
      <!-- Center: Authentic Calzone Artesanal con destellos en punta derecha -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="relative pointer-events-auto">
          <img 
            src="/assets/our-pizza.webp" 
            alt="La Nostra Calzone Artesanal" 
            class="w-[450px] lg:w-[490px] h-auto object-contain drop-shadow-[0_25px_40px_rgba(24,51,33,0.18)] transition-transform duration-700 ease-out hover:scale-105 cursor-pointer"
            loading="lazy"
          />
          <!-- Destellos decorativos (flash) directamente sobre la punta derecha del calzone -->
          <img 
            src="/assets/flash.svg" 
            alt="Detalle artesanal" 
            class="absolute -top-7 lg:-top-8 left-[87.8%] -translate-x-1/2 w-10 lg:w-11 h-auto pointer-events-none transition-transform duration-500 hover:scale-110" 
          />
        </div>
      </div>

      <!-- Callout 1 (Arriba-Izquierda): Masa y plegado característico -->
      <div class="absolute top-2 left-4 lg:left-8 max-w-[290px] text-left">
        <h3 data-i18n-html="pizza_c1_title" class="font-boska text-2xl lg:text-[28px] font-medium text-[#1B1C1A] leading-tight tracking-tight">
          Plegado artesanal<br/>en media luna
        </h3>
        <p data-i18n="pizza_c1_desc" class="font-satoshi text-xs lg:text-[13px] text-[#424842] mt-2 leading-relaxed">
          Masa madre sellada a mano que guarda todo el vapor, aroma y jugosidad en su interior.
        </p>
        <img 
          src="/assets/arrow1.svg" 
          alt="Flecha señalando el plegado artesanal" 
          class="w-32 lg:w-36 h-auto mt-2 ml-16 lg:ml-22 pointer-events-none" 
        />
      </div>

      <!-- Callout 2 (Abajo-Izquierda): Horneado y textura con arco ascendente hacia la masa crujiente -->
      <div class="absolute bottom-8 left-4 lg:left-8 max-w-[280px] lg:max-w-[310px] text-left">
        <!-- Flecha: Nace encima del texto y sube dibujando un arco natural hacia la base del calzone -->
        <img 
          src="/assets/arrow3-trimmed.svg" 
          alt="Flecha señalando el horneado crujiente" 
          class="w-32 lg:w-40 h-auto mb-2 ml-16 lg:ml-24 pointer-events-none -rotate-12" 
        />
        <h3 data-i18n-html="pizza_c2_title" class="font-boska text-2xl lg:text-[28px] font-medium text-[#1B1C1A] leading-tight tracking-tight mb-1">
          Horneado al punto<br/>crujiente
        </h3>
        <p data-i18n="pizza_c2_desc" class="font-satoshi text-xs lg:text-[13px] text-[#424842] mt-1 leading-relaxed">
          Borde dorado y aireado a alta temperatura para un contraste crujiente por fuera y tierno por dentro.
        </p>
      </div>

      <!-- Callout 3 (Abajo-Derecha): Relleno y topping fresco apuntando hacia el centro/relleno -->
      <div class="absolute bottom-8 right-4 lg:right-8 max-w-[280px] lg:max-w-[320px] text-left">
        <!-- Flecha curva que apunta hacia la parte inferior y centro del relleno sin competir con la punta superior -->
        <img 
          src="/assets/arrow2-trimmed.svg" 
          alt="Flecha señalando el relleno y toque fresco" 
          class="w-32 lg:w-40 h-auto mb-2 mr-16 lg:mr-24 pointer-events-none scale-y-[-1] -rotate-45" 
        />
        <h3 data-i18n-html="pizza_c3_title" class="font-boska text-2xl lg:text-[28px] font-medium text-[#1B1C1A] leading-tight tracking-tight mb-1">
          Corazón fundido<br/>y toque fresco
        </h3>
        <p data-i18n="pizza_c3_desc" class="font-satoshi text-xs lg:text-[13px] text-[#424842] mt-1 leading-relaxed">
          Mozzarella fundida en su interior coronada con salsa natural, hierbas aromáticas y aceite de oliva virgen.
        </p>
      </div>

    </div>

    <!-- Mobile Infographic Stage (md:hidden) — Distribución equilibrada full responsive -->
    <div class="md:hidden relative w-full max-w-[380px] mx-auto h-[540px] select-none overflow-visible">
      
      <!-- 1. Calzone Central con halo sutil -->
      <div class="absolute left-1/2 top-[215px] -translate-x-1/2 -translate-y-1/2 pointer-events-none">
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-48 h-32 bg-[#9E4221]/10 rounded-full blur-2xl"></div>
        </div>
        <div class="relative pointer-events-auto">
          <img 
            src="/assets/our-pizza.webp" 
            alt="La Nostra Calzone Artesanal" 
            class="w-[250px] h-auto object-contain drop-shadow-[0_15px_30px_rgba(24,51,33,0.22)]"
            loading="lazy"
          />
          <!-- Destellos decorativos sobre la punta derecha del calzone -->
          <img 
            src="/assets/flash.svg" 
            alt="Detalle artesanal" 
            class="absolute -top-5 left-[87.8%] -translate-x-1/2 w-6 sm:w-7 h-auto pointer-events-none" 
          />
        </div>
      </div>

      <!-- 2. Callout 1 (Arriba-Izquierda): Masa y plegado -->
      <div class="absolute top-2 left-3 max-w-[165px] text-left z-10">
        <h3 data-i18n-html="pizza_c1_title" class="font-boska text-[16px] font-medium text-[#1B1C1A] leading-tight tracking-tight">
          Plegado artesanal<br/>en media luna
        </h3>
        <p data-i18n="pizza_c1_desc" class="font-satoshi text-[9.5px] text-[#424842] mt-0.5 leading-snug">
          Masa madre sellada a mano que guarda todo el vapor, aroma y jugosidad.
        </p>
      </div>
      <!-- Flecha 1: Arco hacia abajo apuntando a la corteza superior recortado a la mitad -->
      <img 
        src="/assets/arrow2-trimmed.svg" 
        alt="Flecha masa" 
        class="absolute top-[88px] left-[80px] w-[88px] h-auto pointer-events-none z-10 scale-x-[-1] rotate-12" 
      />

      <!-- 3. Callout 2 (Abajo a la Izquierda): Horneado y textura -->
      <div class="absolute top-[315px] left-3 max-w-[150px] text-left z-10">
        <!-- Flecha: Nace sobre el texto y asciende hacia la base de la pizza recortada a la mitad -->
        <img 
          src="/assets/arrow3-trimmed.svg" 
          alt="Flecha horneado" 
          class="w-[88px] h-auto mb-1 ml-6 pointer-events-none" 
        />
        <h3 data-i18n-html="pizza_c2_title" class="font-boska text-[16px] font-medium text-[#1B1C1A] leading-tight tracking-tight mb-0.5">
          Horneado al punto<br/>crujiente
        </h3>
        <p data-i18n="pizza_c2_desc" class="font-satoshi text-[9.5px] text-[#424842] mt-0.5 leading-snug">
          Borde dorado a alta temperatura, crujiente por fuera y tierno por dentro.
        </p>
      </div>

      <!-- 4. Callout 3 (Abajo a la Derecha): Relleno y toque fresco -->
      <div class="absolute top-[315px] right-2 sm:right-3 max-w-[155px] text-left z-10">
        <!-- Flecha: Nace sobre el texto y asciende apuntando a los ingredientes recortada a la mitad -->
        <img 
          src="/assets/arrow3-trimmed.svg" 
          alt="Flecha relleno" 
          class="w-[88px] h-auto mb-1 -ml-2 pointer-events-none scale-x-[-1]" 
        />
        <h3 data-i18n-html="pizza_c3_title" class="font-boska text-[16px] font-medium text-[#1B1C1A] leading-tight tracking-tight mb-0.5">
          Corazón fundido<br/>y toque fresco
        </h3>
        <p data-i18n="pizza_c3_desc" class="font-satoshi text-[9.5px] text-[#424842] mt-0.5 leading-snug">
          Mozzarella fundida con salsa natural, hierbas y aceite de oliva virgen.
        </p>
      </div>

    </div>

  </div>
</section>
