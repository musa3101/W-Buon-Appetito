<!-- ======================================================== -->
<!-- 4. LA NOSTRA PIZZA (Artesanía, Fermentación 48h & Trazos)  -->
<!-- ======================================================== -->
<section class="py-20 sm:py-28 md:py-36 bg-[#F5EFEB] border-b border-[#D9D4CC]/30 overflow-hidden" id="pizza">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3 sm:space-y-4 mb-12 md:mb-16">
      <span class="text-xs font-semibold text-[#9E4221] uppercase tracking-[0.25em]">Autenticidad &bull; Hecho a Mano</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#183321] font-semibold tracking-tight">
        La Nostra Pizza Artesanal
      </h2>
      <p class="font-sans text-[#424842] text-sm sm:text-base leading-relaxed">
        Cada pizza nace del respeto por los tiempos de fermentación, el producto de proximidad y el fuego vivo tradicional.
      </p>
    </div>

    <!-- Desktop Infographic Stage (md and up) -->
    <div class="hidden md:block relative max-w-5xl mx-auto h-[640px] select-none">
      
      <!-- Center: Authentic Napolitan Pizza -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <img 
          src="/assets/our-pizza.png" 
          alt="La Nostra Pizza Artesanal" 
          class="w-[430px] lg:w-[470px] h-auto object-contain drop-shadow-[0_25px_40px_rgba(24,51,33,0.18)] transition-transform duration-700 ease-out hover:scale-105 pointer-events-auto cursor-pointer"
          loading="lazy"
        />
      </div>

      <!-- Callout 1 (Top-Left): Masa Larga Fermentación -->
      <div class="absolute top-2 left-4 lg:left-8 max-w-[280px] text-left">
        <h3 class="font-sans text-2xl lg:text-[28px] font-bold text-[#1B1C1A] leading-tight tracking-tight">
          Nuestra masa<br/>de larga<br/>fermentación
        </h3>
        <p class="font-sans text-xs text-[#424842] mt-2 leading-relaxed">
          Harina orgánica tipo 1 y 48h de maduración lenta para una ligereza inigualable.
        </p>
        <img 
          src="/assets/arrow1.svg" 
          alt="Flecha señalando la masa" 
          class="w-32 lg:w-36 h-auto mt-2 ml-14 lg:ml-20 pointer-events-none" 
        />
      </div>

      <!-- Callout 2 (Top-Right): Ingredientes de Proximidad -->
      <div class="absolute top-10 right-4 lg:right-8 max-w-[300px] text-left">
        <img 
          src="/assets/arrow2.svg" 
          alt="Flecha señalando los ingredientes" 
          class="w-52 lg:w-60 h-auto mb-2 -ml-24 lg:-ml-28 pointer-events-none" 
        />
        <h3 class="font-sans text-2xl lg:text-[28px] font-bold text-[#1B1C1A] leading-tight tracking-tight">
          Los mejores<br/>ingredientes de<br/>proximidad
        </h3>
        <p class="font-sans text-xs text-[#424842] mt-2 leading-relaxed">
          Tomate San Marzano D.O.P., mozzarella fresca de Campania y producto de lonja local.
        </p>
      </div>

      <!-- Callout 3 (Bottom-Left): Preparación Tradicional -->
      <div class="absolute bottom-4 left-8 lg:left-14 max-w-[290px] text-left">
        <div class="flex items-center gap-2 mb-1">
          <h3 class="font-sans text-2xl lg:text-[28px] font-bold text-[#1B1C1A] leading-tight tracking-tight">
            Preparación<br/>Tradicional
          </h3>
          <img 
            src="/assets/flash.svg" 
            alt="Destellos preparación artesanal" 
            class="w-10 h-auto mb-4 pointer-events-none" 
          />
        </div>
        <p class="font-sans text-xs text-[#424842] mt-1 leading-relaxed">
          Amasado manual a la napolitana y horneado en piedra viva con leña pura a 450°C.
        </p>
        <img 
          src="/assets/arrow3.svg" 
          alt="Flecha señalando la preparación" 
          class="w-44 lg:w-48 h-auto mt-2 ml-16 lg:ml-24 pointer-events-none" 
        />
      </div>

    </div>

    <!-- Mobile Infographic Stage (md:hidden) — Distribución equilibrada sin vacíos laterales -->
    <div class="md:hidden relative w-full max-w-[380px] mx-auto h-[530px] select-none overflow-visible">
      
      <!-- 1. Pizza Central con halo sutil (elevada sutilmente a y=215px para dar espacio limpio abajo) -->
      <div class="absolute left-1/2 top-[215px] -translate-x-1/2 -translate-y-1/2 pointer-events-none">
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-44 h-44 bg-[#9E4221]/10 rounded-full blur-2xl"></div>
        </div>
        <img 
          src="/assets/our-pizza.png" 
          alt="La Nostra Pizza Artesanal" 
          class="w-[215px] h-auto object-contain drop-shadow-[0_15px_30px_rgba(24,51,33,0.22)] pointer-events-auto"
          loading="lazy"
        />
      </div>

      <!-- 2. Callout 1 (Arriba-Izquierda): Masa Larga Fermentación -->
      <div class="absolute top-2 left-3 max-w-[155px] text-left z-10">
        <h3 class="font-sans text-[14px] font-bold text-[#1B1C1A] leading-tight tracking-tight">
          Nuestra masa<br/>de larga<br/>fermentación
        </h3>
        <p class="font-sans text-[10px] text-[#424842] mt-0.5 leading-snug">
          Masa madre viva y 48h de maduración lenta.
        </p>
      </div>
      <!-- Flecha 1: Arco que nace bajo el texto y se arquea suavemente hacia la corteza superior -->
      <img 
        src="/assets/arrow2.svg" 
        alt="Flecha masa" 
        class="absolute top-[92px] left-[80px] w-[90px] h-auto pointer-events-none z-10 scale-x-[-1] rotate-12"
      />

      <!-- 3. Callout 2 (Abajo a la Derecha): Ingredientes de Proximidad (ocupa el flanco derecho) -->
      <div class="absolute top-[315px] right-2 sm:right-3 max-w-[150px] text-left z-10">
        <!-- Flecha: Nace sobre el texto y asciende apuntando a los ingredientes de la pizza -->
        <img 
          src="/assets/arrow3.svg" 
          alt="Flecha ingredientes" 
          class="w-[92px] h-auto mb-1 -ml-3 pointer-events-none scale-x-[-1]"
        />
        <h3 class="font-sans text-[14px] font-bold text-[#1B1C1A] leading-tight tracking-tight">
          Los mejores<br/>ingredientes de<br/>proximidad
        </h3>
        <p class="font-sans text-[9.5px] text-[#424842] mt-0.5 leading-snug">
          Tomate San Marzano D.O.P. y mozzarella fresca.
        </p>
      </div>

      <!-- 4. Callout 3 (Abajo a la Izquierda): Preparación Tradicional -->
      <div class="absolute top-[315px] left-3 max-w-[150px] text-left z-10">
        <!-- Flecha: Nace sobre el texto y asciende hacia la base de la pizza -->
        <img 
          src="/assets/arrow3.svg" 
          alt="Flecha preparación" 
          class="w-[92px] h-auto mb-1 ml-6 pointer-events-none" 
        />
        <div class="flex items-center gap-1 mb-0.5">
          <h3 class="font-sans text-[14px] font-bold text-[#1B1C1A] leading-tight tracking-tight">
            Preparación<br/>Tradicional
          </h3>
          <img 
            src="/assets/flash.svg" 
            alt="Destellos preparación artesanal" 
            class="w-4 h-auto mb-2 pointer-events-none" 
          />
        </div>
        <p class="font-sans text-[9.5px] text-[#424842] mt-0.5 leading-snug">
          Amasado manual y leña viva a 450°C.
        </p>
      </div>

    </div>

  </div>
</section>
