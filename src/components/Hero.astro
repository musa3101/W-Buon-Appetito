---
import HeroActions from './ui/HeroActions';
---

<!-- ======================================================== -->
<!-- 2. FULL-BLEED HERO SECTION (Inspirado fielmente en Arko) -->
<!-- ======================================================== -->
<section id="inicio" class="hero-fullscreen relative w-full flex flex-col justify-end items-center overflow-hidden">
  
  <!-- Background Video Unificado con Fuentes Responsivas (1 solo reproductor para evitar bloqueo nativo de Safari) -->
  <video
    id="hero-bg-video"
    autoplay
    loop
    muted
    playsinline
    webkit-playsinline
    disablePictureInPicture
    disableremoteplayback
    preload="auto"
    class="absolute inset-0 w-full h-full object-cover object-center brightness-[0.9] pointer-events-none"
  >
    <!-- Desktop y Tablets (>=768px): Vídeo panorámico 16:9 con fondo atmosférico suave -->
    <source src="/assets/hero/Hero_Andratx_Desktop.mp4" type="video/mp4" media="(min-width: 768px)" />
    <!-- Móviles (<768px): Vídeo vertical original nativo sin pérdida -->
    <source src="/assets/hero/Hero_Andratx_Final.mp4" type="video/mp4" />
  </video>

  <!-- Cinematic Gradients estilo Arko: velo sutil general para contraste sin comerse el vídeo -->
  <div aria-hidden="true" class="absolute inset-0 bg-black/20 pointer-events-none"></div>
  <!-- Sombra superior muy recortada (solo bajo el header para contraste fino de logo y menú) -->
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-black/40 via-black/10 to-transparent pointer-events-none"></div>
  <!-- Efecto ambiental inferior verde oliva: sutil y compacto bajo la barra de Safari -->
  <div 
    aria-hidden="true" 
    class="hero-bottom-fade absolute inset-x-0 bottom-0 pointer-events-none" 
  ></div>

  <!-- Hero Content Center-Bottom: Minimalista y Despejado con respiración amplia -->
  <div class="relative z-10 max-w-3xl mx-auto px-4 text-center space-y-3 sm:space-y-6">
    
    <!-- Eyebrow: Ubicación exacta como en Arko (letras sutiles que ceden todo el protagonismo al vídeo) -->
    <p data-i18n="hero_location" class="font-['Questrial',sans-serif] text-[9.5px] sm:text-[11px] md:text-xs tracking-[0.28em] uppercase text-[#EFE8DD] drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]">
      AV. MATEO BOSCH 24 · PORT D'ANDRATX
    </p>

    <!-- Main Editorial Headline: Cormorant Garamond Light (más esbelta y delicada como en Arko) -->
    <h1 class="font-['Cormorant_Garamond',Georgia,serif] text-2xl sm:text-4xl md:text-[42px] font-light tracking-[0.015em] text-center leading-[1.18] max-w-xs sm:max-w-xl mx-auto text-[#FFFFFF] drop-shadow-[0_3px_18px_rgba(0,0,0,0.95)]">
      <span data-i18n="hero_title_part1">Cocina mediterránea</span><br /><span data-i18n="hero_title_part2">con alma italiana</span>
    </h1>

    <!-- 2 Rounded Pill CTAs con efecto Liquid Glass (21st.dev) con holgura para respirar -->
    <div id="hero-action-buttons" class="pt-1 sm:pt-4">
      <HeroActions client:load />
    </div>

  </div>
</section>

<style>
  /* Altura: asegura que el Hero cubra toda la pantalla móvil sin que asome 'Nuestra Esencia' por debajo */
  .hero-fullscreen {
    height: 100vh;
    height: 100lvh;
    min-height: 100vh;
    min-height: calc(100svh + env(safe-area-inset-bottom, 0px) + 80px);
    /* Posición de los botones: descansan con holgura por encima de la barra de navegación de Safari */
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 5.5rem);
  }

  /* Degradado verde ambiental inferior: difuminación suave idéntica al header pero invertida */
  .hero-bottom-fade {
    height: calc(env(safe-area-inset-bottom, 0px) + 90px);
    background: linear-gradient(to top, rgba(24, 51, 33, 0.70) 0%, rgba(24, 51, 33, 0.30) 50%, transparent 100%);
  }

  @media (min-width: 640px) {
    .hero-fullscreen { 
      min-height: 600px;
      padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 4rem); 
    }
    .hero-bottom-fade { height: 4rem; }
  }

  @media (min-width: 768px) {
    .hero-fullscreen { padding-bottom: 5.5rem; }
  }

  /* Ocultación radical de cualquier control o botón de reproducción nativo de WebKit/Safari */
  #hero-bg-video::-webkit-media-controls,
  #hero-bg-video::-webkit-media-controls-panel,
  #hero-bg-video::-webkit-media-controls-play-button,
  #hero-bg-video::-webkit-media-controls-start-playback-button,
  #hero-bg-video::-webkit-media-controls-overlay-play-button,
  #hero-bg-video::-webkit-media-controls-enclosure {
    display: none !important;
    -webkit-appearance: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>

<script>
  // Garantizar reproducción continua e incondicional en Safari y Chromium
  const heroVideo = document.getElementById('hero-bg-video') as HTMLVideoElement | null;
  if (heroVideo) {
    heroVideo.muted = true;
    heroVideo.defaultMuted = true;
    (heroVideo as any).playsInline = true;

    const playVideo = () => {
      if (heroVideo.paused) {
        const promise = heroVideo.play();
        if (promise !== undefined) {
          promise.catch(() => {
            const unlockTouch = () => {
              heroVideo.play().catch(() => {});
              window.removeEventListener('touchstart', unlockTouch);
              window.removeEventListener('scroll', unlockTouch);
              window.removeEventListener('pointerdown', unlockTouch);
            };
            window.addEventListener('touchstart', unlockTouch, { passive: true, once: true });
            window.addEventListener('scroll', unlockTouch, { passive: true, once: true });
            window.addEventListener('pointerdown', unlockTouch, { passive: true, once: true });
          });
        }
      }
    };

    playVideo();
    heroVideo.addEventListener('loadedmetadata', playVideo, { once: true });
    heroVideo.addEventListener('canplay', playVideo, { once: true });
    heroVideo.addEventListener('ended', playVideo);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) playVideo();
    });
    window.addEventListener('pageshow', playVideo);
  }
</script>
