<!-- ======================================================== -->
<!-- 2. FULL-BLEED 100VH HERO SECTION (Inspirado en Arko)      -->
<!-- ======================================================== -->
<section id="inicio" class="relative h-screen min-h-[600px] sm:min-h-[700px] w-full flex flex-col justify-end items-center pb-16 sm:pb-28 overflow-hidden">
  <!-- Edge-to-edge Photography Background -->
  <img 
    src="https://lh3.googleusercontent.com/aida/AEtjO1V9Gtc5wtktuFgluQSqMDbV1FLpQaIhYdUzvqpvq79Z0xkc8x0he0Gdhy6vd280tY70VPjLURQaN540HsJ2C0RJAOATdOLFCuVRIXpj7SNVO2n-YKlkgqWC3sEJ0E31qI4fC__lpGMoCuS95zWnXoU9m-kh87cF5XYh3y3exyg7_PFOJIm1hkJEO6OVdnu6VOBmx86pLqW7Y5SRR-LuBo_WXxUbAhT1huAc4QPz7l3IFChCk_-1AisWhg" 
    alt="Buon Appetito Restaurante Mediterráneo y Pizzería Artesanal" 
    class="absolute inset-0 w-full h-full object-cover object-center transform scale-105 transition-transform duration-1000 ease-out"
  />

  <!-- Cinematic Warm Overlays for Contrast -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
  <div class="absolute inset-0 bg-radial from-transparent via-transparent to-black/40"></div>

  <!-- Hero Content Center-Bottom -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-5 sm:space-y-6">
    
    <!-- Micro Tagline / Provenance -->
    <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1 sm:py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white/90 text-xs sm:text-sm tracking-[0.22em] sm:tracking-[0.25em] uppercase font-medium">
      <span>Port d'Andratx</span>
      <span class="text-white/40">&bull;</span>
      <span>Mallorca</span>
    </div>

    <!-- Main Editorial Headline -->
    <h1 class="font-serif text-3xl sm:text-5xl md:text-7xl lg:text-8xl text-white font-normal tracking-tight leading-[1.12] sm:leading-[1.08] drop-shadow-xl">
      Cocina mediterránea con alma italiana
    </h1>

    <!-- 2 Rounded Pill CTAs (Inspired by ARKO reference) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 sm:pt-6">
      <!-- Button 1: Reservar Mesa -->
      <a 
        href="#donde-estamos" 
        class="w-full sm:w-auto inline-flex items-center justify-center bg-[#FBF9F5] hover:bg-white text-[#183321] px-8 py-3.5 rounded-full font-semibold text-xs sm:text-sm tracking-wider uppercase transition-all duration-300 shadow-xl hover:shadow-2xl hover:scale-105 active:scale-95 cursor-pointer"
      >
        RESERVAR MESA
      </a>

      <!-- Button 2: Ver Menú -->
      <a 
        href="#menu" 
        class="w-full sm:w-auto inline-flex items-center justify-center bg-white/15 hover:bg-white/25 text-white backdrop-blur-md border border-white/30 px-8 py-3.5 rounded-full font-semibold text-xs sm:text-sm tracking-wider uppercase transition-all duration-300 shadow-lg hover:scale-105 active:scale-95 cursor-pointer"
      >
        VER MENÚ
      </a>
    </div>

  </div>

  <!-- Smooth Downward Scroll Indicator -->
  <a href="#sobre-nosotros" class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 text-white/60 hover:text-white transition-colors animate-bounce-slow" aria-label="Ir a Sobre Nosotros">
    <span class="material-symbols-outlined text-2xl">arrow_downward</span>
  </a>
</section>
