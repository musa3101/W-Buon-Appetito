<!-- ======================================================== -->
<!-- 3. SOBRE NOSOTROS (Spacious & Breathing Layout)          -->
<!-- ======================================================== -->
<section class="py-20 md:py-36 bg-[#FBF9F5] border-b border-[#D9D4CC]/30" id="sobre-nosotros">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-center">
      
      <!-- Left Column: Story & Craft -->
      <div class="lg:col-span-6 space-y-6 sm:space-y-8">
        <div>
          <span class="text-xs font-semibold text-[#9E4221] uppercase tracking-[0.25em]">Nuestra Esencia</span>
          <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#183321] font-normal tracking-tight mt-3">
            El arte de la paciencia y el fuego
          </h2>
        </div>

        <p class="font-sans text-[#424842] text-sm sm:text-lg leading-relaxed">
          En Buon Appetito entendemos la gastronomía como un ritual de respeto por el producto y el tiempo. Nuestra masa descansa un mínimo de 48 horas utilizando harina de fuerza italiana y levadura madre viva, logrando una digestión ligera y una textura alveolada inconfundible.
        </p>

        <p class="font-sans text-[#424842] text-sm sm:text-lg leading-relaxed">
          Horneamos exclusivamente con leña de encina en hornos refractarios construidos por maestros napolitanos, mientras nuestros platos principales celebran la frescura diaria del mar y las huertas locales del litoral.
        </p>

        <!-- 3 Stats Pillars -->
        <div class="grid grid-cols-3 gap-3 sm:gap-6 pt-6 sm:pt-8 border-t border-[#D9D4CC]/30">
          <div>
            <p class="font-serif text-2xl sm:text-4xl text-[#9E4221] font-normal">48h</p>
            <p class="font-sans text-[11px] sm:text-sm text-[#424842] mt-1">Fermentación lenta</p>
          </div>
          <div>
            <p class="font-serif text-2xl sm:text-4xl text-[#9E4221] font-normal">100%</p>
            <p class="font-sans text-[11px] sm:text-sm text-[#424842] mt-1">Producto italiano</p>
          </div>
          <div>
            <p class="font-serif text-2xl sm:text-4xl text-[#9E4221] font-normal">500°C</p>
            <p class="font-sans text-[11px] sm:text-sm text-[#424842] mt-1">Fuego de leña pura</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Editorial Atmosphere Visuals -->
      <div class="lg:col-span-6 grid grid-cols-2 gap-5 sm:gap-6">
        <div class="space-y-5">
          <div class="overflow-hidden rounded-2xl shadow-lg border border-[#D9D4CC]/30 bg-[#F5EFEB]">
            <img 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAyxsJ48IdjOurDBe-qZXUiX-yzgJDbZ7gLz3LmMFfQqyz0qaFjfiPC9X8yhL4pVt1j3OD4cjCed-4JcGKY5jC5jr8WtxfBmGiNNdhT6TWIh328kTRYXILR6CG8t867E1C7iLnmaALJXXiaDOOzylveF6EicIQFoMGOV8WM4dcOwXO18y6OUi8bgURZvKx2kksIJVLruQb7ZGazpq4CxHWmrXKMGk6YiwhtmQaaek6YcHE4TTcIJjPaX7sdzr95lr4_i3iiWrU8ow" 
              alt="Maestro pizzaiolo en el horno de leña" 
              class="w-full h-64 sm:h-80 object-cover hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
        </div>
        <div class="space-y-5 pt-8 sm:pt-12">
          <div class="overflow-hidden rounded-2xl shadow-lg border border-[#D9D4CC]/30 bg-[#F5EFEB]">
            <img 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuB9vpe2Jq5_bVexaHqSP3f7xhio7TRlpD_Tfdc13MlY4_jnyDwuId0H3__dI58i9zKSsrLHhRL5DiYnTcvTFVYQfdXupLdo3_o2_liY80rEympiceWB-GsSFYMBtqpUNUSoLmbrdduGUnEx5Ur-N_jwaSxpLwpUDGP29u92nazQlcD3GUHEdY8B8kGli_VcXViyQyobFs7WbAdg_K0cfJ3Khm1oO6L5gy8nUHFdx2ZMYXUA3YAoML6FndMXoMZS-08RebvB35dpbw" 
              alt="Terraza mediterránea con luz dorada" 
              class="w-full h-64 sm:h-80 object-cover hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
