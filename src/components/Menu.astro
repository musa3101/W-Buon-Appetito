---
import PolaroidLineCarousel from './ui/polaroid-line-carousel';
---

<!-- ======================================================== -->
<!-- 5. MENÚ (Gastronomía Artesanal, Galería & PDFs)          -->
<!-- ======================================================== -->
<section class="py-20 sm:py-28 md:py-36 bg-[#FBF9F5] border-b border-[#D9D4CC]/30 overflow-hidden" id="menu">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
    
    <!-- Title & Subtitle at Top -->
    <div class="text-center max-w-3xl mx-auto space-y-3 sm:space-y-4 mb-3 sm:mb-6">
      <span class="text-xs font-semibold text-[#9E4221] uppercase tracking-[0.25em]">Gastronomía Artesanal</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#183321] font-semibold tracking-tight">
        Nuestra Carta &amp; Especialidades
      </h2>
      <p class="font-sans text-[#424842] text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
        Tradición ítalo-mediterránea en cada plato. Desde nuestro clásico Vitello Tonnato y pastas con trufa fresca, hasta rodaballo a la plancha y paellas marineras.
      </p>
    </div>

    <!-- Polaroid Line Carousel: Instant photos on hanging sagging line with physics swing -->
    <div class="relative w-full mb-6 sm:mb-10 overflow-hidden">
      <PolaroidLineCarousel client:visible />
    </div>

    <!-- Buttons: Bottom PDF Links for Food and Wine -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 pt-4">
      <!-- Button 1: Carta de Comida -->
      <a 
        href="#donde-estamos" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-[#183321] hover:bg-[#2E4A36] text-white px-8 py-3.5 rounded-full font-semibold text-xs tracking-wider uppercase transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5 active:scale-95 cursor-pointer"
      >
        <svg class="w-4 h-4 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>Carta de Comida (PDF)</span>
        <svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </a>

      <!-- Button 2: Carta de Vinos y Bebidas -->
      <a 
        href="#donde-estamos" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-[#9E4221] hover:bg-[#C45E3B] text-white px-8 py-3.5 rounded-full font-semibold text-xs tracking-wider uppercase transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5 active:scale-95 cursor-pointer"
      >
        <svg class="w-4 h-4 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <span>Vinos y Bodega (PDF)</span>
        <svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </a>
    </div>

  </div>
</section>
