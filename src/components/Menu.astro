---
import PolaroidLineCarousel from './ui/polaroid-line-carousel';
import { ShimmerButton } from './ui/shimmer-button';
---

<!-- ======================================================== -->
<!-- 5. MENÚ (Gastronomía Artesanal, Galería & PDFs)          -->
<!-- ======================================================== -->
<section class="py-20 sm:py-28 md:py-36 bg-[#FBF9F5] border-b border-[#D9D4CC]/30 overflow-hidden" id="menu">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
    
    <!-- Title & Subtitle at Top -->
    <div class="text-center max-w-3xl mx-auto space-y-3 sm:space-y-4 mb-4 sm:mb-6">
      <span data-i18n="menu_eyebrow" class="text-xs font-semibold text-[#9E4221] uppercase tracking-[0.25em]">Gastronomía Artesanal</span>
      <h2 data-i18n="menu_title" class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#183321] font-semibold tracking-tight">
        Nuestra Carta &amp; Especialidades
      </h2>
      <p data-i18n="menu_desc" class="font-sans text-[#424842] text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
        Tradición ítalo-mediterránea en cada creación. Desde ensaladas frescas y pastas con trufa negra, hasta pizzas al horno de leña, cortes nobles a la brasa y postres de la casa.
      </p>
    </div>

    <!-- Polaroid Line Carousel: Instant photos on hanging sagging line with physics swing -->
    <div class="relative w-full mb-6 sm:mb-10 overflow-hidden">
      <PolaroidLineCarousel client:load />
    </div>

    <!-- Buttons: Food Menu & Wine Cellar with ShimmerButton (21st.dev) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 pt-4">
      <!-- Button 1: Carta de Comida (Activo -> /carta) -->
      <ShimmerButton 
        client:load
        href="/carta"
        background="#183321"
        shimmerColor="#FFFFFF"
        shimmerDuration="3s"
        borderRadius="100px"
        className="shadow-xl shadow-[#183321]/20 w-full sm:w-auto"
        title="Ver Carta Digital Oficial"
      >
        <svg class="w-4 h-4 text-white/95" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
          <path d="M7 2v20"/>
          <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
        </svg>
        <span data-i18n="menu_btn_food">Carta de Comida</span>
      </ShimmerButton>

      <!-- Button 2: Carta de Vinos y Bodega (Abre la carta digital de vinos y bebidas) -->
      <ShimmerButton 
        client:load
        href="/vinos"
        background="#9E4221"
        shimmerColor="#FED7AA"
        shimmerDuration="3s"
        borderRadius="100px"
        className="shadow-xl shadow-[#9E4221]/20 w-full sm:w-auto"
        title="Ver carta de vinos, coctelería y bebidas"
      >
        <svg class="w-4 h-4 text-white/95" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 22h8"/>
          <path d="M7 10h10"/>
          <path d="M12 15v7"/>
          <path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5Z"/>
        </svg>
        <span data-i18n="menu_btn_wine">Vinos y Bodega</span>
      </ShimmerButton>
    </div>

  </div>
</section>
