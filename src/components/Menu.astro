---
import PolaroidLineCarousel from './ui/polaroid-line-carousel';
---

<!-- ======================================================== -->
<!-- 5. MENÚ (Gastronomía Artesanal, Galería & PDFs)          -->
<!-- ======================================================== -->
<section class="py-20 sm:py-28 md:py-36 bg-[#FBF9F5] border-b border-[#D9D4CC]/30 overflow-hidden" id="menu">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
    
    <!-- Title & Subtitle at Top -->
    <div class="text-center max-w-3xl mx-auto space-y-3 sm:space-y-4 mb-4 sm:mb-6">
      <span class="text-xs font-semibold text-[#9E4221] uppercase tracking-[0.25em]">Gastronomía Artesanal</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#183321] font-semibold tracking-tight">
        Nuestra Carta &amp; Especialidades
      </h2>
      <p class="font-sans text-[#424842] text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
        Tradición ítalo-mediterránea en cada creación. Desde ensaladas frescas y pastas con trufa negra, hasta pizzas al horno de leña, cortes nobles a la brasa y postres de la casa.
      </p>
    </div>

    <!-- Polaroid Line Carousel: Instant photos on hanging sagging line with physics swing -->
    <div class="relative w-full mb-6 sm:mb-10 overflow-hidden">
      <PolaroidLineCarousel client:visible />
    </div>

    <!-- Buttons: Food Menu & Wine Cellar -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 pt-4">
      <!-- Button 1: Carta de Comida (Activo -> /carta) -->
      <a 
        href="/carta" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-[#183321] hover:bg-[#2E4A36] text-white px-8 py-3.5 rounded-full font-semibold text-xs tracking-wider uppercase transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5 active:scale-95 cursor-pointer"
        title="Ver Carta Digital Oficial"
      >
        <!-- Icono gastronómico refinado: Tenedor y Cuchillo de Restaurante -->
        <svg class="w-4 h-4 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
          <path d="M7 2v20"/>
          <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
        </svg>
        <span>Carta de Comida</span>
      </a>

      <!-- Button 2: Carta de Vinos y Bodega (Disponible en sala) -->
      <div class="relative group w-full sm:w-auto">
        <button 
          type="button" 
          id="btn-bodega-info"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-[#9E4221] hover:bg-[#B34E2A] text-white px-8 py-3.5 rounded-full font-semibold text-xs tracking-wider uppercase transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5 active:scale-95 cursor-pointer"
          title="Carta de bodega y vinos disponible directamente en mesa"
        >
          <!-- Copa de vino elegante de sumiller (sin frasco de laboratorio) -->
          <svg class="w-4 h-4 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 22h8"/>
            <path d="M7 10h10"/>
            <path d="M12 15v7"/>
            <path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5Z"/>
          </svg>
          <span>Vinos y Bodega</span>
          <span class="text-[9px] uppercase tracking-wider bg-white/20 text-white/95 px-2 py-0.5 rounded-full font-medium ml-0.5">En sala</span>
        </button>

        <!-- Mensaje informativo flotante al pulsar -->
        <div 
          id="bodega-toast"
          class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2.5 w-max max-w-[280px] bg-[#183321] text-[#FAF7F2] text-[11px] font-medium py-2 px-3.5 rounded-xl shadow-2xl border border-white/10 opacity-0 pointer-events-none transition-all duration-300 transform translate-y-1 text-center z-30"
          role="status"
        >
          🍷 Nuestra carta de vinos y bodega se presenta directamente en sala
        </div>
      </div>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const wineBtn = document.getElementById('btn-bodega-info');
        const wineToast = document.getElementById('bodega-toast');
        if (wineBtn && wineToast) {
          wineBtn.addEventListener('click', () => {
            wineToast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-1');
            wineToast.classList.add('opacity-100', 'translate-y-0');
            clearTimeout(window.__wineToastTimeout);
            window.__wineToastTimeout = setTimeout(() => {
              wineToast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-1');
              wineToast.classList.remove('opacity-100', 'translate-y-0');
            }, 3000);
          });
        }
      });
    </script>

  </div>
</section>
