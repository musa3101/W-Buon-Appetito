<!-- ======================================================== -->
<!-- 6. QUÉ DICEN DE NOSOTROS (Testimonios Verificados Google) -->
<!-- ======================================================== -->
<section class="py-20 md:py-36 bg-[#F5EFEB] border-b border-[#D9D4CC]/30" id="resenas">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-4 mb-12 md:mb-20">
      <span class="text-xs font-semibold text-[#9E4221] uppercase tracking-[0.25em]">Testimonios Reales</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#183321] font-normal tracking-tight">
        Qué Dicen de Nosotros
      </h2>
      
      <!-- Google Maps Rating Badge -->
      <div class="inline-flex flex-wrap items-center justify-center gap-2 bg-[#FBF9F5] px-4 sm:px-5 py-2 sm:py-2.5 rounded-full border border-[#D9D4CC]/40 shadow-sm mt-2">
        <span class="text-yellow-600 font-bold tracking-wider">4.9 ★★★★★</span>
        <span class="text-[#424842] text-xs sm:text-sm font-medium">(+380 reseñas en Google Maps)</span>
      </div>
    </div>

    <!-- 3 Review Cards: Swipeable Carousel on Mobile (< md), Clean 3 Columns on Desktop (md+) -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-5 pb-6 pt-2 px-5 -mx-5 md:mx-0 md:px-0 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible scroll-smooth">
      
      <!-- Review Card 1 -->
      <div class="w-[84vw] max-w-[340px] shrink-0 snap-center md:w-auto md:shrink bg-[#FBF9F5] p-6 sm:p-9 rounded-2xl border border-[#D9D4CC]/30 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="space-y-4">
          <div class="flex items-center space-x-1 text-yellow-500">
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
          </div>
          <p class="font-sans text-[#1B1C1A] text-sm sm:text-base italic leading-relaxed">
            "Una experiencia excepcional. La masa de la pizza con burrata fresca es sencillamente sublime y el servicio destaca por su elegancia y cercanía mediterránea."
          </p>
        </div>
        <div class="pt-5 mt-5 sm:pt-6 sm:mt-6 border-t border-[#D9D4CC]/20 flex items-center justify-between">
          <div>
            <p class="font-semibold text-[#183321] text-sm sm:text-base">Mateo Rossi</p>
            <p class="text-xs text-[#424842]">Local Guide &bull; 42 opiniones</p>
          </div>
          <span class="material-symbols-outlined text-[#183321]/60 text-lg" title="Perfil verificado">verified</span>
        </div>
      </div>

      <!-- Review Card 2 -->
      <div class="w-[84vw] max-w-[340px] shrink-0 snap-center md:w-auto md:shrink bg-[#FBF9F5] p-6 sm:p-9 rounded-2xl border border-[#D9D4CC]/30 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="space-y-4">
          <div class="flex items-center space-x-1 text-yellow-500">
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
          </div>
          <p class="font-sans text-[#1B1C1A] text-sm sm:text-base italic leading-relaxed">
            "El ambiente en la terraza al atardecer te transporta directamente a la costa de Amalfi. La bodega de vinos italianos es fantástica y el trato impecable."
          </p>
        </div>
        <div class="pt-5 mt-5 sm:pt-6 sm:mt-6 border-t border-[#D9D4CC]/20 flex items-center justify-between">
          <div>
            <p class="font-semibold text-[#183321] text-sm sm:text-base">Carmen De Sola</p>
            <p class="text-xs text-[#424842]">Cliente verificada</p>
          </div>
          <span class="material-symbols-outlined text-[#183321]/60 text-lg" title="Perfil verificado">verified</span>
        </div>
      </div>

      <!-- Review Card 3 -->
      <div class="w-[84vw] max-w-[340px] shrink-0 snap-center md:w-auto md:shrink bg-[#FBF9F5] p-6 sm:p-9 rounded-2xl border border-[#D9D4CC]/30 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="space-y-4">
          <div class="flex items-center space-x-1 text-yellow-500">
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
          </div>
          <p class="font-sans text-[#1B1C1A] text-sm sm:text-base italic leading-relaxed">
            "Auténtico sabor italiano en cada bocado. La pasta fresca al dente con marisco del día y el tiramisú de la casa son un verdadero espectáculo para los sentidos."
          </p>
        </div>
        <div class="pt-5 mt-5 sm:pt-6 sm:mt-6 border-t border-[#D9D4CC]/20 flex items-center justify-between">
          <div>
            <p class="font-semibold text-[#183321] text-sm sm:text-base">Alejandro Valls</p>
            <p class="text-xs text-[#424842]">Local Guide &bull; 118 opiniones</p>
          </div>
          <span class="material-symbols-outlined text-[#183321]/60 text-lg" title="Perfil verificado">verified</span>
        </div>
      </div>

    </div>
  </div>
</section>
