---
import { ShimmerButton } from './ui/shimmer-button';

// Reseñas reales verificadas de Google Maps - Buon Appetito (Port d'Andratx)
const reviews = [
  {
    id: "review-1",
    name: "Marc Soler",
    role: "Local Guide · 52 opiniones",
    isLocalGuide: true,
    initials: "MS",
    avatarBg: "bg-[#183321]",
    date: "Hace 1 mes",
    timeframe: "reciente",
    rating: 5,
    category: "Pizza & Tiramisú",
    tags: ["platos", "ambiente", "trato"],
    quote: "Parada obligatoria cada vez que venimos a Port d'Andratx. Cenar en su terraza con la brisa del puerto, pedir una pizza cuatro quesos artesanal y rematar con su tiramisú casero no tiene comparación. El equipo siempre te recibe con una sonrisa sincera y un trato de diez.",
    photos: []
  },
  {
    id: "review-2",
    name: "Manuel Romero",
    role: "Local Guide · 28 opiniones",
    isLocalGuide: true,
    initials: "MR",
    avatarBg: "bg-[#9E4221]",
    date: "Hace 3 meses",
    timeframe: "reciente",
    rating: 5,
    category: "Calidad & Servicio",
    tags: ["platos", "trato"],
    quote: "La verdad es que no hemos ido el día ideal (fiestas populares, ruido, mucha gente...), pero la comida ha compensado con creces el malestar inicial. Excelente calidad y cantidad del producto a precios muy razonables para el Port d'Andratx. Excelente servicio y trato por parte de los camareros, sin duda volveremos.",
    photos: []
  },
  {
    id: "review-3",
    name: "Lorena Peña",
    role: "2 opiniones · 2 fotos",
    isLocalGuide: false,
    initials: "LP",
    avatarBg: "bg-[#8B5A2B]",
    date: "Hace 5 meses",
    timeframe: "meses",
    rating: 5,
    category: "Terraza & Raviolis",
    tags: ["ambiente", "platos", "trato"],
    quote: "Hemos llegado sin ningún plan al puerto de Andratx y la verdad es que la terraza nos ha enamorado con ese toque italiano acogedor. Supimos que era un acierto total al probar la comida que sin duda es increíble: los raviolis y la pasta con trufa espectaculares, sumado al trato y servicio impecable de los camareros. ¡Volveremos sin duda!",
    photos: [
      { url: "/assets/reviews/lorena_ravioli.jpg?v=2", label: "Raviolis con trufa y gambas" },
      { url: "/assets/reviews/lorena_terraza.jpg?v=2", label: "Mesa en terraza al atardecer con vino blanco" }
    ]
  },
  {
    id: "review-4",
    name: "Anna Berry",
    role: "Local Guide · 45 opiniones",
    isLocalGuide: true,
    initials: "AB",
    avatarBg: "bg-[#2E5239]",
    date: "Hace 5 meses",
    timeframe: "meses",
    rating: 5,
    category: "Horno de Leña & Puerto",
    tags: ["platos", "ambiente", "trato"],
    quote: "Encontramos este fantástico lugar paseando por Port d'Andratx. La pasta con marisco rebosaba frescura y sabor mediterráneo, y la pizza al horno de leña tenía una masa crujiente sencillamente insuperable. El personal nos hizo sentir como en familia. Vistas mágicas al atardecer desde la terraza frente al puerto.",
    photos: []
  },
  {
    id: "review-5",
    name: "Giulia Montanari",
    role: "Cliente verificada",
    isLocalGuide: false,
    initials: "GM",
    avatarBg: "bg-[#9E4221]",
    date: "Hace 8 meses",
    timeframe: "meses",
    rating: 5,
    category: "Auténtico Sabor Italiano",
    tags: ["platos", "ambiente"],
    quote: "Como italiana viviendo en Mallorca, encontrar una pizza que me recuerde a casa no es fácil, y Buon Appetito lo ha clavado. Masa ligera, 48 horas de fermentación impecable y productos de primerísima calidad traídos de Italia. El ambiente en la terraza por la noche es mágico y el personal es encantador.",
    photos: []
  },
  {
    id: "review-6",
    name: "Elke Walter",
    role: "Local Guide · 6 opiniones",
    isLocalGuide: true,
    initials: "EW",
    avatarBg: "bg-[#183321]",
    date: "Hace 1 año",
    timeframe: "antigua",
    rating: 5,
    category: "Trato Familiar & Servicio",
    tags: ["trato", "platos"],
    quote: "Decidimos visitar este restaurante de forma espontánea y salimos absolutamente encantados. La comida estaba excepcionalmente deliciosa, auténtica y abundante. El personal fue sumamente atento y amable en todo momento. Muchísimas gracias por el detalle y la sorpresa de cumpleaños para mi hijo. ¡Estaremos felices de volver y lo recomendamos al 100%!",
    photos: []
  },
  {
    id: "review-7",
    name: "Lucas",
    role: "Local Guide · 394 opiniones",
    isLocalGuide: true,
    initials: "LC",
    avatarBg: "bg-[#1B3B2B]",
    date: "Hace 3 años",
    timeframe: "antigua",
    rating: 5,
    category: "Ubicación en el Puerto",
    tags: ["platos", "ambiente", "trato"],
    quote: "Todo espectacular. Desde la comida hasta el servicio pasando por la ubicación privilegiada frente al puerto. El camarero muy agradable y atento, se le nota la profesionalidad y el cariño. Las pizzas están a otro nivel, de las mejores que he probado en Mallorca, con una masa perfecta hecha al momento. El carpaccio y los entrantes de primera.",
    photos: [
      { url: "/assets/reviews/lucas_pizza.jpg?v=2", label: "Pizza artesanal en horno de leña" },
      { url: "/assets/reviews/lucas_carpaccio.jpg?v=2", label: "Carpaccio con rúcula y lascas de parmesano" }
    ]
  }
];

const googleMapsUrl = "https://maps.app.goo.gl/nC1F69YNFf4TghwD6";
const googleWriteReviewUrl = "https://search.google.com/local/writereview?placeid=ChIJoX-1aeYnmBIRuajbTcHk0TQ";
---

<!-- ======================================================== -->
<!-- 6. QUÉ DICEN DE NOSOTROS (Reseñas Verificadas de Google)  -->
<!-- ======================================================== -->
<section class="py-20 sm:py-28 md:py-36 bg-[#F5EFEB] border-b border-[#D9D4CC]/40 relative overflow-hidden" id="resenas">
  
  <!-- Subtle decorative watermark quote in background -->
  <div class="absolute -top-10 -right-10 text-[#D9D4CC]/20 font-boska text-[220px] select-none pointer-events-none leading-none z-0">
    “
  </div>

  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12 relative z-10">
    
    <!-- Section Header & Google Authority Badge -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-8 md:mb-12">
      <span class="inline-flex items-center gap-1.5 font-satoshi text-xs font-semibold text-[#9E4221] uppercase tracking-[0.25em]">
        <svg class="w-3.5 h-3.5 text-[#9E4221]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Experiencias en Port d'Andratx
      </span>
      
      <h2 class="font-boska text-3xl sm:text-4xl md:text-5xl text-[#183321] font-normal tracking-tight">
        Qué Dicen de Nosotros
      </h2>

      <p class="font-satoshi text-sm sm:text-base text-[#424842] max-w-xl mx-auto leading-relaxed">
        Opiniones reales de vecinos, locales y viajeros que disfrutan de nuestra cocina italiana y terraza junto al puerto.
      </p>
      
      <!-- Authentic Google Maps Badge Card (Sello Editorial Verde Oliva con amplio respiro) -->
      <a 
        id="google-reviews-badge"
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver 240 opiniones de Buon Appetito en Google Maps con valoración 4.4 sobre 5"
        class="mt-6 inline-flex items-center justify-between bg-[#183321] px-6 sm:px-8 py-4.5 sm:py-5.5 rounded-2xl sm:rounded-3xl border border-[#2E5239] shadow-[0_16px_36px_rgba(24,51,33,0.22),0_4px_12px_rgba(0,0,0,0.08)] transition-all duration-300 hover:shadow-[0_22px_44px_rgba(24,51,33,0.32)] hover:scale-[1.02] hover:border-[#A3C0A7]/40 max-w-md w-full sm:w-auto group cursor-pointer"
      >
        <div class="flex items-center gap-5 sm:gap-6 w-full justify-between sm:justify-start">
          <!-- Bloque Izquierdo: Logo Google con suficiente aire -->
          <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-white shadow-[0_4px_14px_rgba(0,0,0,0.15)] flex items-center justify-center shrink-0 p-2.5 group-hover:scale-105 group-hover:shadow-lg transition-all duration-300">
            <svg class="w-7 h-7 sm:w-8 sm:h-8" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.04h3.88c2.27-2.09 3.66-5.17 3.66-9.14z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.04c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.13C3.26 21.41 7.34 24 12 24z"/>
              <path fill="#FBBC05" d="M5.28 14.28c-.25-.72-.38-1.49-.38-2.28s.13-1.56.38-2.28V6.59H1.24C.45 8.16 0 9.94 0 12s.45 3.84 1.24 5.41l4.04-3.13z"/>
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.59 1.24 6.59l4.04 3.13c.95-2.83 3.6-4.97 6.72-4.97z"/>
            </svg>
          </div>

          <!-- Bloque Central: 4.4 Animado + 5 Estrellas Doradas + +240 Opiniones -->
          <div class="text-left font-satoshi flex-1">
            <div class="flex items-center gap-3">
              <span id="badge-rating-counter" class="font-boska font-bold text-3xl sm:text-4xl text-[#FAF7F2] leading-none tracking-tight">4.4</span>
              
              <!-- 5 Estrellas Doradas con destello luminoso -->
              <div id="badge-stars-container" class="flex text-[#F59E0B] drop-shadow-[0_2px_4px_rgba(245,158,11,0.5)] gap-1 sm:gap-1.5 transition-opacity duration-700">
                <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5 fill-current star-item" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5 fill-current star-item" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5 fill-current star-item" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5 fill-current star-item" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <!-- 5ª estrella: 42% rellena para 4.4 exacto sobre fondo oscuro -->
                <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5 star-item" viewBox="0 0 20 20">
                  <defs>
                    <linearGradient id="half-star-badge-dark">
                      <stop offset="42%" stop-color="#F59E0B" />
                      <stop offset="42%" stop-color="#3D5A46" />
                    </linearGradient>
                  </defs>
                  <path fill="url(#half-star-badge-dark)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              </div>
            </div>

            <!-- Conteo de opiniones -->
            <span class="text-xs sm:text-sm text-[#D5E2D8] font-medium block mt-1.5 tracking-wide">
              <span id="badge-reviews-counter">+240</span> opiniones en Google Maps
            </span>
          </div>

          <!-- Flecha sutil en verde claro que invita a abrir la ficha -->
          <div class="hidden sm:flex items-center text-[#A3C0A7] group-hover:text-white group-hover:translate-x-1 transition-all duration-300 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </div>
        </div>
      </a>
    </div>

    <!-- Review Cards Container (Scroll-snap Carousel on Mobile & Desktop) -->
    <div 
      id="reviews-track"
      class="flex overflow-x-auto snap-x snap-mandatory gap-6 sm:gap-8 pt-4 pb-12 px-4 sm:px-8 scroll-smooth no-scrollbar"
      style="-webkit-overflow-scrolling: touch; scrollbar-width: none;"
    >
      {reviews.map((rev) => (
        <article 
          class="review-card review-card-capsule w-[86vw] sm:w-[360px] md:w-[380px] shrink-0 snap-start p-6 sm:p-8 flex flex-col justify-between"
          data-tags={rev.tags.join(" ")}
          data-timeframe={rev.timeframe}
        >
          <div class="space-y-4">
            
            <!-- Card Header: Initials Avatar + Name + Date + Google Mini Badge -->
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class={`w-11 h-11 rounded-full ${rev.avatarBg} text-[#FBF9F5] font-boska font-bold text-sm flex items-center justify-center shadow-xs shrink-0 select-none`}>
                  {rev.initials}
                </div>
                
                <div>
                  <h3 class="font-satoshi font-semibold text-[#183321] text-sm sm:text-base leading-tight">
                    {rev.name}
                  </h3>
                  <div class="flex items-center gap-1.5 mt-0.5 font-satoshi">
                    {rev.isLocalGuide && (
                      <span class="inline-flex items-center gap-1 text-[11px] font-medium text-[#EA4335]">
                        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
                          <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6.4-4.8-6.4 4.8 2.4-7.2-6-4.8h7.6z"/>
                        </svg>
                        Local Guide
                      </span>
                    )}
                    <span class="text-[11px] text-[#424842]">
                      {rev.isLocalGuide ? `· ${rev.role.split("·")[1] || ""}` : rev.role}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Date & Google G Mini Badge -->
              <div class="flex flex-col items-end shrink-0">
                <svg class="w-4 h-4 opacity-75" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.04h3.88c2.27-2.09 3.66-5.17 3.66-9.14z"/>
                  <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.04c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.13C3.26 21.41 7.34 24 12 24z"/>
                  <path fill="#FBBC05" d="M5.28 14.28c-.25-.72-.38-1.49-.38-2.28s.13-1.56.38-2.28V6.59H1.24C.45 8.16 0 9.94 0 12s.45 3.84 1.24 5.41l4.04-3.13z"/>
                  <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.59 1.24 6.59l4.04 3.13c.95-2.83 3.6-4.97 6.72-4.97z"/>
                </svg>
                <span class="text-[11px] text-[#424842] mt-1 font-satoshi">{rev.date}</span>
              </div>
            </div>

            <!-- Stars & Category Highlight Badge -->
            <div class="flex items-center justify-between gap-2 pt-1 border-t border-[#D9D4CC]/20 font-satoshi">
              <div class="flex text-[#FBBC04]">
                {Array.from({ length: rev.rating }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <span class="text-[11px] font-semibold text-[#9E4221] bg-[#9E4221]/10 px-2.5 py-0.5 rounded-full border border-[#9E4221]/20 font-satoshi">
                {rev.category}
              </span>
            </div>

            <!-- Review Text (Completo, sin cortes ni botones) -->
            <p class="review-text font-satoshi text-[#1B1C1A] text-sm sm:text-base leading-relaxed">
              "{rev.quote}"
            </p>

            <!-- Customer Attached Photos (if present) -->
            {rev.photos && rev.photos.length > 0 && (
              <div class="pt-2 font-satoshi">
                <div class="flex items-center gap-1.5 text-[11px] text-[#424842] mb-1.5 font-medium">
                  <svg class="w-3.5 h-3.5 text-[#183321]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  Fotos de clientes:
                </div>
                <div class="flex gap-2">
                  {rev.photos.map((photo) => (
                    <button 
                      type="button" 
                      class="review-photo-btn group relative rounded-lg overflow-hidden border border-[#D9D4CC]/60 cursor-pointer focus:outline-hidden focus:ring-2 focus:ring-[#9E4221] active:scale-95 transition-transform"
                      data-full-img={photo.url}
                      data-caption={`${photo.label} — ${rev.name}`}
                      title={photo.label}
                      aria-label={`Ver foto: ${photo.label}`}
                    >
                      <img 
                        src={photo.url} 
                        alt={photo.label} 
                        class="w-16 h-16 sm:w-18 sm:h-18 object-cover group-hover:scale-105 transition-transform duration-300 pointer-events-none select-none" 
                        loading="lazy" 
                      />
                      <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors pointer-events-none"></div>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Card Footer: Verification Badge -->
          <div class="pt-4 mt-4 border-t border-[#D9D4CC]/30 flex items-center justify-between text-xs text-[#424842] font-satoshi">
            <span class="inline-flex items-center gap-1 text-[11px] text-[#183321] font-medium">
              <svg class="w-3.5 h-3.5 text-[#34A853]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Opinión verificada en Google Maps
            </span>
            <span class="font-boska italic text-[#183321]/40 text-sm">Buon Appetito</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Mobile Scroll Progress Indicator (Dots) -->
    <div class="flex md:hidden items-center justify-center gap-1.5 mt-2 mb-8" id="reviews-pagination-dots">
      {reviews.map((_, i) => (
        <span 
          class={`pagination-dot h-1.5 rounded-full transition-all duration-300 ${i === 0 ? "w-6 bg-[#183321]" : "w-1.5 bg-[#D9D4CC]"}`}
          data-index={i}
        ></span>
      ))}
    </div>

    <!-- Desktop Carousel Navigation Buttons (Abajo de las reseñas y Centrado) -->
    <div class="hidden md:flex items-center justify-center gap-4 mt-6 mb-12">
      <button 
        type="button" 
        id="reviews-prev-btn" 
        aria-label="Reseña anterior" 
        class="w-12 h-12 rounded-full bg-[#FBF9F5] border border-[#D9D4CC]/80 flex items-center justify-center text-[#183321] hover:bg-[#183321] hover:text-[#FBF9F5] transition-all duration-200 shadow-xs hover:shadow-md hover:scale-105 active:scale-95 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button 
        type="button" 
        id="reviews-next-btn" 
        aria-label="Siguiente reseña" 
        class="w-12 h-12 rounded-full bg-[#FBF9F5] border border-[#D9D4CC]/80 flex items-center justify-center text-[#183321] hover:bg-[#183321] hover:text-[#FBF9F5] transition-all duration-200 shadow-xs hover:shadow-md hover:scale-105 active:scale-95 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

    <!-- Bottom Call to Action: Leave a Review & See All on Google Maps (Organizado verticalmente en tarjeta editorial) -->
    <div class="mt-8 pt-8 md:mt-12 md:pt-10 border-t border-[#D9D4CC]/40 text-center">
      <div class="max-w-xl mx-auto bg-[#FBF9F5] rounded-3xl p-6 sm:p-8 md:p-10 border border-[#D9D4CC]/60 shadow-xs md:shadow-sm">
        
        <!-- Text Header: Encima de las opciones -->
        <div class="space-y-2 mb-6 md:mb-7">
          <h3 class="font-boska text-2xl sm:text-3xl text-[#183321] font-normal tracking-tight">
            ¿Has probado nuestras pizzas o cenado en nuestra terraza?
          </h3>
          <p class="font-satoshi text-xs sm:text-sm md:text-base text-[#424842] max-w-lg mx-auto leading-relaxed">
            Tu valoración ayuda a otros comensales a descubrir la auténtica cocina mediterránea en Port d'Andratx.
          </p>
        </div>

        <!-- Buttons Stacked Vertically with ShimmerButton (Estilo Carta de Comida & Bodega) -->
        <div class="flex flex-col items-center justify-center gap-3.5 w-full max-w-sm sm:max-w-md mx-auto">
          <!-- Botón 1: Escribir reseña (Estilo Carta de Comida en Verde Bosque con Shimmer) -->
          <ShimmerButton 
            client:load
            href={googleWriteReviewUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            background="#183321"
            shimmerColor="#FFFFFF"
            shimmerDuration="3s"
            borderRadius="100px"
            className="shadow-xl shadow-[#183321]/20 w-full"
            title="Escribir una reseña oficial en Google Maps"
          >
            <svg class="w-4 h-4 text-white/95 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
            <span>Escribir una reseña en Google</span>
            <svg class="w-3.5 h-3.5 text-white/80 shrink-0 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </ShimmerButton>

          <!-- Botón 2: Ver reseñas (Estilo Vinos y Bodega en Terracota con Shimmer) -->
          <ShimmerButton 
            client:load
            href={googleMapsUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            background="#9E4221"
            shimmerColor="#FED7AA"
            shimmerDuration="3s"
            borderRadius="100px"
            className="shadow-xl shadow-[#9E4221]/20 w-full"
            title="Ver todas las opiniones verificadas en Google Maps"
          >
            <svg class="w-4 h-4 text-white/95 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span>Ver las +240 reseñas en Google</span>
            <svg class="w-3.5 h-3.5 text-white/80 shrink-0 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </ShimmerButton>
        </div>

      </div>
    </div>

  </div>

  <!-- Lightbox Modal for Customer Review Photos (Overlay fijo universal z-[100]) -->
  <div 
    id="review-photo-modal" 
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6 bg-black/85 backdrop-blur-md transition-all duration-200 select-none"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <div 
      class="relative bg-[#183321]/95 backdrop-blur-xl p-4 sm:p-6 rounded-3xl border border-white/10 flex flex-col items-center shadow-2xl max-w-2xl w-full"
      id="modal-card-content"
    >
      <!-- Clean frosted glass floating close button -->
      <button 
        type="button" 
        id="modal-close-btn" 
        class="absolute -top-3 -right-3 sm:top-3 sm:right-3 w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 text-white backdrop-blur-md flex items-center justify-center transition-all cursor-pointer z-30 active:scale-95 shadow-lg border border-white/20"
        aria-label="Cerrar foto"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      
      <div class="w-full flex justify-center overflow-hidden rounded-2xl bg-black/40">
        <img 
          id="modal-img" 
          src="" 
          alt="" 
          class="max-h-[72vh] w-auto max-w-full rounded-2xl object-contain shadow-lg" 
        />
      </div>
      
      <p id="modal-caption" class="text-xs sm:text-sm text-white/90 mt-3.5 text-center font-medium font-sans px-4 tracking-wide">
      </p>
    </div>
  </div>
</section>

<!-- Client-side Interactive Logic -->
<script>
  // Funciones globales para control del modal de fotos
  function openReviewPhoto(url: string, caption: string) {
    const modal = document.getElementById('review-photo-modal');
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const modalCaption = document.getElementById('modal-caption');

    if (!modal || !modalImg) return;
    modalImg.src = url;
    modalImg.alt = caption || 'Foto de cliente en Buon Appetito';
    if (modalCaption) modalCaption.textContent = caption || '';

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeReviewPhoto() {
    const modal = document.getElementById('review-photo-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Delegación de eventos en document: infalible ante recargas, toques táctiles y módulos asíncronos
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    // 1. Abrir foto al pulsar cualquier botón de fotos de clientes
    const photoBtn = target.closest('.review-photo-btn') as HTMLElement | null;
    if (photoBtn) {
      e.preventDefault();
      e.stopPropagation();
      const fullImg = photoBtn.getAttribute('data-full-img');
      const caption = photoBtn.getAttribute('data-caption') || '';
      if (fullImg) {
        openReviewPhoto(fullImg, caption);
      }
      return;
    }

    // 2. Cerrar si pulsa el botón de cerrar
    const closeBtn = target.closest('#modal-close-btn');
    if (closeBtn) {
      e.preventDefault();
      closeReviewPhoto();
      return;
    }

    // 3. Cerrar si pulsa fuera del contenido (en el fondo oscuro)
    const modal = document.getElementById('review-photo-modal');
    const modalCard = document.getElementById('modal-card-content');
    if (modal && !modal.classList.contains('hidden')) {
      if (modalCard && !modalCard.contains(target)) {
        closeReviewPhoto();
      }
    }
  });

  // Cerrar con tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeReviewPhoto();
  });

  // Control del carrusel de reseñas y sincronización de puntos en móvil
  function setupReviewsCarousel() {
    const track = document.getElementById('reviews-track');
    const prevBtn = document.getElementById('reviews-prev-btn');
    const nextBtn = document.getElementById('reviews-next-btn');
    const dots = document.querySelectorAll('.pagination-dot');

    if (prevBtn && track) {
      prevBtn.onclick = () => {
        const cardWidth = track.querySelector('.review-card')?.clientWidth || 360;
        track.scrollBy({ left: -(cardWidth + 24), behavior: 'smooth' });
      };
    }

    if (nextBtn && track) {
      nextBtn.onclick = () => {
        const cardWidth = track.querySelector('.review-card')?.clientWidth || 360;
        track.scrollBy({ left: cardWidth + 24, behavior: 'smooth' });
      };
    }

    if (track && dots.length > 0) {
      track.onscroll = () => {
        const scrollLeft = track.scrollLeft;
        const cardWidth = track.querySelector('.review-card')?.clientWidth || 300;
        const activeIndex = Math.min(Math.round(scrollLeft / cardWidth), dots.length - 1);

        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.classList.add('w-6', 'bg-[#183321]');
            dot.classList.remove('w-1.5', 'bg-[#D9D4CC]');
          } else {
            dot.classList.remove('w-6', 'bg-[#183321]');
            dot.classList.add('w-1.5', 'bg-[#D9D4CC]');
          }
        });
      };
    }
  }

  // Animación del badge de Google: Conteo fluido 0.0 -> 4.4, opiniones 0 -> +240 y revelado escalonado de estrellas
  function initBadgeAnimation() {
    const badge = document.getElementById('google-reviews-badge');
    const ratingEl = document.getElementById('badge-rating-counter');
    const reviewsEl = document.getElementById('badge-reviews-counter');
    const stars = document.querySelectorAll('.star-item');

    if (!badge || !ratingEl || !reviewsEl) return;

    // Respetar preferencias de reducción de movimiento del usuario
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ratingEl.textContent = '4.4';
      reviewsEl.textContent = '+240';
      return;
    }

    // Inicializar estado previo a la animación
    stars.forEach((star) => {
      const el = star;
      el.style.opacity = '0';
      el.style.transform = 'scale(0.35) translateY(4px)';
      el.style.transition = 'opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)';
    });
    ratingEl.textContent = '0.0';
    reviewsEl.textContent = '+0';

    let hasAnimated = false;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !hasAnimated) {
          hasAnimated = true;
          observer.disconnect();

          const duration = 1300;

          // 1. Contador 0.0 -> 4.4
          let startRatingTs = null;
          function stepRating(ts) {
            if (!startRatingTs) startRatingTs = ts;
            const progress = Math.min((ts - startRatingTs) / duration, 1);
            const ease = 1 - Math.pow(1 - progress, 3);
            const currentVal = (4.4 * ease).toFixed(1);
            ratingEl.textContent = currentVal;
            if (progress < 1) {
              requestAnimationFrame(stepRating);
            } else {
              ratingEl.textContent = '4.4';
            }
          }
          requestAnimationFrame(stepRating);

          // 2. Contador de opiniones 0 -> +240
          let startReviewsTs = null;
          function stepReviews(ts) {
            if (!startReviewsTs) startReviewsTs = ts;
            const progress = Math.min((ts - startReviewsTs) / duration, 1);
            const ease = 1 - Math.pow(1 - progress, 3);
            const currentCount = Math.floor(240 * ease);
            reviewsEl.textContent = '+' + currentCount;
            if (progress < 1) {
              requestAnimationFrame(stepReviews);
            } else {
              reviewsEl.textContent = '+240';
            }
          }
          requestAnimationFrame(stepReviews);

          // 3. Estrellas doradas con destello escalonado
          stars.forEach((star, idx) => {
            const el = star;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'scale(1) translateY(0)';
            }, 120 + idx * 95);
          });
        }
      });
    }, {
      threshold: 0.25,
      rootMargin: '0px 0px -40px 0px'
    });

    observer.observe(badge);
  }

  // Ejecución inmediata y segura en cualquier estado del DOM
  function initReviews() {
    setupReviewsCarousel();
    initBadgeAnimation();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviews);
  } else {
    initReviews();
  }
  document.addEventListener('astro:page-load', initReviews);
</script>

