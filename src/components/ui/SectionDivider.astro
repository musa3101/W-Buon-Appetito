---
// web/src/components/ui/SectionDivider.astro
// Separador de secciones: Cinta Bicolor de Fusión Gastronómica (Italia 🇮🇹 & España 🇪🇸)
interface Props {
  bg?: string;
  className?: string;
  theme?: "light" | "dark";
}

const { bg = "bg-transparent", className = "", theme = "light" } = Astro.props;
const isDark = theme === "dark";
---

<div class={`w-full ${className ? className : "py-4 sm:py-6"} ${bg} flex items-center justify-center relative overflow-hidden select-none`} aria-hidden="true">
  <div class="w-full max-w-3xl px-4 sm:px-12 flex items-center justify-center relative">
    
    <!-- Línea Izquierda: Fusión Bandera Italiana (Verde · Blanco · Rojo) con desvanecimiento exterior -->
    <div class="flex-1 flex items-center justify-end">
      <div 
        class="w-full max-w-[240px] sm:max-w-[280px] h-[2.5px] rounded-full"
        style="background: linear-gradient(90deg, transparent 0%, #008C45 35%, #F4F5F0 70%, #CD212A 100%);"
      ></div>
    </div>

    <!-- Nexo Central: Medallón de Unión con Estrella Toscana Dorada -->
    <div class="mx-3 sm:mx-4.5 shrink-0 flex items-center justify-center">
      <div class={`w-6 h-6 sm:w-7 sm:h-7 rounded-full ${isDark ? "bg-[#183321] border-[#B89758]/70 shadow-md" : "bg-[#FFFFFF] border-[#D9D4CC]/90 shadow-xs"} border flex items-center justify-center transition-transform hover:scale-110`}>
        <svg class={`w-3 h-3 sm:w-3.5 sm:h-3.5 ${isDark ? "text-[#E5C378]" : "text-[#7A6337]"}`} viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" />
        </svg>
      </div>
    </div>

    <!-- Línea Derecha: Fusión Bandera Española (Rojo · Amarillo · Rojo) con desvanecimiento exterior -->
    <div class="flex-1 flex items-center justify-start">
      <div 
        class="w-full max-w-[240px] sm:max-w-[280px] h-[2.5px] rounded-full"
        style="background: linear-gradient(90deg, #AA151B 0%, #F1BF00 50%, #AA151B 80%, transparent 100%);"
      ></div>
    </div>

  </div>
</div>
