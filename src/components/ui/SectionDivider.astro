---
// web/src/components/ui/SectionDivider.astro
// Separador de secciones: Línea de borde a borde (Italia 🇮🇹 & España 🇪🇸) con Rama de Olivo Silvestre (Opción 1)
interface Props {
  bg?: string;
  className?: string;
  theme?: "light" | "dark";
}

const { bg = "bg-transparent", className = "", theme = "light" } = Astro.props;
const isDark = theme === "dark";
---

<div class={`w-full ${className ? className : "py-5 sm:py-7"} ${bg} flex items-center justify-center relative overflow-hidden select-none`} aria-hidden="true">
  <div class="w-full px-2 sm:px-6 flex items-center justify-center relative">
    
    <!-- Línea Izquierda de Borde a Borde: Bandera Italiana (Verde · Blanco · Rojo) continua y sin cortes -->
    <div class="flex-1 flex items-center">
      <div 
        class="w-full h-[2px]"
        style="background: linear-gradient(90deg, #008C45 0%, #008C45 40%, #FFFFFF 72%, #CD212A 100%);"
      ></div>
    </div>

    <!-- Símbolo Central (Opción 1): Rama de Olivo Silvestre Flotante 100% limpia sin recuadros ni círculos -->
    <div class="mx-3 sm:mx-4 shrink-0 flex items-center justify-center">
      <svg 
        class={`w-5 h-5 sm:w-6 sm:h-6 ${isDark ? "text-[#E8E4DC]" : "text-[#183321]"} transition-transform hover:scale-110`} 
        viewBox="0 0 24 24" 
        fill="none" 
        stroke="currentColor" 
        stroke-width="1.8" 
        stroke-linecap="round" 
        stroke-linejoin="round"
      >
        <!-- Rama de olivo estilizada con hoja y fruto -->
        <path d="M2 22C4 16 10 10 21 3" />
        <path d="M9 13C6 12 4 8 7 5C10 8 10 11 9 13Z" fill={isDark ? "rgba(232,228,220,0.2)" : "rgba(24,51,33,0.18)"} />
        <path d="M15 7C14 4 18 2 20 5C17 7 16 6 15 7Z" fill={isDark ? "rgba(232,228,220,0.2)" : "rgba(24,51,33,0.18)"} />
        <circle cx="16" cy="12" r="2.5" fill={isDark ? "#E8E4DC" : "#183321"} />
      </svg>
    </div>

    <!-- Línea Derecha de Borde a Borde: Bandera Española (Rojo · Amarillo · Rojo) continua y sin cortes -->
    <div class="flex-1 flex items-center">
      <div 
        class="w-full h-[2px]"
        style="background: linear-gradient(90deg, #AA151B 0%, #F1BF00 50%, #AA151B 100%);"
      ></div>
    </div>

  </div>
</div>
