---
// web/src/components/Footer.astro
// Footer Oficial Buon Appetito (Port d'Andratx)
// Diseño Verde Salvia Suave (Sage Mist) con logotipo original a todo color y créditos MYNEXT
---

<!-- ======================================================== -->
<!-- FOOTER OFICIAL BUON APPETITO                             -->
<!-- ======================================================== -->
<footer class="bg-gradient-to-b from-[#E2EAE3] via-[#D8E3DA] to-[#CDDCD0] border-t border-[#B8CEBC] text-[#183321] relative">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12 py-10 sm:py-14">
    
    <!-- Top Identity / Logo Section con Logo Original a Todo Color -->
    <div class="text-center max-w-md mx-auto mb-8 sm:mb-10">
      <a href="/#inicio" class="inline-block group" aria-label="Buon Appetito - Volver al inicio">
        <img 
          src="/assets/logos/logo-buon-appetito.png" 
          alt="Buon Appetito - Port d'Andratx" 
          class="h-14 sm:h-16 w-auto object-contain mx-auto drop-shadow-xs group-hover:scale-105 transition-transform duration-300"
        />
      </a>
      <p class="font-satoshi text-xs sm:text-sm text-[#2C4132] mt-3.5 leading-relaxed">
        Cocina mediterránea tradicional, pastas artesanales y pizzería en horno de leña en primera línea de Port d'Andratx.
      </p>

      <!-- Redes Sociales y Opiniones Oficiales: Instagram & TripAdvisor -->
      <div class="flex items-center justify-center gap-3.5 mt-5">
        <!-- Instagram -->
        <a 
          href="https://www.instagram.com/buonappetitomallorca/" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Seguir a Buon Appetito en Instagram"
          class="w-11 h-11 rounded-full bg-white hover:bg-gradient-to-tr hover:from-[#f09433] hover:via-[#dc2743] hover:to-[#bc1888] text-[#E1306C] hover:text-white border border-[#E1306C]/30 hover:border-transparent shadow-xs hover:shadow-md hover:shadow-[#dc2743]/20 flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 group"
        >
          <svg class="w-5 h-5 fill-current transition-transform duration-300 group-hover:rotate-6" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- TripAdvisor -->
        <a 
          href="https://www.tripadvisor.es/Restaurant_Review-g616239-d24183908-Reviews-Grand_Pasta-Port_d_Andratx_Majorca_Balearic_Islands.html" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Ver opiniones de Buon Appetito en TripAdvisor"
          class="w-11 h-11 rounded-full bg-white hover:bg-[#00AA6C] text-[#00AA6C] hover:text-white border border-[#00AA6C]/35 hover:border-[#00AA6C] shadow-xs hover:shadow-md hover:shadow-[#00AA6C]/20 flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 group"
        >
          <svg class="w-5 h-5 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.006 4.295c-2.67 0-5.338.784-7.645 2.353H0l1.963 2.135a5.997 5.997 0 0 0 4.04 10.43 5.976 5.976 0 0 0 4.075-1.6L12 19.705l1.922-2.09a5.972 5.972 0 0 0 4.072 1.598 6 6 0 0 0 6-5.998 5.982 5.982 0 0 0-1.957-4.432L24 6.648h-4.35a13.573 13.573 0 0 0-7.644-2.353zM12 6.255c1.531 0 3.063.303 4.504.903C13.943 8.138 12 10.43 12 13.1c0-2.671-1.942-4.962-4.504-5.942A11.72 11.72 0 0 1 12 6.256zM6.002 9.157a4.059 4.059 0 1 1 0 8.118 4.059 4.059 0 0 1 0-8.118zm11.992.002a4.057 4.057 0 1 1 .003 8.115 4.057 4.057 0 0 1-.003-8.115zm-11.992 1.93a2.128 2.128 0 0 0 0 4.256 2.128 2.128 0 0 0 0-4.256zm11.992 0a2.128 2.128 0 0 0 0 4.256 2.128 2.128 0 0 0 0-4.256z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Navigation Columns Grid: Enlaces Rápidos & Avisos Legales -->
    <div class="max-w-xl mx-auto grid grid-cols-2 gap-8 sm:gap-14 pt-8 border-t border-[#B8CEBC]/70 text-left">
      
      <!-- Columna 1: Enlaces Rápidos -->
      <div class="space-y-3.5">
        <div>
          <h3 class="font-boska text-base sm:text-lg font-medium text-[#183321] tracking-tight">
            Enlaces Rápidos
          </h3>
          <span class="w-7 h-0.5 bg-[#9E4221] rounded-full block mt-1.5"></span>
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-[#2D4534] font-satoshi">
          <li>
            <a href="/#inicio" class="hover:text-[#183321] hover:translate-x-1 inline-block transition-all duration-200">
              Inicio
            </a>
          </li>
          <li>
            <a href="/#sobre-nosotros" class="hover:text-[#183321] hover:translate-x-1 inline-block transition-all duration-200">
              Sobre nosotros
            </a>
          </li>
          <li>
            <a href="/#menu" class="hover:text-[#183321] hover:translate-x-1 inline-block transition-all duration-200">
              Nuestra Carta
            </a>
          </li>
          <li>
            <a href="/#donde-estamos" class="hover:text-[#183321] hover:translate-x-1 inline-block transition-all duration-200">
              Dónde estamos
            </a>
          </li>
          <li class="pt-0.5">
            <a 
              href="/reservar" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 text-[#9E4221] hover:text-[#7A2F14] font-semibold transition-colors"
            >
              <span>Reservar mesa</span>
              <span class="text-xs">&rarr;</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 2: Avisos Legales -->
      <div class="space-y-3.5">
        <div>
          <h3 class="font-boska text-base sm:text-lg font-medium text-[#183321] tracking-tight">
            Avisos Legales
          </h3>
          <span class="w-7 h-0.5 bg-[#183321]/60 rounded-full block mt-1.5"></span>
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-[#2D4534] font-satoshi">
          <li>
            <a href="/aviso-legal" class="hover:text-[#183321] hover:translate-x-1 inline-block transition-all duration-200">
              Aviso legal
            </a>
          </li>
          <li>
            <a href="/privacidad" class="hover:text-[#183321] hover:translate-x-1 inline-block transition-all duration-200">
              Política de privacidad
            </a>
          </li>
          <li>
            <a href="/cookies" class="hover:text-[#183321] hover:translate-x-1 inline-block transition-all duration-200">
              Política de cookies
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Credits Bar -->
    <div class="mt-10 pt-6 border-t border-[#B8CEBC]/70 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#3F5545] font-satoshi text-center sm:text-left">
      <p>
        &copy; 2026 Buon Appetito &bull; Port d'Andratx, Mallorca. Todos los derechos reservados.
      </p>
      <p class="text-xs text-[#3F5545] flex items-center justify-center gap-1">
        <span>Hecho con</span>
        <a 
          href="https://mynextbymusa.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-semibold text-[#183321] hover:text-[#9E4221] underline underline-offset-4 decoration-[#9E4221]/70 hover:decoration-[#9E4221] transition-all tracking-wide"
        >
          MYNEXT
        </a>
      </p>
    </div>

  </div>
</footer>
