<!-- ======================================================== -->
<!-- FOOTER (3 Balanced Columns)                              -->
<!-- ======================================================== -->
<footer class="bg-surface-container-low border-t border-outline-variant/30">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 lg:px-12 py-12 sm:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-12 items-center text-center md:text-left">
      
      <!-- Left: Avisos legales -->
      <div class="space-y-3">
        <p class="font-semibold text-primary text-xs uppercase tracking-[0.2em]">Avisos Legales</p>
        <ul class="space-y-2 text-sm text-on-surface-variant font-sans">
          <li><a href="#" class="hover:text-primary transition-colors">Términos del servicio</a></li>
          <li><a href="#" class="hover:text-primary transition-colors">Política de privacidad</a></li>
          <li><a href="#" class="hover:text-primary transition-colors">Aviso legal y cookies</a></li>
        </ul>
      </div>

      <!-- Center: Logo Redondeado Buon Appetito & Copyright -->
      <div class="flex flex-col items-center justify-center space-y-4 text-center">
        <!-- Logo Redondeado / Circular Brand Emblem -->
        <a href="#inicio" class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-2 border-primary/20 bg-surface flex flex-col items-center justify-center p-2 shadow-sm hover:border-secondary transition-all group" aria-label="Buon Appetito inicio">
          <span class="font-serif text-2xl sm:text-3xl font-bold text-primary tracking-wider group-hover:text-secondary transition-colors">BA</span>
          <span class="text-[9px] uppercase tracking-[0.25em] text-secondary font-semibold">Est. 1998</span>
        </a>
        <span class="font-serif text-2xl font-normal text-primary tracking-tight">Buon Appetito</span>
        <p class="text-xs text-on-surface-variant/80 font-sans">
          &copy; 2026 Buon Appetito &bull; Port d'Andratx, Mallorca.
        </p>
      </div>

      <!-- Right: Enlaces rápidos -->
      <div class="space-y-3 md:text-right">
        <p class="font-semibold text-primary text-xs uppercase tracking-[0.2em]">Enlaces Rápidos</p>
        <ul class="space-y-2 text-sm text-on-surface-variant font-sans">
          <li><a href="#inicio" class="hover:text-primary transition-colors">Inicio</a></li>
          <li><a href="#sobre-nosotros" class="hover:text-primary transition-colors">Sobre nosotros</a></li>
          <li><a href="#menu" class="hover:text-primary transition-colors">Menú</a></li>
          <li><a href="#donde-estamos" class="hover:text-primary transition-colors">Dónde estamos</a></li>
        </ul>
      </div>

    </div>
  </div>
</footer>
