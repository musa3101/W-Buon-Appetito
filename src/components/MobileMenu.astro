---
import { FlowButton } from './ui/flow-button';
import SectionDivider from './ui/SectionDivider.astro';
---

<!-- ======================================================== -->
<!-- MOBILE MENU DRAWER OVERLAY (Lujoso, Editorial & Bloqueo) -->
<!-- ======================================================== -->
<div 
  id="mobile-menu" 
  class="fixed inset-0 w-screen h-[100dvh] z-[100] bg-[#122619] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#1d3d28] via-[#122619] to-[#0c1810] text-white transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between p-6 sm:p-8 md:hidden overflow-y-auto"
  aria-hidden="true"
>
  <!-- Drawer Header con Logo a Todo Color, Botón Cerrar y Separador Bicolor -->
  <div>
    <div class="flex justify-between items-center pb-2">
      <a href="/#inicio" class="flex items-center" id="mobile-menu-brand-link" aria-label="Buon Appetito - Volver al inicio">
        <img 
          src="/assets/logos/logo-buon-appetito-color-dark.png" 
          alt="Buon Appetito Port d'Andratx" 
          class="h-10 sm:h-11 w-auto object-contain drop-shadow-sm"
        />
      </a>
      
      <!-- Botón X Refinado con micro-interacción elegante -->
      <button 
        type="button" 
        id="close-mobile-menu-btn"
        aria-label="Cerrar menú" 
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white/90 hover:text-white hover:border-[#C45E3B]/60 transition-all duration-200 active:scale-90 cursor-pointer shadow-sm group" 
      >
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Separador Bicolor Ítalo-Español en el Header del Menú Móvil -->
    <SectionDivider theme="dark" className="py-2 -mx-2" />
  </div>

  <!-- Navigation List: Editorial numbered style -->
  <div class="flex flex-col gap-4 my-auto py-6">
    <a href="/#inicio" class="mobile-nav-link group flex items-baseline gap-3 py-2 border-b border-white/10 transition-colors">
      <span class="text-xs font-mono text-[#C45E3B] font-bold tracking-widest">01</span>
      <span class="font-boska text-3xl text-white group-hover:text-[#C45E3B] transition-colors">Inicio</span>
    </a>
    <a href="/#sobre-nosotros" class="mobile-nav-link group flex items-baseline gap-3 py-2 border-b border-white/10 transition-colors">
      <span class="text-xs font-mono text-[#C45E3B] font-bold tracking-widest">02</span>
      <span class="font-boska text-3xl text-white group-hover:text-[#C45E3B] transition-colors">Sobre nosotros</span>
    </a>
    <a href="/#menu" class="mobile-nav-link group flex items-baseline gap-3 py-2 border-b border-white/10 transition-colors">
      <span class="text-xs font-mono text-[#C45E3B] font-bold tracking-widest">03</span>
      <span class="font-boska text-3xl text-white group-hover:text-[#C45E3B] transition-colors">Menú</span>
    </a>
    <a href="/#donde-estamos" class="mobile-nav-link group flex items-baseline gap-3 py-2 border-b border-white/10 transition-colors">
      <span class="text-xs font-mono text-[#C45E3B] font-bold tracking-widest">04</span>
      <span class="font-boska text-3xl text-white group-hover:text-[#C45E3B] transition-colors">Dónde estamos</span>
    </a>
  </div>

  <!-- Drawer Footer Actions: Idiomas arriba y botón de reserva debajo con mayor presencia -->
  <div class="flex flex-col items-center gap-4 mb-5 sm:mb-8 text-center font-satoshi">
    <!-- Idiomas encima del botón (limpio, minimalista y sin píldora) -->
    <div class="flex justify-center items-center gap-3.5 text-xs tracking-wider text-white/70">
      <span class="text-white font-bold underline decoration-[#C45E3B] decoration-2 underline-offset-4 cursor-pointer transition-colors">ES</span>
      <span class="text-white/25 select-none">&bull;</span>
      <span class="hover:text-white cursor-pointer transition-colors">EN</span>
      <span class="text-white/25 select-none">&bull;</span>
      <span class="hover:text-white cursor-pointer transition-colors">DE</span>
    </div>

    <!-- Call to Action Reservar Mesa con FlowButton de 21st.dev -->
    <FlowButton 
      client:load
      text="Reservar Mesa"
      href="/reservar"
      target="_blank"
      rel="noopener noreferrer"
      variant="mobile-dark"
      fullWidth={true}
      title="Reservar mesa en Buon Appetito"
    />
  </div>
</div>

<script>
  const mobileMenu = document.getElementById('mobile-menu');
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const closeBtn = document.getElementById('close-mobile-menu-btn');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    if (mobileMenu) {
      mobileMenu.classList.remove('translate-x-full');
      mobileMenu.setAttribute('aria-hidden', 'false');
      // Bloqueo total del scroll en fondo
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.body.style.touchAction = 'none';
    }
  }

  function closeMenu() {
    if (mobileMenu) {
      mobileMenu.classList.add('translate-x-full');
      mobileMenu.setAttribute('aria-hidden', 'true');
      // Restauración del scroll
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      document.body.style.touchAction = '';
    }
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', openMenu);
  }
  if (closeBtn) {
    closeBtn.addEventListener('click', closeMenu);
  }
  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
