---

<!-- ======================================================== -->
<!-- MOBILE MENU DRAWER OVERLAY (Lujoso, Editorial & Bloqueo) -->
<!-- ======================================================== -->
<div 
  id="mobile-menu" 
  class="fixed inset-0 w-screen h-[100dvh] z-[100] bg-[#122619] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#1d3d28] via-[#122619] to-[#0c1810] text-white transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between p-6 sm:p-8 md:hidden overflow-y-auto"
  aria-hidden="true"
>
  <!-- Drawer Header -->
  <div class="flex justify-between items-center border-b border-white/15 pb-4">
    <a href="#inicio" class="flex items-center" id="mobile-menu-brand-link">
      <img 
        src="/assets/logos/logo-buon-appetito-white.png" 
        alt="Buon Appetito Port d'Andratx" 
        class="h-9 w-auto object-contain"
      />
    </a>
    <button 
      type="button" 
      id="close-mobile-menu-btn"
      aria-label="Cerrar menú" 
      class="w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white transition-all active:scale-90 cursor-pointer shadow-md" 
    >
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>
  </div>

  <!-- Navigation List: Editorial numbered style -->
  <div class="flex flex-col gap-4 my-auto py-6">
    <a href="#inicio" class="mobile-nav-link group flex items-baseline gap-3 py-2 border-b border-white/10 transition-colors">
      <span class="text-xs font-mono text-[#C45E3B] font-bold tracking-widest">01</span>
      <span class="font-serif text-3xl text-white group-hover:text-[#C45E3B] transition-colors">Inicio</span>
    </a>
    <a href="#sobre-nosotros" class="mobile-nav-link group flex items-baseline gap-3 py-2 border-b border-white/10 transition-colors">
      <span class="text-xs font-mono text-[#C45E3B] font-bold tracking-widest">02</span>
      <span class="font-serif text-3xl text-white group-hover:text-[#C45E3B] transition-colors">Sobre nosotros</span>
    </a>
    <a href="#menu" class="mobile-nav-link group flex items-baseline gap-3 py-2 border-b border-white/10 transition-colors">
      <span class="text-xs font-mono text-[#C45E3B] font-bold tracking-widest">03</span>
      <span class="font-serif text-3xl text-white group-hover:text-[#C45E3B] transition-colors">Menú</span>
    </a>
    <a href="#donde-estamos" class="mobile-nav-link group flex items-baseline gap-3 py-2 border-b border-white/10 transition-colors">
      <span class="text-xs font-mono text-[#C45E3B] font-bold tracking-widest">04</span>
      <span class="font-serif text-3xl text-white group-hover:text-[#C45E3B] transition-colors">Dónde estamos</span>
    </a>
  </div>

  <!-- Drawer Footer Actions -->
  <div class="space-y-4 pt-4 border-t border-white/15 text-center">
    <!-- Call to Action Reservar Mesa -->
    <a 
      href="#donde-estamos" 
      class="mobile-nav-link w-full inline-flex justify-center items-center gap-2 bg-gradient-to-r from-[#9E4221] to-[#C45E3B] hover:brightness-110 text-white font-semibold text-xs uppercase tracking-widest py-3.5 rounded-full shadow-xl transition-all active:scale-95 cursor-pointer" 
    >
      <span class="material-symbols-outlined text-sm">calendar_month</span>
      <span>RESERVAR MESA</span>
    </a>

    <!-- Teléfono de contacto directo -->
    <a 
      href="tel:+34632446064" 
      class="inline-flex items-center justify-center gap-2 text-white/80 hover:text-white text-xs tracking-wider transition-colors py-1"
    >
      <span class="material-symbols-outlined text-sm text-[#C45E3B]">call</span>
      <span class="font-medium">+34 632 44 60 64</span>
    </a>
    
    <!-- Idiomas -->
    <div class="flex justify-center items-center gap-3 bg-white/10 px-4 py-1.5 rounded-full border border-white/15 text-xs text-white/80 w-fit mx-auto">
      <span class="text-white font-bold underline decoration-[#C45E3B] decoration-2 underline-offset-4">ES</span>
      <span class="text-white/30">&bull;</span>
      <span class="hover:text-white cursor-pointer transition-colors">EN</span>
      <span class="text-white/30">&bull;</span>
      <span class="hover:text-white cursor-pointer transition-colors">DE</span>
    </div>
  </div>
</div>

<script>
  const mobileMenu = document.getElementById('mobile-menu');
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const closeBtn = document.getElementById('close-mobile-menu-btn');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    if (mobileMenu) {
      mobileMenu.classList.remove('translate-x-full');
      mobileMenu.setAttribute('aria-hidden', 'false');
      // Bloqueo total del scroll en fondo
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.body.style.touchAction = 'none';
    }
  }

  function closeMenu() {
    if (mobileMenu) {
      mobileMenu.classList.add('translate-x-full');
      mobileMenu.setAttribute('aria-hidden', 'true');
      // Restauración del scroll
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      document.body.style.touchAction = '';
    }
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', openMenu);
  }
  if (closeBtn) {
    closeBtn.addEventListener('click', closeMenu);
  }
  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
