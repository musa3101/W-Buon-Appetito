---
// Preloader Oficial Buon Appetito con Animación Lottie de Restaurante
---

<!-- Chequeo ultrarrápido síncrono para suprimir flash en visitas repetidas -->
<script is:inline>
  try {
    if (sessionStorage.getItem('ba_preloader_seen_v1') === 'true' && !sessionStorage.getItem('ba_nav_to_reservar')) {
      document.documentElement.classList.add('preloader-already-seen');
    } else {
      // El preloader va a animarse: congelar la web desde el primer frame
      document.documentElement.classList.add('preloader-lock');
      document.documentElement.style.backgroundColor = '#183321';
      if (document.body) {
        document.body.classList.add('preloader-lock');
        document.body.style.backgroundColor = '#183321';
      }
    }
  } catch (e) {}
</script>

<div id="site-preloader" class="site-preloader" aria-hidden="true">
  <div class="preloader-backdrop"></div>
  <div class="preloader-center-content">
    
    <!-- Contenedor del Lottie SVG (Cuchara, tenedor y plato artesanal girando) -->
    <div id="lottie-preloader-box" class="lottie-preloader-box"></div>

    <!-- Identidad y Subtítulo de Marca -->
    <div class="preloader-text-group">
      <span class="preloader-brand-title">Buon Appetito</span>
      <span id="preloader-brand-sub" class="preloader-brand-sub">PORT D'ANDRATX · MALLORCA</span>
    </div>

  </div>
</div>

<!-- Lottie Web Light (Auto-alojado localmente en public/assets/lottie, sin dependencias externas) -->
<script is:inline src="/assets/lottie/lottie_light.min.js"></script>

<script is:inline>
  (function initBuonAppetitoPreloader() {
    const preloader = document.getElementById('site-preloader');
    const lottieBox = document.getElementById('lottie-preloader-box');
    const brandSub = document.getElementById('preloader-brand-sub');
    if (!preloader || !lottieBox) return;

    const SESSION_SEEN_KEY = 'ba_preloader_seen_v1';
    const FROM_RESERVAR_KEY = 'ba_nav_to_reservar';

    let hasSeenFirstVisit = false;
    let isNavigatingToReservar = false;

    try {
      hasSeenFirstVisit = sessionStorage.getItem(SESSION_SEEN_KEY) === 'true';
      isNavigatingToReservar = sessionStorage.getItem(FROM_RESERVAR_KEY) === 'true';
    } catch (e) {}

    let lottieAnim = null;

    // Asegurar carga de Lottie
    function playLottie() {
      if (lottieAnim) {
        lottieAnim.play();
        return;
      }

      function initAnimation() {
        if (typeof window.lottie !== 'undefined' && lottieBox) {
          try {
            lottieAnim = window.lottie.loadAnimation({
              container: lottieBox,
              renderer: 'svg',
              loop: true,
              autoplay: true,
              path: '/assets/lottie/restaurant-preloader.json'
            });
          } catch (e) {
            console.warn('Preloader Lottie error:', e);
          }
        }
      }

      if (typeof window.lottie !== 'undefined') {
        initAnimation();
      } else {
        const interval = setInterval(() => {
          if (typeof window.lottie !== 'undefined') {
            clearInterval(interval);
            initAnimation();
          }
        }, 25);
        setTimeout(() => clearInterval(interval), 2000);
      }
    }

    // Congelar / liberar la web de fondo (Bloqueo activo en fase de captura)
    const rootEl = document.documentElement;
    let isPreloaderLocked = false;

    function preventScrollAndTouch(e) {
      if (isPreloaderLocked) {
        e.preventDefault();
      }
    }

    function lockPage() {
      if (isPreloaderLocked) return;
      isPreloaderLocked = true;
      window.addEventListener('touchmove', preventScrollAndTouch, { passive: false, capture: true });
      window.addEventListener('wheel', preventScrollAndTouch, { passive: false, capture: true });
      rootEl.classList.add('preloader-lock');
      rootEl.style.backgroundColor = '#183321';
      if (document.body) {
        document.body.classList.add('preloader-lock');
        document.body.style.backgroundColor = '#183321';
      }
    }

    function unlockPage() {
      isPreloaderLocked = false;
      window.removeEventListener('touchmove', preventScrollAndTouch, { capture: true });
      window.removeEventListener('wheel', preventScrollAndTouch, { capture: true });
      rootEl.classList.remove('preloader-lock');
      rootEl.style.backgroundColor = '';
      if (document.body) {
        document.body.classList.remove('preloader-lock');
        document.body.style.backgroundColor = '';
      }
    }

    // Ocultar preloader con suave desvanecimiento
    function hidePreloader(instant = false) {
      if (instant) {
        preloader.classList.add('preloader-hidden-instant');
        preloader.classList.add('preloader-hidden');
        unlockPage();
      } else {
        preloader.classList.remove('preloader-hidden-instant');
        preloader.classList.add('preloader-hidden');
      }
      setTimeout(() => {
        if (preloader.classList.contains('preloader-hidden')) {
          unlockPage(); // La web vuelve a ser navegable al terminar el fade-out
          if (lottieAnim) lottieAnim.pause();
        }
      }, 470);
    }

    // Mostrar preloader con texto personalizado
    function showPreloader(customSub) {
      if (customSub && brandSub) {
        brandSub.textContent = customSub;
      }
      lockPage();
      document.documentElement.classList.remove('preloader-already-seen');
      preloader.classList.remove('preloader-hidden-instant');
      preloader.classList.remove('preloader-hidden');
      playLottie();
    }

    // Al volver atrás desde /reservar (caché del navegador), no dejar la web bloqueada
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) {
        try { sessionStorage.removeItem(FROM_RESERVAR_KEY); } catch (err) {}
        hidePreloader(true);
      }
    });

    // 1. Si venimos navegando hacia Reservar Mesa
    if (isNavigatingToReservar) {
      try { sessionStorage.removeItem(FROM_RESERVAR_KEY); } catch (e) {}
      if (brandSub) brandSub.textContent = 'PREPARANDO SU MESA...';
      lockPage();
      playLottie();
      setTimeout(() => {
        hidePreloader(false);
      }, 1350);
    } 
    // 2. Si es la primera visita de la sesión en la web: mostrar 1.35s (intervalo 1.2 a 1.5s)
    else if (!hasSeenFirstVisit) {
      lockPage();
      playLottie();
      setTimeout(() => {
        hidePreloader(false);
        try { sessionStorage.setItem(SESSION_SEEN_KEY, 'true'); } catch (e) {}
      }, 1350);
    } 
    // 3. Si ya se vio en esta sesión (recargas posteriores): ocultar de inmediato
    else {
      hidePreloader(true);
    }

    // Interceptar clics en botones de "Reservar Mesa" (pero NUNCA en la Carta/Menú)
    function bindReservarButtons() {
      const reservarLinks = document.querySelectorAll('a[href*="/reservar"], button[data-action="reservar"]');
      
      reservarLinks.forEach(link => {
        if (link.hasAttribute('data-preloader-bound')) return;
        link.setAttribute('data-preloader-bound', 'true');

        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href') || '/reservar';
          const target = link.getAttribute('target');

          showPreloader('PREPARANDO SU MESA...');
          try { sessionStorage.setItem(FROM_RESERVAR_KEY, 'true'); } catch (e) {}

          if (target === '_blank') {
            // Pestaña nueva: no interrumpimos navegación nativa, y el loading se desvanece tras 1.4s
            setTimeout(() => {
              hidePreloader(false);
            }, 1400);
          } else {
            // Misma ventana: transición suave
            e.preventDefault();
            setTimeout(() => {
              window.location.href = href;
            }, 700);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindReservarButtons);
    } else {
      bindReservarButtons();
    }

    const observer = new MutationObserver(() => {
      bindReservarButtons();
    });
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>

<style is:global>
  /* ========================================================
     PRELOADER RESTAURANTE · BUON APPETITO (PORT D'ANDRATX)
     Fondo Rosáceo / Porcelana Cálida Acorde a la Web
     ======================================================== */
  html.preloader-already-seen #site-preloader {
    display: none !important;
  }

  /* Web congelada mientras el loading anima (sin scroll, sin rebote, sin toques) */
  html.preloader-lock,
  html.preloader-lock body {
    overflow: hidden !important;
    height: 100% !important;
    touch-action: none !important;
    overscroll-behavior: none !important;
    background-color: #183321 !important;
  }

  /* Ocultación 100% absoluta de todo el contenido de fondo para que NADA se filtre ni asome por debajo */
  html.preloader-lock main,
  html.preloader-lock header,
  html.preloader-lock footer,
  html.preloader-lock #main-header,
  html.preloader-lock #mobile-menu,
  html.preloader-lock .booking-wrapper {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  /* Transición suave al desvanecer el preloader */
  main, header, footer, #main-header, #mobile-menu, .booking-wrapper {
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-preloader {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Se extiende 200px por debajo del borde de la pantalla para neutralizar cualquier barra flotante o notch */
    bottom: -200px;
    width: 100vw;
    width: 100%;
    height: calc(100lvh + 200px);
    height: calc(100vh + 200px);
    min-height: calc(100lvh + 200px);
    min-height: -webkit-fill-available;
    z-index: 99999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 200px;
    touch-action: none;
    overscroll-behavior: none;
    /* Verde oliva corporativo con un halo cálido central */
    background: #183321 !important;
    background: radial-gradient(circle at 50% 45%, #24452E 0%, #1B3925 50%, #183321 100%) !important;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Escudo 360° sobredimensionado para neutralizar rebotes elásticos de iOS y barras dinámicas */
  .site-preloader::before,
  .preloader-backdrop {
    content: "";
    position: fixed;
    top: -50vh;
    bottom: -50vh;
    left: -50vw;
    right: -50vw;
    background-color: #183321 !important;
    z-index: -1;
    pointer-events: none;
  }

  /* Ocultación suave con fade-out */
  .site-preloader.preloader-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Ocultación instantánea para recargas de sesión sin parpadeos */
  .site-preloader.preloader-hidden-instant {
    transition: none !important;
    display: none !important;
  }

  .preloader-center-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    animation: preloaderContentPop 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes preloaderContentPop {
    0% {
      opacity: 0;
      transform: scale(0.92) translateY(8px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Caja del Lottie */
  .lottie-preloader-box {
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.35));
  }

  .lottie-preloader-box svg {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  /* Identidad y Tipografía */
  .preloader-text-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .preloader-brand-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.65rem;
    font-weight: 700;
    color: #FBF9F5;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .preloader-brand-sub {
    font-family: "Plus Jakarta Sans", "Outfit", -apple-system, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #D97757;
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .lottie-preloader-box {
      width: 125px;
      height: 125px;
    }

    .preloader-brand-title {
      font-size: 1.45rem;
    }

    .preloader-brand-sub {
      font-size: 0.68rem;
      letter-spacing: 0.18em;
    }
  }
</style>
