---
// web/src/components/LocationReservations.astro
// Sección Dónde Estamos: Panel de Información y Contacto (arriba con botón Reservar) + Mapa Panorámico (abajo)
---

<!-- ======================================================== -->
<!-- DÓNDE ESTAMOS & INFORMACIÓN DEL LOCAL                    -->
<!-- Top: Info & Contact Panel with "Reservar Mesa" CTA        -->
<!-- Bottom: Panoramic Google Map Embed                        -->
<!-- ======================================================== -->
<section class="py-16 sm:py-24 md:py-32 bg-surface border-b border-outline-variant/30" id="donde-estamos">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 space-y-10 sm:space-y-14">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3 sm:space-y-4">
      <span class="text-xs font-semibold text-secondary uppercase tracking-[0.25em]">Visítanos &bull; Port d'Andratx</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-primary font-semibold tracking-tight">
        Dónde Encontrarnos
      </h2>
      <p class="font-sans text-on-surface-variant text-sm sm:text-base leading-relaxed">
        Frente al puerto deportivo de Port d'Andratx. Terraza exterior con vistas al mar y acogedor salón interior climatizado.
      </p>
    </div>

    <!-- 1. PANEL DE INFORMACIÓN & CONTACTO (ARRIBA) -->
    <div class="bg-surface-container-low p-6 sm:p-9 lg:p-11 rounded-3xl border border-outline-variant/30 shadow-sm space-y-8">
      
      <!-- Encabezado del Panel -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-outline-variant/20 pb-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[#183321]/10 flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined text-2xl">storefront</span>
          </div>
          <div>
            <span class="text-[10px] sm:text-[11px] font-semibold text-secondary uppercase tracking-[0.2em]">Buon Appetito</span>
            <h3 class="font-serif text-2xl sm:text-3xl text-primary font-semibold mt-0.5">Información &amp; Contacto</h3>
          </div>
        </div>
        <span class="inline-flex items-center gap-1.5 bg-[#183321]/10 text-primary text-[11px] font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          Abierto Hoy &bull; Cocina Continuada
        </span>
      </div>

      <!-- Cuadrícula 2x2 de Detalles del Restaurante -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 font-sans text-sm">
        
        <!-- Tarjeta 1: Dirección Física -->
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-surface/80 border border-outline-variant/20 shadow-xs hover:border-primary/40 transition-colors">
          <div class="w-11 h-11 rounded-xl bg-[#183321]/10 flex items-center justify-center text-secondary shrink-0">
            <span class="material-symbols-outlined text-2xl">location_on</span>
          </div>
          <div class="space-y-1">
            <p class="font-semibold text-secondary text-xs uppercase tracking-wider">Dirección Física</p>
            <a 
              href="https://maps.app.goo.gl/nC1F69YNFf4TghwD6"
              target="_blank" 
              rel="noopener noreferrer"
              class="text-primary hover:text-secondary font-semibold text-base transition-colors inline-flex items-center gap-1.5"
              title="Abrir en Google Maps"
            >
              <span>Avenida Mateo Bosch, 24</span>
              <span class="material-symbols-outlined text-sm opacity-60">open_in_new</span>
            </a>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              07157 Port d'Andratx, Mallorca &bull; Frente al puerto deportivo
            </p>
          </div>
        </div>

        <!-- Tarjeta 2: Horario Continuado -->
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-surface/80 border border-outline-variant/20 shadow-xs hover:border-primary/40 transition-colors">
          <div class="w-11 h-11 rounded-xl bg-[#183321]/10 flex items-center justify-center text-secondary shrink-0">
            <span class="material-symbols-outlined text-2xl">schedule</span>
          </div>
          <div class="space-y-1">
            <p class="font-semibold text-secondary text-xs uppercase tracking-wider">Horario Continuado</p>
            <p class="text-primary font-semibold text-base">De Lunes a Domingo: 11:30 – 23:30</p>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Cocina abierta todos los días sin interrupción
            </p>
          </div>
        </div>

        <!-- Tarjeta 3: Teléfono Directo & Reservas -->
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-surface/80 border border-outline-variant/20 shadow-xs hover:border-primary/40 transition-colors">
          <div class="w-11 h-11 rounded-xl bg-[#183321]/10 flex items-center justify-center text-secondary shrink-0">
            <span class="material-symbols-outlined text-2xl">call</span>
          </div>
          <div class="space-y-1">
            <p class="font-semibold text-secondary text-xs uppercase tracking-wider">Teléfono de Sala</p>
            <a 
              href="tel:+34632446064" 
              class="text-primary hover:text-secondary font-bold text-lg tracking-wide transition-colors inline-block"
            >
              +34 632 44 60 64
            </a>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Atención directa para consultas y dudas
            </p>
          </div>
        </div>

        <!-- Tarjeta 4: Correo Electrónico -->
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-surface/80 border border-outline-variant/20 shadow-xs hover:border-primary/40 transition-colors">
          <div class="w-11 h-11 rounded-xl bg-[#183321]/10 flex items-center justify-center text-secondary shrink-0">
            <span class="material-symbols-outlined text-2xl">mail</span>
          </div>
          <div class="space-y-1">
            <p class="font-semibold text-secondary text-xs uppercase tracking-wider">Correo Electrónico</p>
            <a 
              href="mailto:buonappetitoandratx@gmail.com" 
              class="text-primary hover:text-secondary font-medium text-sm transition-colors break-all block"
            >
              buonappetitoandratx@gmail.com
            </a>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Reservas de grupo y eventos privados
            </p>
          </div>
        </div>

      </div>

      <!-- BOTÓN DESTACADO "RESERVAR MESA" DENTRO DE INFORMACIÓN -->
      <div class="pt-6 border-t border-outline-variant/20 flex flex-col sm:flex-row items-center justify-between gap-5 bg-surface/50 -mx-6 -mb-6 sm:-mx-9 sm:-mb-9 lg:-mx-11 lg:-mb-11 p-6 sm:p-8 rounded-b-3xl">
        <div class="text-center sm:text-left space-y-1">
          <h4 class="font-serif text-lg sm:text-xl text-primary font-normal">¿Deseas asegurar tu mesa en Buon Appetito?</h4>
          <p class="text-xs sm:text-sm text-on-surface-variant font-sans">
            Selecciona fecha, comensales y turno en nuestra aplicación de reservas en un instante.
          </p>
        </div>
        <a 
          href="/reservar" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-[#9E4221] to-[#C45E3B] hover:brightness-110 text-white px-8 py-4 rounded-full font-semibold text-xs sm:text-sm uppercase tracking-widest shadow-lg hover:shadow-xl hover:scale-102 active:scale-95 transition-all duration-300 cursor-pointer w-full sm:w-auto shrink-0"
        >
          <span class="material-symbols-outlined text-lg">calendar_month</span>
          <span>RESERVAR MESA</span>
        </a>
      </div>

    </div>

    <!-- 2. MAPA DE GOOGLE MAPS PANORÁMICO (ABAJO) -->
    <div class="bg-surface-container-low p-2.5 sm:p-4 rounded-3xl border border-outline-variant/30 shadow-sm overflow-hidden">
      <div class="w-full h-[380px] sm:h-[460px] md:h-[500px] rounded-2xl overflow-hidden border border-outline-variant/20 shadow-inner relative">
        
        <!-- Botón flotante para abrir en Google Maps app -->
        <a 
          href="https://maps.app.goo.gl/nC1F69YNFf4TghwD6" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="absolute top-4 left-4 z-20 inline-flex items-center gap-2 bg-[#FBF9F5]/95 hover:bg-white text-[#183321] px-4 py-2 rounded-full font-semibold text-xs tracking-wide shadow-md hover:shadow-lg hover:scale-102 active:scale-95 transition-all backdrop-blur-md border border-[#D9D4CC] cursor-pointer"
          title="Abrir ubicación en la app de Google Maps"
        >
          <span class="material-symbols-outlined text-[#9E4221] text-base">near_me</span>
          <span>Abrir en Google Maps</span>
        </a>

        <!-- Iframe interactivo de Google Maps -->
        <iframe
          title="Ubicación de Buon Appetito en Google Maps"
          src="https://maps.google.com/maps?q=39.5443444,2.3882905&hl=es&z=17&output=embed"
          class="w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>

  </div>
</section>
