---
// web/src/components/LocationReservations.astro
// Sección Dónde Estamos: Panel de Información y Contacto (arriba con botón Reservar) + Mapa Panorámico (abajo)
---

<!-- ======================================================== -->
<!-- DÓNDE ESTAMOS & INFORMACIÓN DEL LOCAL                    -->
<!-- Top: Info & Contact Panel with "Reservar Mesa" CTA        -->
<!-- Bottom: Panoramic Google Map Embed                        -->
<!-- ======================================================== -->
<section class="py-16 sm:py-24 md:py-32 bg-surface border-b border-outline-variant/30" id="donde-estamos">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 space-y-10 sm:space-y-14">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3 sm:space-y-4">
      <span class="font-satoshi text-[11px] sm:text-xs font-semibold text-[#9E4221] uppercase tracking-[0.28em]">Visítanos &bull; Port d'Andratx</span>
      <h2 class="font-boska text-3xl sm:text-4xl md:text-5xl text-[#183321] font-normal tracking-tight">
        Dónde Encontrarnos
      </h2>
      <p class="font-satoshi text-[#5A635B] text-sm sm:text-base font-normal leading-relaxed">
        Frente al puerto deportivo de Port d'Andratx. Terraza exterior con vistas al mar y acogedor salón interior climatizado.
      </p>
    </div>

    <!-- 1. PANEL DE INFORMACIÓN & CONTACTO (Verde Salvia Suave · Tipografía Pura · 3 Columnas) -->
    <div class="bg-gradient-to-b from-[#E5ECE6] to-[#DBE5DD] p-6 sm:p-10 md:p-12 rounded-3xl border border-[#BED0C1] shadow-[0_14px_45px_rgba(24,51,33,0.06)] relative">
      
      <!-- Encabezado del Panel con CTA tipográfico directo -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 sm:gap-6 pb-7 sm:pb-8 border-b border-[#BED0C1]">
        <div class="space-y-1">
          <span class="font-satoshi text-[10px] sm:text-[11px] font-semibold text-[#9E4221] uppercase tracking-[0.28em] block">Buon Appetito &bull; Port d'Andratx</span>
          <h3 class="font-boska text-3xl sm:text-4xl md:text-[42px] font-normal text-[#183321] tracking-[-0.01em] leading-tight">
            Información <span class="italic font-normal text-[#9E4221]">&amp;</span> Contacto
          </h3>
          <p class="font-satoshi text-xs sm:text-[13px] text-[#3D5243] font-normal leading-relaxed">
            Atención personalizada de sala, reservas y ubicación en primera línea del puerto.
          </p>
        </div>
        
        <a 
          href="/reservar" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center font-satoshi text-[11px] sm:text-xs font-semibold tracking-[0.24em] uppercase text-white bg-[#183321] hover:bg-[#9E4221] px-8 py-3.5 rounded-full transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-95 cursor-pointer w-full sm:w-auto shrink-0 text-center"
        >
          RESERVAR MESA
        </a>
      </div>

      <!-- Cuadrícula editorial de 3 columnas (Sin Dirección repetida, jerarquía tipográfica pura) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 lg:gap-0 pt-7 sm:pt-8 divide-y divide-[#BED0C1] sm:divide-y-0">
        
        <!-- Columna 1: Horario -->
        <div class="lg:pr-8 lg:border-r border-[#BED0C1] flex flex-col justify-between pt-5 first:pt-0 sm:pt-0">
          <span class="font-satoshi text-[10px] sm:text-[10.5px] font-semibold text-[#9E4221] uppercase tracking-[0.24em] block mb-2">
            Horario
          </span>
          <div class="space-y-1">
            <p class="font-boska text-2xl sm:text-[25px] font-medium text-[#183321] tracking-[-0.01em] leading-snug">
              11:30 – 23:30 h
            </p>
            <p class="font-satoshi text-xs text-[#4A5D4F] font-normal leading-relaxed mt-1">
              Lunes a Domingo sin interrupción
            </p>
          </div>
        </div>

        <!-- Columna 2: Teléfono -->
        <div class="lg:px-8 lg:border-r border-[#BED0C1] flex flex-col justify-between pt-5 sm:pt-0">
          <span class="font-satoshi text-[10px] sm:text-[10.5px] font-semibold text-[#9E4221] uppercase tracking-[0.24em] block mb-2">
            Teléfono de Sala
          </span>
          <div class="space-y-1">
            <a 
              href="tel:+34632446064" 
              class="group block"
              title="Llamar a sala"
            >
              <p class="font-boska text-2xl sm:text-[25px] font-medium text-[#183321] group-hover:text-[#9E4221] tracking-[0.01em] transition-colors leading-snug">
                +34 632 44 60 64
              </p>
              <p class="font-satoshi text-xs text-[#4A5D4F] font-normal leading-relaxed mt-1">
                Atención directa para dudas y sala
              </p>
            </a>
          </div>
        </div>

        <!-- Columna 3: Email -->
        <div class="lg:pl-8 flex flex-col justify-between pt-5 sm:pt-0">
          <span class="font-satoshi text-[10px] sm:text-[10.5px] font-semibold text-[#9E4221] uppercase tracking-[0.24em] block mb-2">
            Correo Electrónico
          </span>
          <div class="space-y-1">
            <a 
              href="mailto:buonappetitoandratx@gmail.com" 
              class="group block"
              title="Enviar correo electrónico"
            >
              <p class="font-satoshi text-[14px] sm:text-[15px] font-medium text-[#183321] group-hover:text-[#9E4221] transition-colors leading-snug break-all sm:break-normal">
                buonappetitoandratx@gmail.com
              </p>
              <p class="font-satoshi text-xs text-[#4A5D4F] font-normal leading-relaxed mt-1">
                Eventos privados y grupos
              </p>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- 2. MAPA DE GOOGLE MAPS PANORÁMICO (ABAJO) -->
    <div class="bg-surface-container-low p-2.5 sm:p-4 rounded-3xl border border-outline-variant/30 shadow-sm overflow-hidden">
      <div class="w-full h-[380px] sm:h-[460px] md:h-[500px] rounded-2xl overflow-hidden border border-outline-variant/20 shadow-inner relative">
        
        <!-- Botón flotante para abrir en Google Maps app (Tipográfico, sin iconos) -->
        <a 
          href="https://maps.app.goo.gl/nC1F69YNFf4TghwD6" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="absolute top-4 left-4 z-20 inline-flex items-center font-satoshi text-[11px] uppercase tracking-[0.2em] font-semibold bg-[#FBF9F5]/95 hover:bg-[#183321] text-[#183321] hover:text-white px-5 py-2.5 rounded-full shadow-md hover:shadow-lg transition-all backdrop-blur-md border border-[#D9D4CC] cursor-pointer"
          title="Abrir ubicación en la app de Google Maps"
        >
          <span>Abrir en Google Maps</span>
        </a>

        <!-- Placeholder visual elegante y cálido mientras el mapa carga -->
        <div class="absolute inset-0 flex flex-col items-center justify-center bg-[#EAE4DC] text-[#183321]/60 pointer-events-none select-none">
          <span class="font-cormorant text-xl text-[#183321]/70 font-light">Buon Appetito</span>
          <span class="font-questrial text-[10px] tracking-[0.24em] uppercase text-[#9E4221]/80 mt-1">Port d'Andratx</span>
        </div>

        <!-- Iframe interactivo de Google Maps (Carga bajo demanda inteligente para 0 bloqueo inicial) -->
        <iframe
          id="gmap-panoramic"
          title="Ubicación de Buon Appetito en Google Maps"
          data-src="https://maps.google.com/maps?q=39.5443444,2.3882905&hl=es&z=17&output=embed"
          class="w-full h-full border-0 relative z-10 transition-opacity duration-700 opacity-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>

  </div>

  <script>
    // Carga bajo demanda del mapa: no descarga nada hasta que el usuario se acerca a 350px de él
    const mapIframe = document.getElementById('gmap-panoramic') as HTMLIFrameElement | null;
    if (mapIframe) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const src = mapIframe.getAttribute('data-src');
            if (src && !mapIframe.src) {
              mapIframe.src = src;
              mapIframe.onload = () => {
                mapIframe.classList.remove('opacity-0');
              };
            }
            obs.disconnect();
          }
        });
      }, { rootMargin: '350px' });
      observer.observe(mapIframe);
    }
  </script>
</section>
