---
// web/src/components/LocationReservations.astro
// Sección Dónde Estamos: Panel de Información y Contacto (arriba con botón Reservar) + Mapa Panorámico (abajo)
---

<!-- ======================================================== -->
<!-- DÓNDE ESTAMOS & INFORMACIÓN DEL LOCAL                    -->
<!-- Top: Info & Contact Panel with "Reservar Mesa" CTA        -->
<!-- Bottom: Panoramic Google Map Embed                        -->
<!-- ======================================================== -->
<section class="py-16 sm:py-24 md:py-32 bg-surface border-b border-outline-variant/30" id="donde-estamos">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 space-y-10 sm:space-y-14">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3 sm:space-y-4">
      <span class="text-xs font-semibold text-secondary uppercase tracking-[0.25em]">Visítanos &bull; Port d'Andratx</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-primary font-semibold tracking-tight">
        Dónde Encontrarnos
      </h2>
      <p class="font-sans text-on-surface-variant text-sm sm:text-base leading-relaxed">
        Frente al puerto deportivo de Port d'Andratx. Terraza exterior con vistas al mar y acogedor salón interior climatizado.
      </p>
    </div>

    <!-- 1. PANEL DE INFORMACIÓN & CONTACTO (Compacto, elegante y editorial) -->
    <div class="bg-surface-container-low p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-outline-variant/30 shadow-sm space-y-6">
      
      <!-- Encabezado del Panel con CTA directo -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-outline-variant/20 pb-5">
        <div>
          <span class="text-[10px] sm:text-[11px] font-semibold text-secondary uppercase tracking-[0.2em]">Buon Appetito</span>
          <h3 class="font-serif text-2xl sm:text-3xl text-primary font-semibold mt-0.5">Información &amp; Contacto</h3>
        </div>
        
        <a 
          href="/reservar" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-[#9E4221] hover:bg-[#C45E3B] text-white px-6 py-2.5 rounded-full font-semibold text-xs uppercase tracking-wider transition-all duration-300 shadow-md hover:shadow-lg active:scale-95 cursor-pointer w-full sm:w-auto shrink-0"
        >
          <span class="material-symbols-outlined text-base">calendar_month</span>
          <span>RESERVAR MESA</span>
        </a>
      </div>

      <!-- Cuadrícula limpia y editorial de 4 columnas (sin cajas pesadas ni fondos feos) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6 lg:gap-0 font-sans">
        
        <!-- Columna 1: Dirección -->
        <div class="lg:pr-6 lg:border-r border-outline-variant/20 flex flex-col justify-between space-y-1">
          <span class="text-[10.5px] font-semibold text-secondary uppercase tracking-[0.18em]">Dirección</span>
          <div>
            <a 
              href="https://maps.app.goo.gl/nC1F69YNFf4TghwD6"
              target="_blank" 
              rel="noopener noreferrer"
              class="text-primary hover:text-secondary font-semibold text-[15px] sm:text-base transition-colors inline-flex items-center gap-1.5"
              title="Abrir en Google Maps"
            >
              <span>Av. Mateo Bosch, 24</span>
              <span class="material-symbols-outlined text-sm opacity-60">open_in_new</span>
            </a>
            <p class="text-xs text-on-surface-variant mt-0.5">
              07157 Port d'Andratx &bull; Frente al puerto
            </p>
          </div>
        </div>

        <!-- Columna 2: Horario -->
        <div class="lg:px-6 lg:border-r border-outline-variant/20 flex flex-col justify-between space-y-1">
          <span class="text-[10.5px] font-semibold text-secondary uppercase tracking-[0.18em]">Horario</span>
          <div>
            <p class="text-primary font-semibold text-[15px] sm:text-base">11:30 – 23:30 h</p>
            <p class="text-xs text-on-surface-variant mt-0.5">
              Lunes a Domingo sin interrupción
            </p>
          </div>
        </div>

        <!-- Columna 3: Teléfono -->
        <div class="lg:px-6 lg:border-r border-outline-variant/20 flex flex-col justify-between space-y-1">
          <span class="text-[10.5px] font-semibold text-secondary uppercase tracking-[0.18em]">Teléfono de Sala</span>
          <div>
            <a 
              href="tel:+34632446064" 
              class="text-primary hover:text-secondary font-bold text-[15px] sm:text-base tracking-wide transition-colors inline-block"
            >
              +34 632 44 60 64
            </a>
            <p class="text-xs text-on-surface-variant mt-0.5">
              Atención directa para dudas y sala
            </p>
          </div>
        </div>

        <!-- Columna 4: Email -->
        <div class="lg:pl-6 flex flex-col justify-between space-y-1">
          <span class="text-[10.5px] font-semibold text-secondary uppercase tracking-[0.18em]">Correo Electrónico</span>
          <div>
            <a 
              href="mailto:buonappetitoandratx@gmail.com" 
              class="text-primary hover:text-secondary font-semibold text-[13px] sm:text-[13.5px] transition-colors break-all inline-block"
            >
              buonappetitoandratx@gmail.com
            </a>
            <p class="text-xs text-on-surface-variant mt-0.5">
              Eventos privados y grupos
            </p>
          </div>
        </div>

      </div>

    </div>

    <!-- 2. MAPA DE GOOGLE MAPS PANORÁMICO (ABAJO) -->
    <div class="bg-surface-container-low p-2.5 sm:p-4 rounded-3xl border border-outline-variant/30 shadow-sm overflow-hidden">
      <div class="w-full h-[380px] sm:h-[460px] md:h-[500px] rounded-2xl overflow-hidden border border-outline-variant/20 shadow-inner relative">
        
        <!-- Botón flotante para abrir en Google Maps app -->
        <a 
          href="https://maps.app.goo.gl/nC1F69YNFf4TghwD6" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="absolute top-4 left-4 z-20 inline-flex items-center gap-2 bg-[#FBF9F5]/95 hover:bg-white text-[#183321] px-4 py-2 rounded-full font-semibold text-xs tracking-wide shadow-md hover:shadow-lg hover:scale-102 active:scale-95 transition-all backdrop-blur-md border border-[#D9D4CC] cursor-pointer"
          title="Abrir ubicación en la app de Google Maps"
        >
          <span class="material-symbols-outlined text-[#9E4221] text-base">near_me</span>
          <span>Abrir en Google Maps</span>
        </a>

        <!-- Iframe interactivo de Google Maps -->
        <iframe
          title="Ubicación de Buon Appetito en Google Maps"
          src="https://maps.google.com/maps?q=39.5443444,2.3882905&hl=es&z=17&output=embed"
          class="w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>

  </div>
</section>
