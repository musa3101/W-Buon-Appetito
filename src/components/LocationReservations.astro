---
// web/src/components/LocationReservations.astro
// Sección Dónde Estamos: Panel de Información y Contacto (arriba con botón Reservar) + Mapa Panorámico (abajo)
import { ShimmerButton } from './ui/shimmer-button';
---

<!-- ======================================================== -->
<!-- DÓNDE ESTAMOS & INFORMACIÓN DEL LOCAL                    -->
<!-- Top: Info & Contact Panel with "Reservar Mesa" CTA        -->
<!-- Bottom: Panoramic Google Map Embed                        -->
<!-- ======================================================== -->
<section class="py-16 sm:py-24 md:py-32 bg-surface border-b border-outline-variant/30" id="donde-estamos">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 space-y-10 sm:space-y-14">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3 sm:space-y-4">
      <span data-i18n="contact_eyebrow" class="font-satoshi text-[11px] sm:text-xs font-semibold text-[#9E4221] uppercase tracking-[0.28em]">Visítanos &bull; Port d'Andratx</span>
      <h2 data-i18n="contact_title" class="font-boska text-3xl sm:text-4xl md:text-5xl text-[#183321] font-normal tracking-tight">
        Dónde Encontrarnos
      </h2>
      <p data-i18n="contact_desc" class="font-satoshi text-[#5A635B] text-sm sm:text-base font-normal leading-relaxed">
        Frente al puerto deportivo de Port d'Andratx. Terraza exterior con vistas al mar y acogedor salón interior climatizado.
      </p>
    </div>

    <!-- 1. PANEL DE INFORMACIÓN & CONTACTO (Verde Salvia Suave · Compacto en Móvil · Tipografía Fontshare) -->
    <div class="bg-gradient-to-b from-[#E5ECE6] to-[#DBE5DD] p-5 sm:p-8 md:p-10 rounded-2xl sm:rounded-3xl border border-[#BED0C1] shadow-[0_12px_36px_rgba(24,51,33,0.06)] relative">
      
      <!-- Encabezado del Panel con CTA tipográfico directo -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 sm:gap-6 pb-5 sm:pb-7 border-b border-[#BED0C1]">
        <div class="space-y-0.5 sm:space-y-1">
          <h3 class="font-boska text-2xl sm:text-3xl md:text-4xl font-normal text-[#183321] tracking-[-0.01em] leading-tight">
            <span data-i18n="contact_panel_title">Información</span> <span data-i18n="contact_panel_and" class="italic font-normal text-[#9E4221]">&amp;</span> <span data-i18n="contact_panel_title2">Contacto</span>
          </h3>
          <p data-i18n="contact_panel_desc" class="font-satoshi text-xs sm:text-[13px] text-[#3D5243] font-normal leading-relaxed">
            Atención personalizada de sala, reservas y ubicación frente al puerto.
          </p>
        </div>
        
        <!-- Botón Reservar Mesa (Estilo ShimmerButton de Menú y Carta) -->
        <ShimmerButton 
          client:load
          href="/reservar" 
          target="_blank" 
          rel="noopener noreferrer"
          background="#183321"
          shimmerColor="#FFFFFF"
          shimmerDuration="3s"
          borderRadius="100px"
          className="shadow-xl shadow-[#183321]/20 w-full sm:w-auto shrink-0"
          title="Reservar mesa oficial en Buon Appetito"
        >
          <svg class="w-4 h-4 text-white/95 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span data-i18n="contact_btn_reservar">Reservar Mesa</span>
          <svg class="w-3.5 h-3.5 text-white/80 shrink-0 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </ShimmerButton>
      </div>

      <!-- Cuadrícula inteligente: 2 columnas en móvil (-50% altura y sin scroll innecesario) y 3 columnas en desktop -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 sm:gap-x-8 gap-y-4 pt-5 sm:pt-7">
        
        <!-- Columna 1: Horario (Cabinet Grotesk / Fontshare - moderno, nítido y compacto) -->
        <div class="space-y-1 sm:pr-6 sm:border-r border-[#BED0C1]">
          <span data-i18n="contact_schedule_label" class="font-satoshi text-[10px] sm:text-[10.5px] font-semibold text-[#9E4221] uppercase tracking-[0.22em] block">
            Horario
          </span>
          <div>
            <p data-i18n="contact_schedule_val" class="font-cabinet font-bold text-base xs:text-lg sm:text-2xl text-[#183321] tracking-tight leading-snug">
              11:30 – 23:30 h
            </p>
            <p data-i18n="contact_schedule_sub" class="font-satoshi text-[11px] sm:text-xs text-[#4A5D4F] font-normal leading-relaxed mt-0.5">
              Lunes a Domingo
            </p>
          </div>
        </div>

        <!-- Columna 2: Teléfono (Cabinet Grotesk / Fontshare - dígitos arquitectónicos limpios) -->
        <div class="space-y-1 sm:px-6 sm:border-r border-[#BED0C1]">
          <span data-i18n="contact_phone_label" class="font-satoshi text-[10px] sm:text-[10.5px] font-semibold text-[#9E4221] uppercase tracking-[0.22em] block">
            Teléfono de Sala
          </span>
          <div>
            <a 
              href="tel:+34632446064" 
              class="group block"
              title="Llamar a sala"
            >
              <p class="font-cabinet font-bold text-base xs:text-lg sm:text-2xl text-[#183321] group-hover:text-[#9E4221] tracking-tight transition-colors leading-snug">
                +34 632 44 60 64
              </p>
              <p data-i18n="contact_phone_sub" class="font-satoshi text-[11px] sm:text-xs text-[#4A5D4F] font-normal leading-relaxed mt-0.5">
                Atención directa
              </p>
            </a>
          </div>
        </div>

        <!-- Columna 3: Email (General Sans / Fontshare) -->
        <div class="col-span-2 sm:col-span-1 pt-3 sm:pt-0 border-t border-[#BED0C1]/60 sm:border-t-0 space-y-1 sm:pl-6">
          <span data-i18n="contact_email_label" class="font-satoshi text-[10px] sm:text-[10.5px] font-semibold text-[#9E4221] uppercase tracking-[0.22em] block">
            Correo Electrónico
          </span>
          <div>
            <a 
              href="mailto:buonappetitoandratx@gmail.com" 
              class="group block"
              title="Enviar correo electrónico"
            >
              <p class="font-general font-medium text-[13px] sm:text-[15px] text-[#183321] group-hover:text-[#9E4221] transition-colors leading-snug break-all sm:break-normal">
                buonappetitoandratx@gmail.com
              </p>
              <p data-i18n="contact_email_sub" class="font-satoshi text-[11px] sm:text-xs text-[#4A5D4F] font-normal leading-relaxed mt-0.5">
                Eventos privados y grupos
              </p>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- 2. MAPA DE GOOGLE MAPS PANORÁMICO (ABAJO) -->
    <div class="bg-surface-container-low p-2.5 sm:p-4 rounded-3xl border border-outline-variant/30 shadow-sm overflow-hidden">
      <div class="w-full h-[380px] sm:h-[460px] md:h-[500px] rounded-2xl overflow-hidden border border-outline-variant/20 shadow-inner relative">
        
        <!-- Botón flotante para abrir en Google Maps app (Tipográfico, sin iconos) -->
        <a 
          href="https://maps.app.goo.gl/nC1F69YNFf4TghwD6" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="absolute top-4 left-4 z-20 inline-flex items-center font-satoshi text-[11px] uppercase tracking-[0.2em] font-semibold bg-[#FBF9F5]/95 hover:bg-[#183321] text-[#183321] hover:text-white px-5 py-2.5 rounded-full shadow-md hover:shadow-lg transition-all backdrop-blur-md border border-[#D9D4CC] cursor-pointer"
          title="Abrir ubicación en la app de Google Maps"
        >
          <span data-i18n="contact_btn_maps">Abrir en Google Maps</span>
        </a>

        <!-- Placeholder visual elegante y cálido mientras el mapa carga -->
        <div class="absolute inset-0 flex flex-col items-center justify-center bg-[#EAE4DC] text-[#183321]/60 pointer-events-none select-none">
          <span class="font-cormorant text-xl text-[#183321]/70 font-light">Buon Appetito</span>
          <span class="font-questrial text-[10px] tracking-[0.24em] uppercase text-[#9E4221]/80 mt-1">Port d'Andratx</span>
        </div>

        <!-- Iframe interactivo de Google Maps (Carga bajo demanda inteligente para 0 bloqueo inicial) -->
        <iframe
          id="gmap-panoramic"
          title="Ubicación de Buon Appetito en Google Maps"
          data-src="https://maps.google.com/maps?q=39.5443444,2.3882905&hl=es&z=17&output=embed"
          class="w-full h-full border-0 relative z-10 transition-opacity duration-700 opacity-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>

  </div>

  <script>
    // Carga bajo demanda del mapa: no descarga nada hasta que el usuario se acerca a 350px de él
    const mapIframe = document.getElementById('gmap-panoramic') as HTMLIFrameElement | null;
    if (mapIframe) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const src = mapIframe.getAttribute('data-src');
            if (src && !mapIframe.src) {
              mapIframe.src = src;
              mapIframe.onload = () => {
                mapIframe.classList.remove('opacity-0');
              };
            }
            obs.disconnect();
          }
        });
      }, { rootMargin: '350px' });
      observer.observe(mapIframe);
    }
  </script>
</section>
